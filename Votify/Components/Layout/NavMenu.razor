@inject Votify.Auth.ApiClient ApiClient
@inject Votify.Auth.BlazorAuthStateProvider AuthProvider
@implements IDisposable

<div class="nav-scrollable" >
    <nav class="nav flex-column">
        <div class="events">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="home" Match="NavLinkMatch.All">
                    <span class="bi bi-event-calendar-nav-menu" aria-hidden="true"></span>
                    <span class="menu-text">Eventos</span>
                </NavLink>
            </div>
        </div>

        <div class="user-section">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="notificacion">
                    <span class="bi bi-bell-nav-menu" aria-hidden="true"></span>
                    <span class="menu-text">Notificaciones</span>
                </NavLink>
            </div>

            <div class="divider-user"></div>
            <div class="nav-item px-3 mb-2">
                <NavLink class="nav-link" href="perfilusuario">
                    @if (!string.IsNullOrEmpty(imagenPerfilBase64))
                    {
                        <img src="data:image/jpeg;base64,@imagenPerfilBase64" class="nav-profile-img" alt="Perfil" />
                    }
                    else
                    {
                        <span class="bi bi-user-nav-menu" aria-hidden="true"></span>
                    }
                    <span class="menu-text">@nombreUsuario</span>
                </NavLink>
            </div>
        </div>     
    </nav>
</div>

@code {
    private string? imagenPerfilBase64 = null;
    private string nombreUsuario = "Usuario";

    protected override void OnInitialized()
    {
        AuthProvider.AuthenticationStateChanged += OnAuthStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CargarPerfil();
        }
    }

    private async void OnAuthStateChanged(Task<AuthenticationState> task)
    {
        _ = await task;
        await CargarPerfil();
    }

    private async Task CargarPerfil()
    {
        if (AuthProvider.EstaAutenticado)
        {
            try
            {
                var perfil = await ApiClient.GetFromJsonAsync<NavMenuPerfilDto>("api/usuario/perfil");
                if (perfil != null)
                {
                    imagenPerfilBase64 = perfil.ImagenBase64;
                    nombreUsuario = !string.IsNullOrWhiteSpace(perfil.Nombre) ? perfil.Nombre : "Usuario";
                    StateHasHasChanged();
                }
            }
            catch
            {
                // Ignorar error si no se puede cargar la imagen.
            }
        }
        else
        {
            imagenPerfilBase64 = null;
            nombreUsuario = "Usuario";
            StateHasHasChanged();
        }
    }

    private void StateHasHasChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        AuthProvider.AuthenticationStateChanged -= OnAuthStateChanged;
    }

    private class NavMenuPerfilDto
    {
        public string? Nombre { get; set; }
        public string? ImagenBase64 { get; set; }
    }
}

