@page "/eventojurado/{EventoId:long}"
@rendermode InteractiveServer
@inject ApiClient ApiClient
@inject NavigationManager Nav
@inject BlazorAuthStateProvider AuthProvider

@if (cargando)
{
    <div class="ejp-loading-state">
        <div class="ejp-spinner"></div>
        <p>Cargando panel de jurado...</p>
    </div>
}
else if (!string.IsNullOrWhiteSpace(error))
{
    <div class="ejp-wrapper">
        <div class="ejp-alert ejp-alert-error">@error</div>
    </div>
}

else if (evento is null)
{
    <div class="ejp-wrapper">
        <div class="ejp-alert ejp-alert-error">No se ha podido cargar el evento.</div>
    </div>
}
else
{
    <div class="ejp-wrapper">

        <div class="ejp-hero">
            <div class="ejp-hero-content">
                <div class="ejp-breadcrumb" @onclick="VolverHome">← Volver al home</div>

                <div class="ejp-hero-top">
                    <div>
                        <div class="ejp-eyebrow">Panel de jurado</div>
                        <h1>@evento.Nombre</h1>
                        <p>@evento.Descripcion</p>
                    </div>

                    <div class="ejp-hero-side">
                        <span class="ejp-role-badge">Jurado</span>
                        <span class="ejp-phase-pill @GetFaseClass(evento)">@GetFaseLabel(evento)</span>
                    </div>
                </div>
            </div>
        </div>
        @if (EventoPausado(evento))
        {
        <div class="epp-alert epp-alert-error">
            Este evento está en pausa. No se pueden realizar acciones temporalmente.
        </div>
        }
        @if (!EventoPausado(evento))
        {
            <div class="ejp-categories-section">
                <h2 class="ejp-section-title">Categorías en las que participas</h2>
                <hr class="ejp-divider" />

                @{
                    var faseActual = GetFaseClass(evento);
                    var esFaseTemprana = faseActual == "fase-inscripciones" ||
                                         faseActual == "fase-entregas" ||
                                         faseActual == "fase-votaciones";
                }

                @if (esFaseTemprana)
                {
                    <div class="ejp-alert-warning">
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.47l-.451-.081.082-.381 2.29-.287zM8 5.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2z" />
                        </svg>
                        <span>
                            <strong>Acceso restringido:</strong>
                            Podrás entrar a evaluar las categorías una vez finalice la fase de votación popular.
                        </span>
                    </div>
                }

                @if (categorias == null || !categorias.Any())
                {
                    <div class="ejp-alert ejp-alert-info">No tienes ninguna categoría asignada para evaluar en este evento.</div>
                }
                else
                {
                    <div class="ejp-categories-list">
                        @foreach (var categoria in categorias)
                        {
                            <div class="ejp-category-card" @onclick="() => IrACategoria(categoria.Id)">
                                <div class="ejp-category-content">
                                    <h3 class="ejp-category-title">@categoria.Nombre</h3>
                                    <p class="ejp-category-desc">@categoria.Descripcion</p>
                                </div>
                                <div class="ejp-category-footer">
                                    <div class="ejp-progress-pill @(categoria.ProyectosRevisados == categoria.ProyectosTotales ? "completado" : "")">
                                        Proyectos revisados: @categoria.ProyectosRevisados/@categoria.ProyectosTotales
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    [Parameter] public long EventoId { get; set; }

    private string? correo = "";
    private EventoDto? evento;
    private List<CategoriaJuradoDto> categorias = new();
    
    private bool cargando = true;
    private string? error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        correo = AuthProvider.ObtenerCorreo();
        if (string.IsNullOrWhiteSpace(correo) || !AuthProvider.EstaAutenticado)
        {
            Nav.NavigateTo("/");
            return;
        }

        try
        {
            var response = await ApiClient.GetFromJsonAsync<EntradaEventoRespuestaDto>($"api/Evento/{EventoId}");
            
            if (response == null || response.Evento == null)
            {
                error = "No se ha podido cargar el evento.";
                return;
            }
            evento = response.Evento;

            var categoriasResponse = await ApiClient.GetFromJsonAsync<List<CategoriaJuradoDto>>($"api/jurado/{EventoId}/mis-categorias");
            categorias = categoriasResponse ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error general: {ex.Message}");
            error = "Ocurrió un error inesperado al contactar con el servidor. Detalle: " + ex.Message;
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private void VolverHome()
    {
        Nav.NavigateTo("/home");
    }
    private bool EventoPausado(EventoDto evento)
    {
        return evento?.Estado == "Pausado";
    }

    private void IrACategoria(long idCategoria)
    {
        var fase = GetFaseClass(evento);
        if (fase == "fase-evaluacion-experta" || fase == "fase-votacion-experta")
        {
            Nav.NavigateTo($"/eventojurado/{EventoId}/categoria/{idCategoria}");
        }
    }

    private string GetFaseClass(EventoDto ev)
    {
        var hoy = DateOnly.FromDateTime(DateTime.Now);
        if (hoy <= ev.FechaFinInscripciones) return "fase-inscripciones";
        if (hoy <= ev.FechaFinEntrega) return "fase-entregas";
        if (hoy <= ev.FechaFinVotaciones) return "fase-votaciones";
        if (hoy <= ev.FechaFinEvaluacionExperta) return "fase-evaluacion-experta";
        if (hoy <= ev.FechaFinVotExperta) return "fase-votacion-experta";
        return "fase-finalizado";
    }

    private string GetFaseLabel(EventoDto ev)
    {
        var hoy = DateOnly.FromDateTime(DateTime.Now);
        if (hoy <= ev.FechaFinInscripciones) return "Fase de inscripción";
        if (hoy <= ev.FechaFinEntrega) return "Fase de entrega";
        if (hoy <= ev.FechaFinVotaciones) return "Fase de votación";
        if (hoy <= ev.FechaFinEvaluacionExperta) return "Fase de evaluación experta";
        if (hoy <= ev.FechaFinVotExperta) return "Fase de votación experta";   
        return "Fase finalizada";
    }
}
