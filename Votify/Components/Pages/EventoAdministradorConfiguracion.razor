@page "/eventoadmin/{EventoId:long}/configuracion"
@rendermode InteractiveServer

@inject ApiClient ApiClient
@inject BlazorAuthStateProvider AuthProvider
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ToastService Toasts

@if (cargando)
{
    <p>Cargando...</p>
}
else if (!string.IsNullOrWhiteSpace(error))
{
    <div style="color:red">@error</div>
}
else
{
    <!-- PANCARTA -->
    <div style="background:linear-gradient(90deg,#0f172a,#1e293b);color:white;padding:25px;border-radius:18px;margin-bottom:25px;">

        <div style="
        display:flex;
        align-items:center;
        gap:10px;
        flex-wrap:wrap;
        margin-bottom:18px;
        color:#cbd5e1;
        font-size:0.95rem;">

            <span @onclick='() => Nav.NavigateTo("/home")'
                  style="cursor:pointer;">
                Home
            </span>

            <span>›</span>

            <span @onclick='() => Nav.NavigateTo($"/eventoadmin/{EventoId}")'
                  style="cursor:pointer;">
                @evento?.Nombre
            </span>

            <span>›</span>

            <span style="color:white;font-weight:600;">
                Configuración
            </span>

        </div>

        <h1 style="margin-top:12px;">@evento?.Nombre</h1>
        <p style="color:#cbd5e1;">@evento?.Descripcion</p>

        <span style="background:#2563eb;padding:6px 12px;border-radius:8px;">
            Fase actual: @faseActual?.Fase
        </span>
    </div>

    <!-- FECHAS -->
    <h2>Fechas del evento</h2>

    <div style="display:flex;flex-direction:column;gap:15px;max-width:420px;margin-bottom:25px;">

        <div>
            <label>Fin inscripciones</label><br />
            <input type="date" @bind="finInscripciones" disabled="@(!puedeEditarInscripciones)" />
        </div>

        <div>
            <label>Fin entrega proyectos</label><br />
            <input type="date" @bind="finEntrega" disabled="@(!puedeEditarEntrega)" />
        </div>

        <div>
            <label>Fin votaciones</label><br />
            <input type="date" @bind="finVotaciones" disabled="@(!puedeEditarVotaciones)" />
        </div>

        <div>
            <label>Fin evaluación experta</label><br />
            <input type="date" @bind="finExperta" disabled="@(!puedeEditarExperta)" />
        </div>

        <div>
            <label>Fin votación experta</label><br />
            <input type="date" @bind="finVotExperta" disabled="@(!puedeEditarVotExperta)" />
        </div>

    </div>

    <button @onclick="GuardarFechas"
            style="background:#2563eb;color:white;border:none;padding:10px 16px;border-radius:10px;">
        Guardar fechas
    </button>
    <hr style="margin:30px 0;" />

    <!-- CONFIG EVENTO -->
    <h2>Configuración seleccionada</h2>

    <ul style="line-height:2;">
        <li>Tiene grupos: @(evento?.TieneGrupos == true ? "Sí" : "No")</li>
        <li>Grupos completos: @(evento?.GruposCompletos == true ? "Sí" : "No")</li>
        <li>Participantes por grupo: @evento?.ParticipantesPorGrupo</li>
        <li>Tipo comentario: @evento?.TipoComentario</li>
        <li>Tipo votación: @evento?.TipoVotacion</li>
    </ul>

    <hr style="margin:30px 0;" />

    <!-- ESTADO -->
    <h2>Administración</h2>

    <div style="display:flex;gap:12px;flex-wrap:wrap;">

        @if (evento?.Estado == "Activo")
        {
            <button @onclick="Pausar"
                    style="background:#f59e0b;color:white;border:none;padding:10px 14px;border-radius:10px;">
                ⏸️ Pausar evento
            </button>
        }

        @if (evento?.Estado == "Pausado")
        {
            <button @onclick="Reanudar"
                    style="background:#16a34a;color:white;border:none;padding:10px 14px;border-radius:10px;">
                ▶️ Reanudar evento
            </button>
        }

        @if (evento?.Estado != "Cerrado")
        {
            <button @onclick="Cerrar"
                    style="background:#dc2626;color:white;border:none;padding:10px 14px;border-radius:10px;">
                ❌ Cerrar evento
            </button>
        }

    </div>

}

@code {

    [Parameter] public long EventoId { get; set; }

    EventoDto? evento;
    FaseDto? faseActual;

    bool cargando = true;
    string error = "";
    string mensaje = "";
    string errorAccion = "";

    DateTime finInscripciones;
    DateTime finEntrega;
    DateTime finVotaciones;
    DateTime finExperta;
    DateTime finVotExperta;

    bool puedeEditarInscripciones;
    bool puedeEditarEntrega;
    bool puedeEditarVotaciones;
    bool puedeEditarExperta;
    bool puedeEditarVotExperta;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            var entrada = await ApiClient.GetFromJsonAsync<EntradaEventoRespuestaDto>(
                $"api/evento/{EventoId}");

            evento = entrada?.Evento;

            faseActual = await ApiClient.GetFromJsonAsync<FaseDto>(
                $"api/administrador/{EventoId}/fase");

            if (faseActual != null)
            {
                var fase = faseActual.Fase;

                puedeEditarInscripciones = fase == "Inscripciones";

                puedeEditarEntrega =
                    fase == "Inscripciones" ||
                    fase == "Entregas";

                puedeEditarVotaciones =
                    fase == "Inscripciones" ||
                    fase == "Entregas" ||
                    fase == "Votaciones";

                puedeEditarExperta =
                    fase == "Inscripciones" ||
                    fase == "Entregas" ||
                    fase == "Votaciones" ||
                    fase == "EvaluacionExperta";

                puedeEditarVotExperta =
                    fase == "Inscripciones" ||
                    fase == "Entregas" ||
                    fase == "Votaciones" ||
                    fase == "EvaluacionExperta" ||
                    fase == "VotacionExperta";
            }

            if (evento != null)
            {
                finInscripciones = evento.FechaFinInscripciones.ToDateTime(TimeOnly.MinValue);
                finEntrega = evento.FechaFinEntrega.ToDateTime(TimeOnly.MinValue);
                finVotaciones = evento.FechaFinVotaciones.ToDateTime(TimeOnly.MinValue);
                finExperta = evento.FechaFinEvaluacionExperta.ToDateTime(TimeOnly.MinValue);
                finVotExperta = evento.FechaFinVotExperta.ToDateTime(TimeOnly.MinValue);
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    void Volver()
    {
        Nav.NavigateTo($"/eventoadmin/{EventoId}");
    }

    async Task GuardarFechas()
    {
        mensaje = "";
        errorAccion = "";

        var loadingId = Toasts.ShowLoading("Guardando fechas...");
        try
        {
            var dto = new ActualizarFechasDto
            {
                FechaFinInscripciones = finInscripciones,
                FechaFinEntrega = finEntrega,
                FechaFinVotaciones = finVotaciones,
                FechaFinExperta = finExperta,
                FechaFinVotExperta = finVotExperta
            };

            var response = await ApiClient.PutAsJsonAsync(
                $"api/administrador/{EventoId}/fechas", dto);

            if (response.IsSuccessStatusCode)
            {
                Toasts.ShowSuccess("Fechas del evento actualizadas.");
                //  Recarga REAL de la página
                Nav.NavigateTo(Nav.Uri, true);
            }
            else
            {
                var err = await response.Content.ReadFromJsonAsync<ErrorDto>();
                errorAccion = err?.Error ?? "Error al guardar fechas";
                Toasts.ShowError(errorAccion);
            }
        }
        catch (Exception ex)
        {
            errorAccion = ex.Message;
            Toasts.ShowError($"Error al guardar las fechas: {ex.Message}");
        }
        finally
        {
            Toasts.Dismiss(loadingId);
        }
    }

    async Task Pausar()
    {
        var loadingId = Toasts.ShowLoading("Pausando evento...");
        try
        {
            var response = await ApiClient.PutAsync($"api/administrador/{EventoId}/pausar", null);
            if (response.IsSuccessStatusCode)
            {
                Toasts.ShowSuccess("Evento pausado. Los participantes no podrán realizar acciones temporalmente.");
                Nav.NavigateTo(Nav.Uri, true);
            }
            else
            {
                Toasts.ShowError(await ApiClient.LeerError(response));
            }
        }
        catch (Exception ex)
        {
            Toasts.ShowError($"Error al pausar el evento: {ex.Message}");
        }
        finally
        {
            Toasts.Dismiss(loadingId);
        }
    }

    async Task Reanudar()
    {
        var loadingId = Toasts.ShowLoading("Reanudando evento...");
        try
        {
            var response = await ApiClient.PutAsync($"api/administrador/{EventoId}/reanudar", null);
            if (response.IsSuccessStatusCode)
            {
                Toasts.ShowSuccess("Evento reanudado.");
                Nav.NavigateTo(Nav.Uri, true);
            }
            else
            {
                Toasts.ShowError(await ApiClient.LeerError(response));
            }
        }
        catch (Exception ex)
        {
            Toasts.ShowError($"Error al reanudar el evento: {ex.Message}");
        }
        finally
        {
            Toasts.Dismiss(loadingId);
        }
    }

    async Task Cerrar()
    {
        var ok = await JS.InvokeAsync<bool>("confirm",
            "¿Seguro que deseas cerrar el evento?");

        if (!ok) return;

        var loadingId = Toasts.ShowLoading("Cerrando evento...");
        try
        {
            var response = await ApiClient.PutAsync($"api/administrador/{EventoId}/cerrar", null);
            if (response.IsSuccessStatusCode)
            {
                Toasts.ShowSuccess("Evento cerrado correctamente.");
                Nav.NavigateTo("/home");
            }
            else
            {
                Toasts.ShowError(await ApiClient.LeerError(response));
            }
        }
        catch (Exception ex)
        {
            Toasts.ShowError($"Error al cerrar el evento: {ex.Message}");
        }
        finally
        {
            Toasts.Dismiss(loadingId);
        }
    }
}