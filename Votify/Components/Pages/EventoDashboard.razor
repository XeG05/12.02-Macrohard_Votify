@page "/evento-dashboard/{EventoId:long}"
@rendermode InteractiveServer

@inject ApiClient ApiClient
@inject BlazorAuthStateProvider AuthProvider
@inject NavigationManager Nav

@if (cargando)
{
    <p style="text-align:center; margin-top:50px;">Cargando resultados...</p>
}
else if (!string.IsNullOrWhiteSpace(error))
{
    <p style="text-align:center; color:red;">@error</p>
}
else
{
    <!-- PANCARTA -->
    <div style="background:linear-gradient(90deg,#0f172a,#1e293b);color:white;padding:25px;border-radius:18px;margin-bottom:25px;">

        <div style="
                                    display:flex;
                                    align-items:center;
                                    gap:10px;
                                    flex-wrap:wrap;
                                    margin-bottom:18px;
                                    color:#cbd5e1;
                                    font-size:0.95rem;">

            <span @onclick='() => Nav.NavigateTo("/home")'
                  style="cursor:pointer;">
                Home
            </span>

            <span>›</span>

            <span style="color:white;font-weight:600;">
                @evento?.Nombre
            </span>

        </div>

        <h1 style="margin-top:12px;">@evento?.Nombre</h1>
        <p style="color:#cbd5e1;">@evento?.Descripcion</p>

        <span style="background:#2563eb;padding:6px 12px;border-radius:8px;">
            Fase actual: @faseActual?.Fase
        </span>
    </div>
    <div class="dashboard-container">

        <!-- CABECERA -->
        <div class="header">
            <h1>@evento?.Nombre</h1>
            <p class="sub">Resultados finales del evento</p>
        </div>

        <!-- CATEGORÍAS -->
        @foreach (var categoria in categoriasRanking)
        {
            <div class="categoria-card">

                <h2 class="categoria-title">@categoria.NombreCategoria</h2>

                @if (categoria.Proyectos != null && categoria.Proyectos.Any())
                {
                    var top3 = categoria.Proyectos.Take(3).ToList();
                    var ganador = categoria.Proyectos.First();
                    var resto = categoria.Proyectos.Skip(3).ToList();

                    <!-- GANADOR PRINCIPAL -->
                    <div style="
                background:white;
                border-radius:22px;
                overflow:hidden;
                margin-bottom:28px;
                box-shadow:0 10px 30px rgba(0,0,0,0.10);
                border:1px solid #f3f4f6;">

                        <!-- línea dorada -->
                        <div style="
                    height:8px;
                    background:linear-gradient(90deg,#d4af37,#facc15);">
                        </div>

                        <div style="padding:30px; text-align:center;">

                            <div style="
                        font-size:16px;
                        color:#6b7280;
                        font-weight:600;
                        letter-spacing:1px;
                        text-transform:uppercase;">
                                🏆 Ganador de la categoría
                            </div>

                            <div style="
                        margin-top:12px;
                        font-size:40px;
                        font-weight:800;
                        color:#111827;">
                                @ganador.NombreGrupo
                            </div>

                            <div style="
                        margin-top:8px;
                        font-size:20px;
                        color:#4b5563;">
                                @ganador.NombreProyecto
                            </div>

                            <div style="
                        margin-top:16px;
                        font-size:28px;
                        font-weight:700;
                        color:#d97706;">
                                @ganador.PuntuacionMedia puntos
                            </div>

                            <button @onclick="() => IrAProyecto(ganador.IdProyecto)"
                                    style="
                            margin-top:20px;
                            background:#111827;
                            color:white;
                            border:none;
                            padding:12px 20px;
                            border-radius:12px;
                            cursor:pointer;
                            font-weight:600;
                            font-size:15px;">
                                Ver proyecto
                            </button>

                        </div>
                    </div>

                    <!-- SEGUNDO Y TERCER PUESTO -->
                    @if (top3.Count > 1)
                    {
                        <div style="
                        display:grid;
                        grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
                        gap:20px;
                        margin-bottom:30px;">

                            @for (int i = 1; i < top3.Count; i++)
                            {
                                var p = top3[i];

                                var color = i == 1
                                ? "linear-gradient(90deg,#9ca3af,#d1d5db)"
                                : "linear-gradient(90deg,#b45309,#d97706)";

                                <div style="
                                    background:white;
                                    border-radius:18px;
                                    overflow:hidden;
                                    box-shadow:0 8px 24px rgba(0,0,0,0.08);
                                    border:1px solid #f3f4f6;">

                                    <!-- línea superior -->
                                    <div style="
                                        height:7px;
                                        background:@color;">
                                    </div>

                                    <div style="padding:24px; text-align:center;">

                                        <div style="font-size:34px;">
                                            @(i == 1 ? "🥈" : "🥉")
                                        </div>

                                        <div style="
                                            margin-top:10px;
                                            font-size:22px;
                                            font-weight:700;
                                            color:#111827;">
                                            @p.NombreGrupo
                                        </div>

                                        <div style="
                                            margin-top:6px;
                                            color:#6b7280;">
                                            @p.NombreProyecto
                                        </div>

                                        <div style="
                                            margin-top:14px;
                                            font-size:20px;
                                            font-weight:700;">
                                            @p.PuntuacionMedia puntos
                                        </div>

                                        <button @onclick="() => IrAProyecto(p.IdProyecto)"
                                                style="
                                                margin-top:16px;
                                                background:#2563eb;
                                                color:white;
                                                border:none;
                                                padding:10px 16px;
                                                border-radius:10px;
                                                cursor:pointer;
                                                font-weight:600;">
                                            Ver proyecto
                                        </button>

                                    </div>
                                </div>
                            }
                        </div>
                    }

                    <!--  RANKING RESTO -->
                    <div class="ranking-list">

                        @{
                            var max = categoria.Proyectos.Max(p => p.PuntuacionMedia);
                        }

                        @foreach (var item in resto.Select((v, i) => new { v, i }))
                        {
                            var porcentaje = max > 0 ? (item.v.PuntuacionMedia / max) * 100 : 0;

                            <div class="ranking-item">

                                <div class="pos">#@(item.i + 4)</div>

                                <div class="info">
                                    <strong>@item.v.NombreProyecto</strong>
                                    <span>@item.v.NombreGrupo</span>

                                    <!-- barra -->
                                    <div class="barra">
                                        <div class="barra-fill"
                                             style="width:@($"{porcentaje}%")"></div>
                                    </div>
                                </div>

                                <div style="display:flex; align-items:center; gap:12px;">

                                    <div class="pts">
                                        @item.v.PuntuacionMedia
                                    </div>

                                    <button @onclick="() => IrAProyecto(item.v.IdProyecto)"
                                            style="
                                background:#2563eb;
                                color:white;
                                border:none;
                                padding:6px 10px;
                                border-radius:8px;
                                cursor:pointer;">
                                        Ver
                                    </button>

                                </div>

                            </div>
                        }
                    </div>
                }
            </div>
        }

        <!-- BOTÓN -->
        <div class="volver">
            <button @onclick="IrAVistaOriginal">
                Volver a mi vista del evento
            </button>
        </div>

    </div>
}

@code {
    [Parameter] public long EventoId { get; set; }

    EventoDto? evento;
    List<RankingCategoriaDto> categoriasRanking = new();
    FaseDto? faseActual;

    string rol = "";
    bool cargando = true;
    string error = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        if (!AuthProvider.EstaAutenticado)
        {
            Nav.NavigateTo("/");
            return;
        }

        try
        {
            var entrada = await ApiClient.GetFromJsonAsync<EntradaEventoRespuestaDto>(
                $"api/evento/{EventoId}");

            if (entrada == null)
            {
                error = "No se pudo cargar el evento";
                return;
            }

            evento = entrada.Evento;

            if (entrada.Rol.EsAdministrador) rol = "Admin";
            else if (entrada.Rol.EsParticipante) rol = "Participante";
            else if (entrada.Rol.EsJurado) rol = "Jurado";
            else rol = "Votante";

            var ranking = await ApiClient.GetFromJsonAsync<List<RankingCategoriaDto>>(
                $"api/evento/{EventoId}/ranking");

            faseActual = await ApiClient.GetFromJsonAsync<FaseDto>($"api/administrador/{EventoId}/fase");

            if (ranking != null)
                categoriasRanking = ranking;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private void IrAVistaOriginal()
    {
        switch (rol)
        {
            case "Admin":
                Nav.NavigateTo($"/eventoadmin/{EventoId}");
                break;

            case "Participante":
                Nav.NavigateTo($"/eventoparticipante/{EventoId}");
                break;

            case "Jurado":
                Nav.NavigateTo($"/eventojurado/{EventoId}");
                break;

            default:
                Nav.NavigateTo($"/listaproyectos/{EventoId}");
                break;
        }
    }

    void VolverHome()
    {
        Nav.NavigateTo("/home");
    }

    private void IrAProyecto(long idProyecto)
    {
        Nav.NavigateTo($"/{EventoId}/proyecto/{idProyecto}");
    }
}