@page "/cerrarsesion"
@rendermode InteractiveServer
@inject NavigationManager Nav
@inject Votify.Auth.BlazorAuthStateProvider AuthProvider

<div style="display: flex; justify-content: center; align-items: center; min-height: 50vh;">
    <div style="text-align: center;">
        <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
            <span class="visually-hidden">Cerrando sesión...</span>
        </div>
        <h3 class="mt-3">Cerrando sesión...</h3>
        <p class="text-muted">Por favor, espera un momento.</p>
    </div>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await AuthProvider.MarcarDesconectado();
            Nav.NavigateTo("/");
        }
    }
}
