@page "/eventojurado/{EventoId:long}/categoria/{CategoriaId:long}"
@rendermode InteractiveServer
@inject ApiClient ApiClient
@inject NavigationManager Nav
@inject BlazorAuthStateProvider AuthProvider
@using Votify.LógicaNegocio.DTOs

@if (cargando)
{
    <div class="ejp-loading-state">
        <div class="ejp-spinner"></div>
        <p>Cargando información de la categoría...</p>
    </div>
}
else if (!string.IsNullOrWhiteSpace(error))
{
    <div class="ejp-wrapper">
        <div class="ejp-alert ejp-alert-error">@error</div>
    </div>
}
else if (eventoNombre != "" && categoria != null)
{
    <div class="ejp-wrapper">

        <!-- Hero/Header de la Categoria copiando EventoJuradoPagPrincipal -->
        <div class="ejp-hero">
            <div class="ejp-hero-content">
                <div class="ejp-hero-top">
                    <div style="flex: 1; display: flex; flex-direction: column; justify-content: flex-start;">
                        <div class="ejp-breadcrumb" style="display:flex; align-items:center; gap:8px; flex-wrap:nowrap; margin-bottom:18px; color:#cbd5e1; font-size:0.95rem; overflow:hidden; cursor:default;">
                            <span @onclick='() => Nav.NavigateTo("/home")' style="cursor:pointer; flex-shrink: 0;">Home</span>
                            <span style="display: flex; align-items: center; flex-shrink: 0; cursor:default;">›</span>
                            <span @onclick='() => Nav.NavigateTo($"/eventojurado/{EventoId}")' style="cursor:pointer; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0;">
                                @eventoNombre
                            </span>
                            <span style="display: flex; align-items: center; flex-shrink: 0; cursor:default;">›</span>
                            <span style="color:white; font-weight:600; flex-shrink: 0; cursor:default;">
                                Categoría
                            </span>
                        </div>

                        <span style="display:inline-block; padding: 4px 10px; background: rgba(255,255,255,0.15); border-radius: 6px; font-size: 0.85rem; font-weight: 600; width: fit-content; margin-bottom: 5px; color:#cbd5e1; text-transform:uppercase; letter-spacing:0.5px;">
                            @eventoNombre
                        </span>
                        <h1 style="margin: 0; font-size: 2.2rem; color: white;">@categoria.Nombre</h1>
                    </div>

                    <div style="border-left: 2px solid rgba(255,255,255,0.2); padding-left: 1rem; margin-left: 1rem; flex: 2; display: flex; align-items: flex-start; justify-content: flex-start;">
                        <p style="margin: 0; max-width: 700px; color: rgba(255,255,255,0.78); font-size: 1rem; line-height: 1.6;">@categoria.Descripcion</p>
                    </div>

                    <div class="ejp-hero-side" style="border-left: 2px solid rgba(255,255,255,0.2); padding-left: 1rem; margin-left: 1rem;">
                        <span class="ejp-role-badge">Jurado</span>
                        <span class="ejp-role-badge-white">Panel de categoría</span>

                        <span class="ejp-status-badge @(categoria.ProyectosRevisados == categoria.ProyectosTotales ? "is-ok" : "is-pending")">
                            Revisados: @categoria.ProyectosRevisados/@categoria.ProyectosTotales
                        </span>

                        @if (categoria.ProyectosTotales - categoria.ProyectosRevisados > 0)
                        {
                            <span class="ejp-status-badge is-pending">
                                @(categoria.ProyectosTotales - categoria.ProyectosRevisados) proyectos sin revisar
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>

        @if (Jurados != null && Jurados.Any())
        {
            <div style="margin-bottom:25px; margin-top:20px; background:#f1f5f9; padding:16px; border-radius:12px; border:1px solid #e2e8f0;">

                <h3 style="margin-bottom:10px; margin-top:0;"> Jurados de esta categoría</h3>

                <div style="display:flex;flex-wrap:wrap;gap:10px;">
                    @foreach (var jurado in Jurados)
                    {
                        <span style="background:#2563eb; color:white; padding:6px 12px; border-radius:999px; font-size:13px;">
                            @jurado
                        </span>
                    }
                </div>
            </div>
        }

        <div style="display:flex;align-items:center;">
            <h2 class="ejc-section-title">Proyectos</h2>
            <ToolTip Wide="true" Title="Tu trabajo como jurado"
                     Text="Revisa cada proyecto de la categoría: entra para evaluar criterio a criterio durante la fase de opinión experta, y vota durante la fase de votación experta. El estado a la derecha indica si ya lo has revisado o sigue pendiente." />
        </div>
        <hr class="ejc-divider" />

        <div class="ejc-proyectos-list">
            @if (proyectos != null && proyectos.Any())
            {
                @foreach (var p in proyectos)
                {
                    <div class="ejc-proyecto-card">

                        <!-- Indicador visual de si ha sido revisado tipo semáforo en el borde derecho -->
                        <div class="ejc-proyecto-status-bar @(p.Revisado ? "revisado" : "pendiente")" title="@(p.Revisado ? "Proyecto Revisado" : "Pendiente de revisar")"></div>

                        <!-- 3 Columnas principales de info del proyecto -->
                        <div class="ejc-proyecto-cols" style="cursor: pointer;" @onclick="() => IrAProyecto(p.Id)">

                            <!-- Izquierda: Titulo + Participantes -->
                            <div class="ejc-col-left">
                                <h3 class="ejc-proyecto-title">@p.Nombre</h3>
                                <div class="ejc-participantes-list">
                                        @foreach(var participante in p.ParticipantesNombres)
                                        {
                                            <p>@participante</p>
                                        }
                                </div>
                            </div>

                            <!-- Centro: Descripcion Breve -->
                            <div class="ejc-col-center">
                                <div class="ejc-desc-box">
                                    <p>@p.DescripcionBreve</p>
                                </div>
                            </div>

                            <!-- Derecha: Botones -->
                            <div class="ejc-col-right" @onclick:stopPropagation="true">
                                <div style="display:flex;align-items:center;justify-content:flex-end;">
                                    <button class="ejc-card-btn" @onclick="() => IrAResultadoPopular(p.Id)">Resultado de la votación popular</button>
                                    <ToolTip Wide="true" AlignRight="true"
                                             Text="Consulta cómo ha votado el público a este proyecto antes de emitir tu propio voto experto." />
                                </div>
                                <div style="display:flex;align-items:center;justify-content:flex-end;">
                                    <button class="ejc-card-btn" @onclick="() => IrAComentariosJurado(p.Id)">Comentarios del jurado</button>
                                    <ToolTip Wide="true" AlignRight="true"
                                             Text="Revisa los comentarios que tú y los demás jurados habéis dejado, o consulta el resumen automático generado por IA." />
                                </div>
                            </div>

                        </div>
                    </div>
                }
            }
            else
            {
                <p style="color:#6b7280; font-style:italic;">No hay proyectos asociados a esta categoría.</p>
            }
        </div>
    </div>
}

@code {
    [Parameter] public long EventoId { get; set; }
    [Parameter] public long CategoriaId { get; set; }

    private bool cargando = true;
    private string error = "";

    private class EventoNombreResponse { public string Nombre { get; set; } = string.Empty; }
    private String eventoNombre = "";
    private CategoriaJuradoDto? categoria;
    private List<ProyectoJuradoViewDto>? proyectos;
    private List<string>? Jurados;

    protected override async Task OnInitializedAsync()
    {
        var correo = AuthProvider.ObtenerCorreo();
        if (string.IsNullOrWhiteSpace(correo) || !AuthProvider.EstaAutenticado)
        {
            Nav.NavigateTo("/");
            return;
        }

        try
        {
            var evtResp = await ApiClient.GetFromJsonAsync<EventoNombreResponse>($"api/jurado/{EventoId}/get-nombre");
            eventoNombre = evtResp?.Nombre ?? "";
            categoria = await ApiClient.GetFromJsonAsync<CategoriaJuradoDto>($"api/jurado/{EventoId}/categoria/{CategoriaId}");
            proyectos = await ApiClient.GetFromJsonAsync<List<ProyectoJuradoViewDto>>($"api/jurado/{EventoId}/categoria/{CategoriaId}/proyectos");
            Jurados = await ApiClient.GetFromJsonAsync<List<string>>($"api/jurado/{EventoId}/categoria/{CategoriaId}/jurados"); 

        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            error = "Ocurrió un error cargando los datos.";
        }
        finally
        {
            cargando = false;
        }
    }

    private void VolverAlEvento()
    {
        Nav.NavigateTo($"/eventojurado/{EventoId}");
    }

    private void IrAProyecto(long idProyecto)
    {
        Nav.NavigateTo($"/{EventoId}/proyecto/{idProyecto}");
    }

    private void IrAResultadoPopular(long idProyecto)
    {
        Nav.NavigateTo($"/eventojurado/{EventoId}/categoria/{CategoriaId}/proyecto/{idProyecto}/resultados");
    }

    private void IrAComentariosJurado(long idProyecto)
    {
        Nav.NavigateTo($"/eventojurado/{EventoId}/categoria/{CategoriaId}/proyecto/{idProyecto}/comentarios");
    }
}
