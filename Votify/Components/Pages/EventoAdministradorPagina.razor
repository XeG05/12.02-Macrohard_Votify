    async Task AñadirParticipanteUI(long idGrupo)
    {
        if (eventoAdmin != null && !string.IsNullOrWhiteSpace(nuevoCorreoPorGrupo[idGrupo]))
        {
            await eventoAdmin.AñadirParticipante(nuevoCorreoPorGrupo[idGrupo], idGrupo);

            var participantes = await eventoAdmin.VerParticipantes(idGrupo);
            participantesPorGrupo[idGrupo] = participantes;

            nuevoCorreoPorGrupo[idGrupo] = "";
        }
    }
    async Task EliminarParticipanteUI(long idParticipante)
    {
        if (eventoAdmin != null)
        {
            await eventoAdmin.EliminarParticipante(idParticipante);

            // recargar TODOS los grupos visibles
            foreach (var g in grupos!)
            {
                var participantes = await eventoAdmin.VerParticipantes(g.Id);
                participantesPorGrupo[g.Id] = participantes;
            }
        }
    }*/ //PARA EL SPRINT 2

}