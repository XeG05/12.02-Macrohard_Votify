@page "/eventoadmin/{EventoId:long}"
@rendermode InteractiveServer
@inject ApiClient ApiClient
@inject BlazorAuthStateProvider AuthProvider
@inject NavigationManager Nav
@inject IJSRuntime JS



@if (cargando)
{
    <p>Cargando...</p>
}
else if (!string.IsNullOrWhiteSpace(error))
{
    <div style="color:red">@error</div>
}
else
{
    <div class="eap-wrapper">
        <div class="eap-hero">
            <div class="eap-hero-content">
                <div class="eap-hero-top">
                    <div style="flex: 1; display: flex; flex-direction: column; justify-content: space-between;">
                        <div class="eap-breadcrumb" @onclick="VolverHome">← Volver al home</div>
                        <h1>@evento?.Nombre</h1>
                        <div style="display: flex; gap: 0.65rem;">
                            <span class="eap-phase-pill @ObtenerClaseFase(faseActual?.Fase)">@FormatearFaseLabel(faseActual?.Fase)</span>
                        </div>
                    </div>

                    <div class="eap-descripcion-container" style="border-left: 2px solid rgba(255,255,255,0.2); padding-left: 1rem; margin-left: 1rem; flex: 2; display: flex; align-items: flex-start; justify-content: flex-start;">
                        <p style="margin: 0; max-width: 700px; color: rgba(255,255,255,0.78); font-size: 1rem; line-height: 1.6;">@evento?.Descripcion</p>
                    </div>

                    <div class="eap-hero-side" style="border-left: 2px solid rgba(255,255,255,0.2); padding-left: 1rem; margin-left: 1rem;">
                        <span class="eap-role-badge">Administrador</span>
                        <span class="eap-role-badge-white">Panel de admin</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- CONTENIDO ADMINISTRADOR -->
    <div style="max-width: 1200px; margin: 0 auto; padding: 0 2rem;">
        <!-- BOTÓN CONFIG EVENTO -->
        <div style="margin-bottom:20px; display: flex; justify-content: flex-end;">
            <button class="eap-btn-config" @onclick="IrAConfiguracionEvento">
                <span class="eap-btn-icon">⚙️</span> Configuración del evento
            </button>
        </div>

    <h3>Categorías</h3>

    @if (categorias == null || categorias.Count == 0)
    {
        <p>No hay categorías.</p>
    }
    else
    {
        @foreach (var c in categorias)
        {
            <div style="border:1px solid #e5e7eb;border-radius:14px;padding:16px;margin-bottom:12px;display:flex;justify-content:space-between;align-items:center;">

                <div>
                    <b style="font-size:18px;">@c.Nombre</b>
                </div>

                <div style="display:flex;gap:10px;">

                    <button @onclick="() => IrAVotacionesCategoria(c.Id)"
                            style="background:#2563eb;color:white;border:none;padding:8px 12px;border-radius:8px;">
                        Ver votaciones
                    </button>

                    <button @onclick="() => IrACategoria(c.Id)"
                            style="background:#0f172a;color:white;border:none;padding:8px 12px;border-radius:8px;">
                        Configurar categoría
                    </button>

                </div>
            </div>
        }
    }
    </div>
}

@code {

    [Parameter] public long EventoId { get; set; }

    EventoDto? evento;
    FaseDto? faseActual;
    List<CategoriaDto>? categorias;

    bool cargando = true;
    string error = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var correo = AuthProvider.ObtenerCorreo();

        if (string.IsNullOrWhiteSpace(correo) || !AuthProvider.EstaAutenticado)
        {
            Nav.NavigateTo("/");
            return;
        }

        try
        {
            var entrada = await ApiClient.GetFromJsonAsync<EntradaEventoRespuestaDto>(
                $"api/evento/{EventoId}");

            if (entrada == null)
            {
                error = "No se pudo cargar el evento.";
                return;
            }

            if (!entrada.Rol.EsAdministrador)
            {
                error = "No tienes permisos.";
                return;
            }

            evento = entrada.Evento;

            categorias = await ApiClient.GetFromJsonAsync<List<CategoriaDto>>(
                $"api/evento/{EventoId}/categorias");

            faseActual = await ApiClient.GetFromJsonAsync<FaseDto>(
                $"api/administrador/{EventoId}/fase");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    void VolverHome()
    {
        Nav.NavigateTo("/home");
    }

    void IrAVotacionesCategoria(long idCategoria)
    {
        Nav.NavigateTo($"/eventoadmin/{EventoId}/votaciones/{idCategoria}");
    }

    void IrACategoria(long idCategoria)
    {
        Nav.NavigateTo($"/eventoadmin/{EventoId}/categoria/{idCategoria}");
    }

    void IrAConfiguracionEvento()
    {
        Nav.NavigateTo($"/eventoadmin/{EventoId}/configuracion");
    }

    string ObtenerClaseFase(string? fase)
    {
        var f = fase?.ToLower() ?? "";
        if (f.Contains("inscrip")) return "fase-inscripciones";
        if (f.Contains("entreg")) return "fase-entregas";
        if (f.Contains("votacionexperta") || f.Contains("votacion experta")) return "fase-votacion-experta";
        if (f.Contains("votac")) return "fase-votaciones";
        return "fase-finalizado";
    }

    string FormatearFaseLabel(string? fase)
    {
        if (string.IsNullOrWhiteSpace(fase)) return "...";
        var f = fase.ToLower();
        if (f.Contains("inscrip")) return "En fase de inscripciones";
        if (f.Contains("entreg")) return "En fase de entregas";
        if (f.Contains("votacionexperta")) return "En fase de votación experta";
        if (f.Contains("votacion")) return "En fase de votaciones";
        if (f.Contains("resultados") || f.Contains("finalizad")) return "Fase finalizada";
        return $"En fase de {fase}";
    }
}