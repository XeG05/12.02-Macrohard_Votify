@page "/eventoadmin/{EventoId:long}"
@rendermode InteractiveServer
@inject ApiClient ApiClient
@inject BlazorAuthStateProvider AuthProvider
@inject NavigationManager Nav
@inject IJSRuntime JS

<link href="Votify.Components.Pages.EventoJuradoPagPrincipal.razor.css" rel="stylesheet" />

@if (cargando)
{
    <p>Cargando...</p>
}
else if (!string.IsNullOrWhiteSpace(error))
{
    <div style="color:red">@error</div>
}
else
{
    <div class="ejp-hero">
        <div class="ejp-hero-content">
            <div class="ejp-breadcrumb" @onclick="VolverHome">← Volver al home</div>

            <div class="ejp-hero-top">
                <div style="flex: 1; display: flex; flex-direction: column; justify-content: space-between;">
                    <h1>@evento?.Nombre</h1>
                </div>

                <div class="ejp-descripcion-container" style="border-left: 2px solid rgba(255,255,255,0.2); padding-left: 1rem; margin-left: 1rem; flex: 2; display: flex; align-items: center;">
                    <p style="margin: 0;">@evento?.Descripcion</p>
                </div>

                <div class="ejp-hero-side" style="border-left: 2px solid rgba(255,255,255,0.2); padding-left: 1rem; margin-left: 1rem;">
                    <span class="ejp-role-badge">Administrador</span>
                    <span class="ejp-role-badge" style="background: rgba(37, 99, 235, 0.2); border: 1px solid rgba(37, 99, 235, 0.3); color: #93c5fd;">@faseActual?.Fase</span>
                </div>
            </div>
        </div>
    </div>

    <!-- BOTÓN CONFIG EVENTO -->
    <div style="margin-bottom:20px;">
        <button @onclick="IrAConfiguracionEvento"
                style="background:#16a34a;color:white;border:none;padding:10px 18px;border-radius:10px;">
            ⚙️ Configuración del evento
        </button>
    </div>

    <h3>Categorías</h3>

    @if (categorias == null || categorias.Count == 0)
    {
        <p>No hay categorías.</p>
    }
    else
    {
        @foreach (var c in categorias)
        {
            <div style="border:1px solid #e5e7eb;border-radius:14px;padding:16px;margin-bottom:12px;display:flex;justify-content:space-between;align-items:center;">

                <div>
                    <b style="font-size:18px;">@c.Nombre</b>
                </div>

                <div style="display:flex;gap:10px;">

                    <button @onclick="() => IrAVotacionesCategoria(c.Id)"
                            style="background:#2563eb;color:white;border:none;padding:8px 12px;border-radius:8px;">
                        Ver votaciones
                    </button>

                    <button @onclick="() => IrACategoria(c.Id)"
                            style="background:#0f172a;color:white;border:none;padding:8px 12px;border-radius:8px;">
                        Configurar categoría
                    </button>

                </div>
            </div>
        }
    }
}

@code {

    [Parameter] public long EventoId { get; set; }

    EventoDto? evento;
    FaseDto? faseActual;
    List<CategoriaDto>? categorias;

    bool cargando = true;
    string error = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var correo = AuthProvider.ObtenerCorreo();

        if (string.IsNullOrWhiteSpace(correo) || !AuthProvider.EstaAutenticado)
        {
            Nav.NavigateTo("/");
            return;
        }

        try
        {
            var entrada = await ApiClient.GetFromJsonAsync<EntradaEventoRespuestaDto>(
                $"api/evento/{EventoId}");

            if (entrada == null)
            {
                error = "No se pudo cargar el evento.";
                return;
            }

            if (!entrada.Rol.EsAdministrador)
            {
                error = "No tienes permisos.";
                return;
            }

            evento = entrada.Evento;

            categorias = await ApiClient.GetFromJsonAsync<List<CategoriaDto>>(
                $"api/evento/{EventoId}/categorias");

            faseActual = await ApiClient.GetFromJsonAsync<FaseDto>(
                $"api/administrador/{EventoId}/fase");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    void VolverHome()
    {
        Nav.NavigateTo("/home");
    }

    void IrAVotacionesCategoria(long idCategoria)
    {
        Nav.NavigateTo($"/eventoadmin/{EventoId}/votaciones/{idCategoria}");
    }

    void IrACategoria(long idCategoria)
    {
        Nav.NavigateTo($"/eventoadmin/{EventoId}/categoria/{idCategoria}");
    }

    void IrAConfiguracionEvento()
    {
        Nav.NavigateTo($"/eventoadmin/{EventoId}/configuracion");
    }
}