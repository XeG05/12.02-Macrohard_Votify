@page "/eventoadmin/{EventoId:long}"
@rendermode InteractiveServer
@inject ApiClient ApiClient
@inject BlazorAuthStateProvider AuthProvider
@inject NavigationManager Nav
@inject IJSRuntime JS

@if (cargando)
{
    <p>Cargando...</p>
}
else if (!string.IsNullOrWhiteSpace(error))
{
    <div style="color:red">@error</div>
}
else
{
    <div style="background: linear-gradient(90deg,#0f172a,#1e293b); color:white; padding:25px; border-radius:20px; margin-bottom:20px;">

        <button @onclick="VolverHome"
                style="background:none;border:none;color:#9ca3af;cursor:pointer;">
            ← Volver
        </button>

        <h1 style="margin:10px 0;">@evento?.Nombre</h1>
        <p style="color:#cbd5f5;">@evento?.Descripcion</p>

        <span style="background:#f59e0b; padding:5px 10px; border-radius:10px;">
            Admin
        </span>

    </div>

    @if (categorias == null)
    {
        <p>Cargando...</p>
    }
    else
    {
        <ul>
            @foreach (var c in categorias)
            {
                <div style="border:1px solid #e5e7eb; border-radius:15px; padding:15px; margin-bottom:10px; display:flex; justify-content:space-between; align-items:center;">

                    <div>
                        <b>@c.Nombre</b>
                    </div>

                    <div style="display:flex; gap:10px;">
                        <button @onclick="() => CargarGrupos(c.Id)">
                            Ver grupos
                        </button>

                        <button @onclick="() => IrAVotacionesCategoria(c.Id)"
                                style="background:#2563eb;color:white;border:none;padding:6px 12px;border-radius:8px;">
                            Ver votaciones
                        </button>
                    </div>

                </div>
            }
        </ul>
    }

    @if (grupos != null)
    {
        <h3>Grupos</h3>

    @if (faseActual?.Fase == "Inscripciones")
    {
        <button @onclick="CrearGrupo"
                style="margin-bottom:15px; background:#16a34a; color:white; padding:6px 12px; border-radius:8px;">
            + Añadir grupo
        </button>


    }


    @foreach (var g in grupos)
    {
            <div @key="g.Id" style="border:1px solid #e5e7eb; border-radius:12px; padding:15px; margin-bottom:15px;">

            <!-- Nombre grupo -->
                <div style="display:flex; align-items:center; gap:10px;">
                <input type="text"
                       @bind="g.Nombre"
                       disabled="@(faseActual?.Fase != "Inscripciones")"
                           style="font-weight:bold; font-size:16px;" />


                @if (faseActual?.Fase == "Inscripciones")
                    {
                        <button @onclick="() => GuardarNombreGrupo(g)"
                                style="margin-left:10px; background:#2563eb; color:white; border:none; padding:4px 10px; border-radius:6px;">
                            Guardar nombre
                        </button>
                    <button @onclick="() => EliminarGrupoUI(g.Id)"
                            style="background:#dc2626; color:white; border:none; padding:4px 10px; border-radius:6px;">
                        ✕
                    </button>
                }
            </div>

            <hr />

            <!-- PARTICIPANTES EDITABLES -->
            @if (faseActual?.Fase == "Inscripciones")
            {
                    @foreach (var item in g.CorreosParticipantes.Select((value, index) => new { value, index }))
                    {
                        <div style="margin-bottom:5px; display:flex; gap:8px; align-items:center;">

                            <input type="text"
                                   value="@item.value"
                                   @oninput='e => g.CorreosParticipantes[item.index] = e.Value?.ToString() ?? ""'
                                   style="width:250px;" />

                            <button @onclick="() => EliminarParticipante(g, item.index)">
                                ❌
                            </button>

                            @if (string.IsNullOrWhiteSpace(item.value)
                                    && pendientesPorGrupo.ContainsKey(g.Id)
                                    && pendientesPorGrupo[g.Id] > item.index)
                            {
                                <span style="
                                            font-size:13px;
                                            color:#d97706;
                                            font-style:italic;">
                                    Esperando invitación...
                                </span>
                            }

                        </div>
                    }
                <button @onclick="() => AñadirCampoParticipante(g)"
                        style="margin-top:5px;">
                    + Añadir participante
                </button>

                <br />

                <button @onclick="() => GuardarGrupo(g)"
                        style="margin-top:10px; background:#2563eb; color:white; padding:5px 10px; border-radius:6px;">
                    💾 Guardar cambios
                </button>
            }
            else
            {
                <!-- SOLO LECTURA -->
                <button @onclick="() => CargarParticipantes(g.Id)">
                    Ver participantes
                </button>

                    @if (participantesPorGrupo.TryGetValue(g.Id, out var lista))
                    {
                        @if (lista != null && lista.Any())
                        {
                            <ul>
                                @foreach (var p in lista)
                                {
                                    <li>@p.Correo</li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p style="color:#9ca3af; font-style:italic;">
                                En espera de que los participantes acepten la invitación
                            </p>
                        }

                    }


                    
            }
        </div>
    }
    }

    <hr />

    <h3>Periodos</h3>

    @if (evento != null)
    {
        <ul>
            <li>Fin inscripciones: @evento.FechaFinInscripciones.ToString("dd/MM/yyyy")</li>
            <li>Fin entrega proyectos: @evento.FechaFinEntrega.ToString("dd/MM/yyyy")</li>
            <li>Fin votaciones: @evento.FechaFinVotaciones.ToString("dd/MM/yyyy")</li>
            <li>Fin evaluación experta: @evento.FechaFinEvaluacionExperta.ToString("dd/MM/yyyy")</li>
        </ul>

        <h3>Editar fechas</h3>

        <div style="display:flex; flex-direction:column; gap:15px; max-width:350px;">

            <div>
                <label style="font-weight:bold;">Fin de inscripciones</label><br />
                <input type="date"
                       @bind="finInscripciones"
                       disabled="@(!puedeEditarInscripciones)"
                       style="padding:6px; border-radius:8px; border:1px solid #ccc; width:100%;" />
            </div>

            <div>
                <label style="font-weight:bold;">Fin de entrega de proyectos</label><br />
                <input type="date"
                       @bind="finEntrega"
                       disabled="@(!puedeEditarEntrega)"
                       style="padding:6px; border-radius:8px; border:1px solid #ccc; width:100%;" />
            </div>

            <div>
                <label style="font-weight:bold;">Fin de votaciones</label><br />
                <input type="date"
                       @bind="finVotaciones"
                       disabled="@(!puedeEditarVotaciones)"
                       style="padding:6px; border-radius:8px; border:1px solid #ccc; width:100%;" />
            </div>

            <div>
                <label style="font-weight:bold;">Fin de evaluación experta</label><br />
                <input type="date"
                       @bind="finExperta"
                       disabled="@(!puedeEditarExperta)"
                       style="padding:6px; border-radius:8px; border:1px solid #ccc; width:100%;" />
            </div>

        </div>

        <button @onclick="ActualizarFechas"
                disabled="@(!hayCambiosFechas || guardando)"
                style="
                    background-color:@((!hayCambiosFechas || guardando) ? "#9ca3af" : "#2563eb");
                    color:white;
                    opacity:@((!hayCambiosFechas || guardando) ? "0.6" : "1");
                ">
            @(guardando ? "Guardando..." : "Guardar cambios")
        </button>

        @if (!string.IsNullOrWhiteSpace(mensajeError))
        {
            <div style="
                    margin-top:15px;
                    padding:10px;
                    border-radius:10px;
                    background:@(hayError ? "#fee2e2" : "#dcfce7");
                    color:@(hayError ? "#991b1b" : "#166534");
                ">
                @mensajeError
            </div>
        }
    }

    <hr />

    <h3>Configuración</h3>

    @if (evento != null)
    {
        <ul>
            <li>Tiene grupos: @(evento.TieneGrupos ? "Sí" : "No")</li>
            <li>Grupos completos: @(evento.GruposCompletos ? "Sí" : "No")</li>
            <li>Participantes por grupo: @evento.ParticipantesPorGrupo</li>
        </ul>
        <div class="admin-actions">

            @if (evento?.Estado == "Activo")
            {
                <button class="btn-warning" @onclick="PausarEvento">
                    ⏸️ Pausar evento
                </button>
            }

            @if (evento?.Estado == "Pausado")
            {
                <button class="btn-success" @onclick="ReanudarEvento">
                    ▶️ Reanudar evento
                </button>
            }

            @if (evento?.Estado != "Cerrado")
            {
                <button class="btn-danger" @onclick="CerrarEvento">
                    ❌ Cerrar evento
                </button>
            }

        </div>
    }
}

@code {
    [Parameter] public long EventoId { get; set; }

    List<CategoriaDto>? categorias;
    List<GrupoDto>? grupos;

    Dictionary<long, List<MiembroGrupoDto>> participantesPorGrupo = new();

    Dictionary<long, string> nuevoCorreoPorGrupo = new();

    Dictionary<long, int> pendientesPorGrupo = new();

    EventoDto? evento;
    FaseDto? faseActual;

    DateTime _finInscripciones;
    DateTime _finEntrega;
    DateTime _finVotaciones;
    DateTime _finExperta;

    bool puedeEditarInscripciones;
    bool puedeEditarEntrega;
    bool puedeEditarVotaciones;
    bool puedeEditarExperta;
    bool hayCambiosFechas;


    string nombreGrupoNuevo = "";

    public long? categoriaSeleccionadaId;
    bool cargando = true;
    string error = "";

    DateTime finInscripciones
    {
        get => _finInscripciones;
        set
        {
            _finInscripciones = value;
            DetectarCambios();
        }
    }

    DateTime finEntrega
    {
        get => _finEntrega;
        set
        {
            _finEntrega = value;
            DetectarCambios();
        }
    }

    DateTime finVotaciones
    {
        get => _finVotaciones;
        set
        {
            _finVotaciones = value;
            DetectarCambios();
        }
    }

    DateTime finExperta
    {
        get => _finExperta;
        set
        {
            _finExperta = value;
            DetectarCambios();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var correo = AuthProvider.ObtenerCorreo();
        if (string.IsNullOrWhiteSpace(correo) || !AuthProvider.EstaAutenticado)
        {
            // usuario no autenticado, volver al login
            Nav.NavigateTo("/");
            return;
        }

        try
        {
            var entradaEvento = await ApiClient.GetFromJsonAsync<EntradaEventoRespuestaDto>($"api/evento/{EventoId}");
            if(entradaEvento == null)
            {
                error = "No se pudo cargar el evento.";
                return;
            }

            if (entradaEvento.Rol.EsAdministrador)
            {
                evento = entradaEvento.Evento;
                finInscripciones = evento.FechaFinInscripciones.ToDateTime(TimeOnly.MinValue);
                finEntrega = evento.FechaFinEntrega.ToDateTime(TimeOnly.MinValue);
                finVotaciones = evento.FechaFinVotaciones.ToDateTime(TimeOnly.MinValue);
                finExperta = evento.FechaFinEvaluacionExperta.ToDateTime(TimeOnly.MinValue);

                categorias = await ApiClient.GetFromJsonAsync<List<CategoriaDto>>($"api/evento/{EventoId}/categorias");
                faseActual = await ApiClient.GetFromJsonAsync<FaseDto>($"api/administrador/{EventoId}/fase");

                if (faseActual != null)
                {
                    var fase = faseActual.Fase;

                    puedeEditarInscripciones = fase == "Inscripciones";
                    puedeEditarEntrega = fase == "Inscripciones" || fase == "Entregas";
                    puedeEditarVotaciones = fase == "Inscripciones" || fase == "Entregas" ||fase == "Votaciones";
                    puedeEditarExperta = fase != "Resultados";
                }
            }
            else
            {
                error = "No tienes permisos de administrador en este evento.";
            }
            
            
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }

    }

    async Task CargarGrupos(long idCategoria)
    {
        categoriaSeleccionadaId = idCategoria;

        grupos = await ApiClient.GetFromJsonAsync<List<GrupoDto>>
            ($"api/administrador/categoria/{idCategoria}/grupos");

        if (grupos == null)
            return;

        foreach (var g in grupos)
        {
            await CargarParticipantes(g.Id);
        }

        StateHasChanged();
    }
    async Task CargarParticipantes(long idGrupo)
    {
        var participantes = await ApiClient
            .GetFromJsonAsync<List<MiembroGrupoDto>>
            ($"api/administrador/grupo/{idGrupo}/participantes");

        if (participantes == null)
        {
            error = "No se pudieron cargar participantes";
            return;
        }

        var pendientes = await ApiClient
            .GetFromJsonAsync<int>
            ($"api/administrador/grupo/{idGrupo}/pendientes");

        pendientesPorGrupo[idGrupo] = pendientes;

        var grupo = grupos?.FirstOrDefault(g => g.Id == idGrupo);

        if (grupo != null)
        {
            grupo.CorreosParticipantes = participantes
                .Select(p => p.Correo)
                .ToList();

            // Añadir huecos ocupados por pendientes
            for (int i = 0; i < pendientes; i++)
                grupo.CorreosParticipantes.Add("Invitación Pendiente");

            while (grupo.CorreosParticipantes.Count < evento.ParticipantesPorGrupo)
                grupo.CorreosParticipantes.Add("");
        }

        StateHasChanged();
    }
   

    private void EliminarParticipante(GrupoDto grupo, int index)
    {
        if (index >= 0 && index < grupo.CorreosParticipantes.Count)
            grupo.CorreosParticipantes.RemoveAt(index);
    }

    async Task IrAVotacionesCategoria(long idCategoria)
    {
        Nav.NavigateTo($"/eventoadmin/{EventoId}/votaciones/{idCategoria}");
    }

    private void VolverHome()
    {
        Nav.NavigateTo("/home");
    }

    string mensajeError = "";
    bool hayError = false;
    bool guardando = false;

    async Task ActualizarFechas()
    {
        guardando = true;
        hayError = false;
        mensajeError = "";

        try
        {
            var dto = new ActualizarFechasDto
            {
                FechaFinInscripciones = finInscripciones,
                FechaFinEntrega = finEntrega,
                FechaFinVotaciones = finVotaciones,
                FechaFinExperta = finExperta
            };

            var response = await ApiClient.PutAsJsonAsync(
                $"api/administrador/{EventoId}/fechas", dto);

            if (response.IsSuccessStatusCode)
            {
                mensajeError = "Fechas actualizadas correctamente";
                hayError = false;

                //  actualizar estado base
                evento.FechaFinInscripciones = DateOnly.FromDateTime(finInscripciones); 
                evento.FechaFinEntrega = DateOnly.FromDateTime(finEntrega);
                evento.FechaFinVotaciones = DateOnly.FromDateTime(finVotaciones);
                evento.FechaFinEvaluacionExperta = DateOnly.FromDateTime(finExperta);

                hayCambiosFechas = false;
            }
            else
            {
                var json = await response.Content.ReadFromJsonAsync<Dictionary<string, string>>();
                mensajeError = json?["error"] ?? "Error";
                hayError = true;
            }
        }
        catch (Exception ex)
        {
            mensajeError = ex.Message;
            hayError = true;
        }
        finally
        {
            guardando = false;
        }
    }

    void DetectarCambios()
    {
        if (evento == null) return;

        hayCambiosFechas =
            finInscripciones != evento.FechaFinInscripciones.ToDateTime(TimeOnly.MinValue) ||
            finEntrega != evento.FechaFinEntrega.ToDateTime(TimeOnly.MinValue) ||
            finVotaciones != evento.FechaFinVotaciones.ToDateTime(TimeOnly.MinValue) ||
            finExperta != evento.FechaFinEvaluacionExperta.ToDateTime(TimeOnly.MinValue);
    }

    private async Task CrearGrupo()
    {
        if (categoriaSeleccionadaId == null) return;

        var nuevo = new GrupoDto
        {
            Nombre = "Nuevo grupo",
            IdCategoria = categoriaSeleccionadaId.Value,
            CorreosParticipantes = new List<string>()
        };

        var response = await ApiClient.PostAsJsonAsync(
            $"api/administrador/categoria/{categoriaSeleccionadaId}/grupo",
            nuevo);

        if (response.IsSuccessStatusCode)
        {
            await CargarGrupos(categoriaSeleccionadaId.Value);
        }
    }

    private async Task EliminarGrupoUI(long grupoId)
    {
        var confirm = await JS.InvokeAsync<bool>("confirm", "¿Eliminar grupo?");
        if (!confirm) return;

        try
        {
            var response = await ApiClient.DeleteAsync($"api/administrador/grupo/{grupoId}");

            if (response.IsSuccessStatusCode)
            {
                mensajeError = "Grupo eliminado correctamente";
                hayError = false;

                if (categoriaSeleccionadaId != null)
                    await CargarGrupos(categoriaSeleccionadaId.Value);
            }
            else
            {
                var err = await response.Content.ReadFromJsonAsync<ErrorDto>();
                mensajeError = err?.Error ?? "Error al eliminar grupo";
                hayError = true;
            }
        }
        catch (Exception ex)
        {
            mensajeError = ex.Message;
            hayError = true;
        }
    }

    private async Task GuardarNombreGrupo(GrupoDto grupo)
    {
        var response = await ApiClient.PutAsJsonAsync(
            $"api/administrador/grupo/{grupo.Id}",
            grupo
        );

        if (!response.IsSuccessStatusCode)
        {
            var error = await response.Content.ReadFromJsonAsync<ErrorDto>();
            Console.WriteLine(error?.Error);
        }
    }

    private async Task GuardarGrupo(GrupoDto grupo)
    {
        try
        {
            var response = await ApiClient.PutAsJsonAsync(
                $"api/administrador/{EventoId}/grupo/{grupo.Id}/participantes",
                grupo.CorreosParticipantes
            );

            if (!response.IsSuccessStatusCode)
            {
                var errorResp = await response.Content.ReadFromJsonAsync<ErrorDto>();
                mensajeError = errorResp?.Error ?? "Error al guardar participantes";
                hayError = true;
            }
            else
            {
                mensajeError = "Cambios realizados correctamente";
                hayError = false;
                await CargarParticipantes(grupo.Id);  
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            mensajeError = ex.Message;
            hayError = true;
        }
    }

    private void AñadirCampoParticipante(GrupoDto grupo)
    {
        grupo.CorreosParticipantes.Add("");
    }


    private async Task PausarEvento()
    {
        await ApiClient.PutAsync($"api/administrador/{evento.Id}/pausar", null);
        evento.Estado = "Pausado";
    }

    private async Task ReanudarEvento()
    {
        await ApiClient.PutAsync($"api/administrador/{evento.Id}/reanudar", null);
        evento.Estado = "Activo";
    }

    private async Task CerrarEvento()
    {
        var confirm = await JS.InvokeAsync<bool>("confirm", "¿Seguro que quieres cerrar el evento? Esta acción es irreversible");
        if (!confirm) return;

        await ApiClient.PutAsync($"api/administrador/{evento.Id}/cerrar", null);

        // Redirigir porque ya no debería existir
        Nav.NavigateTo("/home");
    }




}