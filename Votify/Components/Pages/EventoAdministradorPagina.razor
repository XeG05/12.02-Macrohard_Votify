@page "/eventoadmin/{EventoId:long}"
@rendermode InteractiveServer
@using Votify.Modelos
@using Votify.Modelos.BusinessLogic.Domain
@using Votify.Modelos.BusinessLogic.Enums
@using Votify.Modelos.BusinessLogic.Services
@inject I_Evento_Service Evento_Service
@inject BlazorAuthStateProvider AuthProvider
@inject NavigationManager Nav

@if (cargando)
{
    <p>Cargando...</p>
}
else if (!string.IsNullOrWhiteSpace(error))
{
    <div style="color:red">@error</div>
}
else
{
    <h2>@eventoAdmin?.Nombre</h2>
    <p>@eventoAdmin?.Descripcion</p>

    <p><b>Fase actual:</b> @eventoAdmin?.ObtenerFaseActual()</p>

    <hr />

    <h3>Categorías</h3>

    @if (categorias == null)
    {
        <p>Cargando...</p>
    }
    else
    {
        <ul>
            @foreach (var c in categorias)
            {
                <li>
                    <b>@c.Nombre</b>
                    <button @onclick="() => CargarGrupos(c.Id)">Ver grupos</button>
                </li>
            }
        </ul>
    }

    @if (grupos != null)
    {
        <h3>Grupos</h3>

        @if (eventoAdmin?.ObtenerFaseActual() == FasesEvento.Inscripciones)
        {
            <div style="margin-bottom:15px;">
                <input @bind="nombreGrupoNuevo" placeholder="Nombre del grupo" />
                <button @onclick="CrearGrupo">Añadir grupo</button>
            </div>
        }

        @foreach (var g in grupos)
        {
            <div style="border:1px solid gray; padding:10px; margin:10px;">
                <b>@g.Nombre</b>

                <button @onclick="() => CargarParticipantes(g.Id)">Ver participantes</button>

                @if (eventoAdmin?.ObtenerFaseActual() == FasesEvento.Inscripciones)
                {
                    <button @onclick="() => EliminarGrupoUI(g.Id)">Eliminar grupo</button>
                }

                @*  PARTICIPANTES *@
                @if (participantesPorGrupo.ContainsKey(g.Id))
                {
                    <ul>
                        @foreach (var p in participantesPorGrupo[g.Id])
                        {
                            <li>@p.Correo</li>
                        }
                    </ul>
                }
            </div>
        }
    }

    <hr />

    <h3>Periodos</h3>

    @if (eventoAdmin != null)
    {
        <ul>
            <li>Fin inscripciones: @eventoAdmin.FechaFinInscripciones.ToString("dd/MM/yyyy")</li>
            <li>Fin entrega proyectos: @eventoAdmin.FechaFinEntrega.ToString("dd/MM/yyyy")</li>
            <li>Fin votaciones: @eventoAdmin.FechaFinVotaciones.ToString("dd/MM/yyyy")</li>
        </ul>
    }

    <hr />

    <h3>Configuración</h3>

    @if (eventoAdmin != null)
    {
        <ul>
            <li>Tiene grupos: @(eventoAdmin.TieneGrupos ? "Sí" : "No")</li>
            <li>Grupos completos: @(eventoAdmin.GruposCompletos ? "Sí" : "No")</li>
            <li>Participantes por grupo: @eventoAdmin.ParticipantesPorGrupo</li>
        </ul>
    }
}

@code {
    [Parameter] public long EventoId { get; set; }

    List<Categorium>? categorias;
    List<Grupo>? grupos;

    Dictionary<long, List<Participante>> participantesPorGrupo = new();

    Dictionary<long, string> nuevoCorreoPorGrupo = new();

    EventoAdministrador? eventoAdmin;

    string nombreGrupoNuevo = "";

    public long? categoriaSeleccionadaId;
    bool cargando = true;
    string error = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var correo = AuthProvider.ObtenerCorreo();
        if (string.IsNullOrWhiteSpace(correo) || !AuthProvider.EstaAutenticado)
        {
            // usuario no autenticado, volver al login
            Nav.NavigateTo("/");
            return;
        }

        try
        {
            var entradaEvento = await Evento_Service.EntrarEvento(correo, EventoId);

            if (entradaEvento.Evento is EventoAdministrador admin)
            {
                eventoAdmin = admin;
                categorias = await eventoAdmin.VerCategoria();
            }
            else
            {
                error = "No tienes permisos de administrador en este evento.";
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }

    } //NO FUNCIONA

    protected override async Task OnInitializedAsync()
    {

        
    }

    async Task CargarGrupos(long idCategoria)
    {
        if (eventoAdmin != null)
        {
            categoriaSeleccionadaId = idCategoria;
            grupos = await eventoAdmin.VerGrupo(idCategoria);

            foreach (var g in grupos)
            {
                if (!nuevoCorreoPorGrupo.ContainsKey(g.Id))
                    nuevoCorreoPorGrupo[g.Id] = "";
            }
        }
    }

    async Task CargarParticipantes(long idGrupo)
    {
        if (eventoAdmin != null)
        {
            var participantes = await eventoAdmin.VerParticipantes(idGrupo);
            participantesPorGrupo[idGrupo] = participantes;
        }
    }

    async Task CrearGrupo()
    {
        if (eventoAdmin != null && !string.IsNullOrWhiteSpace(nombreGrupoNuevo) && categoriaSeleccionadaId != null
        && categoriaSeleccionadaId is long idCat)
        {
            await eventoAdmin.AñadirGrupo(nombreGrupoNuevo, idCat);
            nombreGrupoNuevo = "";
            grupos = await eventoAdmin.VerGrupo(idCat);
        }
    }

    async Task EliminarGrupoUI(long idGrupo)
    {
        if (eventoAdmin != null)
        {
            await eventoAdmin.EliminarGrupo(idGrupo);
            grupos = null;
        }
    }
    
