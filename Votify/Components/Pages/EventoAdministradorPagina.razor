@page "/eventoadmin/{EventoId:long}"
@rendermode InteractiveServer

@inject HttpClient Http
@inject IEventoService Evento_Service
@inject EventoAdministradorService EventoAdministradorService
@inject BlazorAuthStateProvider AuthProvider
@inject NavigationManager Nav
@inject IHttpClientFactory HttpFactory

@if (cargando)
{
    <p>Cargando...</p>
}
else if (!string.IsNullOrWhiteSpace(error))
{
    <div style="color:red">@error</div>
}
else
{
    <div style="background: linear-gradient(90deg,#0f172a,#1e293b); color:white; padding:25px; border-radius:20px; margin-bottom:20px;">

        <button @onclick="VolverHome"
                style="background:none;border:none;color:#9ca3af;cursor:pointer;">
            ← Volver
        </button>

        <h1 style="margin:10px 0;">@evento?.Nombre</h1>
        <p style="color:#cbd5f5;">@evento?.Descripcion</p>

        <span style="background:#f59e0b; padding:5px 10px; border-radius:10px;">
            Admin
        </span>

    </div>

    @if (categorias == null)
    {
        <p>Cargando...</p>
    }
    else
    {
        <ul>
            @foreach (var c in categorias)
            {
                <div style="border:1px solid #e5e7eb; border-radius:15px; padding:15px; margin-bottom:10px; display:flex; justify-content:space-between; align-items:center;">

                    <div>
                        <b>@c.Nombre</b>
                    </div>

                    <div style="display:flex; gap:10px;">
                        <button @onclick="() => CargarGrupos(c.Id)">
                            Ver grupos
                        </button>

                        <button @onclick="() => IrAVotacionesCategoria(c.Id)"
                                style="background:#2563eb;color:white;border:none;padding:6px 12px;border-radius:8px;">
                            Ver votaciones
                        </button>
                    </div>

                </div>
            }
        </ul>
    }

    @if (grupos != null)
    {
        <h3>Grupos</h3>

        /*@if (eventoAdmin?.ObtenerFaseActual() == FasesEvento.Inscripciones)
        {
            <div style="margin-bottom:15px;">
                <input @bind="nombreGrupoNuevo" placeholder="Nombre del grupo" />
                <button @onclick="CrearGrupo">Añadir grupo</button>
            </div>
        }*/ //BOTÓN DE AÑADIR GRUPOS, PARA EL SPRINT 2

        @foreach (var g in grupos)
        {
            <div style="border:1px solid gray; padding:10px; margin:10px;">
                <b>@g.Nombre</b>

                <button @onclick="() => CargarParticipantes(g.Id)">Ver participantes</button>

                @if (EventoAdministradorService.ObtenerFaseActual(EventoId) == FasesEvento.Inscripciones)
                {
                    <button @onclick="() => EliminarGrupoUI(g.Id)">Eliminar grupo</button>
                }

                @*  PARTICIPANTES *@
                @if (participantesPorGrupo.ContainsKey(g.Id))
                {
                    var lista = participantesPorGrupo[g.Id];

                    if (lista == null || lista.Count == 0)
                    {
                        <p style="color:#9ca3af; font-style:italic;">
                             En espera de que los participantes acepten la invitación
                        </p>
                    }
                    else
                    {
                        <ul>
                            @foreach (var p in lista)
                            {
                                <li>@p.Correo</li>
                            }
                        </ul>
                    }
                }
            </div>
        }
    }

    <hr />

    <h3>Periodos</h3>

    @if (evento != null)
    {
        <ul>
            <li>Fin inscripciones: @evento.FechaFinInscripciones.ToString("dd/MM/yyyy")</li>
            <li>Fin entrega proyectos: @evento.FechaFinEntrega.ToString("dd/MM/yyyy")</li>
            <li>Fin votaciones: @evento.FechaFinVotaciones.ToString("dd/MM/yyyy")</li>
        </ul>
    }

    <hr />

    <h3>Configuración</h3>

    @if (evento != null)
    {
        <ul>
            <li>Tiene grupos: @(evento.TieneGrupos ? "Sí" : "No")</li>
            <li>Grupos completos: @(evento.GruposCompletos ? "Sí" : "No")</li>
            <li>Participantes por grupo: @evento.ParticipantesPorGrupo</li>
        </ul>
    }
}

@code {
    [Parameter] public long EventoId { get; set; }

    List<Categorium>? categorias;
    List<Grupo>? grupos;

    Dictionary<long, List<Participante>> participantesPorGrupo = new();

    Dictionary<long, string> nuevoCorreoPorGrupo = new();

    Evento evento;

    string nombreGrupoNuevo = "";

    public long? categoriaSeleccionadaId;
    bool cargando = true;
    string error = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var correo = AuthProvider.ObtenerCorreo();
        if (string.IsNullOrWhiteSpace(correo) || !AuthProvider.EstaAutenticado)
        {
            // usuario no autenticado, volver al login
            Nav.NavigateTo("/");
            return;
        }

        try
        {
            var entradaEvento = await Evento_Service.EntrarEvento(correo, EventoId); //NO HTTP
            
            /*var token = await AuthProvider.ObtenerToken();
            var Http = HttpFactory.CreateClient("API");
            Http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            var entradaEvento = await Http.GetFromJsonAsync<EntradaEventoDto>(
                $"{Nav.BaseUri}api/evento/{EventoId}");*/

            if (entradaEvento.TipoRol.Administrador != null)
            {
                evento = entradaEvento.Evento;
                categorias = await EventoAdministradorService.VerCategorias(EventoId);
            }
            else
            {
                error = "No tienes permisos de administrador en este evento.";
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }

    }

    async Task CargarGrupos(long idCategoria)
    {
        if (evento != null)
        {
            categoriaSeleccionadaId = idCategoria;
            grupos = await EventoAdministradorService.VerGrupo(idCategoria);

            foreach (var g in grupos)
            {
                if (!nuevoCorreoPorGrupo.ContainsKey(g.Id))
                    nuevoCorreoPorGrupo[g.Id] = "";
            }
        }
    }

    async Task CargarParticipantes(long idGrupo)
    {
        if (evento != null)
        {
            var participantes = await EventoAdministradorService.VerParticipantes(idGrupo);
            participantesPorGrupo[idGrupo] = participantes;
        }
    }

    async Task IrAVotacionesCategoria(long idCategoria)
    {
        Nav.NavigateTo($"/eventoadmin/{EventoId}/votaciones/{idCategoria}");
    }

    private void VolverHome()
    {
        Nav.NavigateTo("/home");
    }

    async Task CrearGrupo() //SPRINT 2
    {
        if (evento != null && !string.IsNullOrWhiteSpace(nombreGrupoNuevo) && categoriaSeleccionadaId != null
        && categoriaSeleccionadaId is long idCat)
        {
            await EventoAdministradorService.AñadirGrupo(nombreGrupoNuevo, idCat, EventoId);
            nombreGrupoNuevo = "";
            grupos = await EventoAdministradorService.VerGrupo(idCat);
        }
    }

    async Task EliminarGrupoUI(long idGrupo) //SPRINT 2
    {
        if (evento != null)
        {
            await EventoAdministradorService.EliminarGrupo(EventoId, idGrupo);
            grupos = null;
        }
    }
    
    /*
    async Task AñadirParticipanteUI(long idGrupo)
    {
        if (eventoAdmin != null && !string.IsNullOrWhiteSpace(nuevoCorreoPorGrupo[idGrupo]))
        {
            await eventoAdmin.AñadirParticipante(nuevoCorreoPorGrupo[idGrupo], idGrupo);

            var participantes = await eventoAdmin.VerParticipantes(idGrupo);
            participantesPorGrupo[idGrupo] = participantes;

            nuevoCorreoPorGrupo[idGrupo] = "";
        }
    }
    async Task EliminarParticipanteUI(long idParticipante)
    {
        if (eventoAdmin != null)
        {
            await eventoAdmin.EliminarParticipante(idParticipante);

            // recargar TODOS los grupos visibles
            foreach (var g in grupos!)
            {
                var participantes = await eventoAdmin.VerParticipantes(g.Id);
                participantesPorGrupo[g.Id] = participantes;
            }
        }
    }*/ //PARA EL SPRINT 2

}