@page "/eventoparticipante/{EventoId:long}/{GrupoId:long?}"
@rendermode InteractiveServer
@inject ApiClient ApiClient
@inject NavigationManager Nav
@inject BlazorAuthStateProvider AuthProvider

@if (cargando)
{
    <div class="epp-loading-state">
        <div class="epp-spinner"></div>
        <p>Cargando vista del participante...</p>
    </div>
}
else if (!string.IsNullOrWhiteSpace(error))
{
    <div class="epp-wrapper">
        <div class="epp-alert epp-alert-error">@error</div>
    </div>
}
else if (evento is null)
{
    <div class="epp-wrapper">
        <div class="epp-alert epp-alert-error">No se ha podido cargar el evento del participante.</div>
    </div>
}
else
{
    <div class="epp-wrapper">
        <div class="epp-hero">
            <div class="epp-hero-content">
                <div class="epp-breadcrumb" @onclick="VolverHome">← Volver al home</div>

                <div class="epp-hero-top">
                    <div>
                        <div class="epp-eyebrow">Panel de participante</div>
                        <h1>@evento.Nombre</h1>
                        <p>@evento.Descripcion</p>
                    </div>

                    <div class="epp-hero-side">
                        <span class="epp-role-badge">Participante</span>

                        <span class="epp-status-badge @(tieneProyecto ? "is-ok" : "is-pending")">
                            @(tieneProyecto ? "Proyecto entregado" : "Entrega disponible")
                        </span>

                        <span class="epp-phase-pill @GetFaseClass(evento)">@GetFaseLabel(evento)</span>
                    </div>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(mensaje))
        {
            <div class="epp-alert epp-alert-ok">@mensaje</div>
        }

        <div class="epp-main-grid">
            <section class="epp-panel epp-group-panel">
                <div class="epp-panel-header">
                    <div>
                        <span class="epp-panel-kicker">Tu equipo</span>
                        <h2>@nombreGrupo</h2>
                        <span style="font-size: 0.9em; color: var(--text-2); display: block; margin-top: 4px;">📂 Categoría: <strong>@nombreCategoria</strong></span>
                    </div>
                    <span class="epp-count-badge">@miembrosGrupo.Count</span>
                </div>

                @if (miembrosGrupo.Count == 0)
                {
                    <div class="epp-empty-state">
                        <span class="epp-empty-icon">👥</span>
                        <p>No hay participantes cargados en el grupo.</p>
                    </div>
                }
                else
                {
                    <div class="epp-members-list">
                        @foreach (var miembro in miembrosGrupo)
                        {
                            <div class="epp-member-card">
                                <div class="epp-member-avatar">
                                    @ObtenerIniciales(miembro.Nombre)
                                </div>
                                <div class="epp-member-info">
                                    <strong>@miembro.Nombre</strong>
                                    <span>@miembro.Correo</span>
                                </div>
                            </div>
                        }
                    </div>
                }
            </section>

            <section class="epp-panel epp-status-panel">
                <div class="epp-panel-header">
                    <div>
                        <span class="epp-panel-kicker">Estado</span>
                        <h2>Resumen rápido</h2>
                    </div>
                </div>

                <div class="epp-status-card @(tieneProyecto ? "is-ok" : "is-pending")">
                    <div class="epp-status-icon">@(tieneProyecto ? "✅" : "⏳")</div>
                    <div>
                        <strong>@(tieneProyecto ? "Entrega completada" : "Entrega pendiente")</strong>
                        <p>
                            @(tieneProyecto
                                                    ? "Tu grupo ya tiene un proyecto entregado para este evento."
                                                    : "Todavía no has entregado ningún proyecto.")
                        </p>
                    </div>
                </div>

                <div class="epp-tip-box">
                    <strong>Siguiente paso</strong>
                    <p>
                        @if (EsFaseInscripcion())
                        {
                            <text>La fase de inscripciones está abierta. Espera a la fase de entregas para poder subir tu proyecto.</text>
                        }
                        else if (EsFaseEntrega())
                        {
                            @(tieneProyecto
                                ? "Tu proyecto ha sido entregado. Puedes eliminar la entrega si necesitas volver a subir una nueva versión."
                                : "Sube el proyecto para dejar registrada la propuesta de tu grupo antes de la fecha límite.")
                        }
                        else if (EsFaseVotacion())
                        {
                            @(tieneProyecto
                                ? "Tu proyecto ha sido entregado y está siendo evaluado por los votantes."
                                : "El plazo de entrega se cerró y tu grupo no ha entregado ningún proyecto.")
                        }
                        else
                        {
                            <text>El evento ha finalizado. Consulta los resultados finales desde tu dashboard.</text>
                        }
                    </p>
                </div>
            </section>
        </div>

        <section class="epp-actions-section">
            <div class="epp-section-header">
                <div class="epp-section-indicator"></div>
                <h2>Acciones del evento</h2>
            </div>

            <div class="epp-actions-grid">
                <button class="epp-action-card epp-action-primary"
                        @onclick="IrAPresentarProyecto"
                        disabled="@(tieneProyecto || !EsFaseEntrega())"
                        title="@(tieneProyecto ? "Ya has entregado un proyecto" : (!EsFaseEntrega() ? "El plazo de entrega de proyectos no está abierto" : "Subir proyecto"))">
                    <div class="epp-action-icon">📤</div>
                    <div class="epp-action-text">
                        <strong>@(tieneProyecto ? "Proyecto entregado" : "Subir proyecto")</strong>
                        <span>
                            @(tieneProyecto
                                                    ? "Ya existe una entrega registrada para tu grupo."
                                                    : "Completa el formulario y adjunta el material de tu proyecto.")
                        </span>
                    </div>
                </button>

                <button class="epp-action-card epp-action-danger"
                        @onclick="EliminarProyecto"
                        disabled="@(!tieneProyecto || !EsFaseEntrega())"
                        title="@(!EsFaseEntrega() ? "El plazo de entrega de proyectos no está abierto" : "")">
                    <div class="epp-action-icon">🗑️</div>
                    <div class="epp-action-text">
                        <strong>Eliminar proyecto</strong>
                        <span>Quita la entrega actual para poder volver a presentarla.</span>
                    </div>
                </button>

                <button class="epp-action-card"
                        @onclick="IrADashboard"
                        disabled="@(!EsFaseFinalizada())"
                        title="@(!EsFaseFinalizada() ? "El dashboard estará disponible al finalizar el evento" : "Ver dashboard")">
                    <div class="epp-action-icon">📊</div>
                    <div class="epp-action-text">
                        <strong>Ver dashboard</strong>
                        <span>Consulta métricas, evolución y resultados del evento.</span>
                    </div>
                </button>

                <button class="epp-action-card"
                        @onclick="IrAListaProyectos"
                        disabled="@(EsFaseInscripcion() || EsFaseEntrega())"
                        title="@((EsFaseInscripcion() || EsFaseEntrega()) ? "Los proyectos no están visibles hasta la fase de votación" : "Ver proyectos")">
                    <div class="epp-action-icon">📋</div>
                    <div class="epp-action-text">
                        <strong>Lista de proyectos</strong>
                        <span>Explora las propuestas presentadas dentro del evento.</span>
                    </div>
                </button>
            </div>
        </section>
    </div>
}

@code {
    [Parameter] public long EventoId { get; set; }
    [Parameter] public long? GrupoId { get; set; }

    private string? correo = "";
    private EventoDto? evento;
    private GrupoDto? grupoActual;
    private bool cargando = true;
    private string? error;
    private string? mensaje;
    private bool tieneProyecto;

    private string nombreGrupo = "Grupo";
    private string nombreCategoria = "Sin categoría";
    private List<MiembroGrupoDto> miembrosGrupo = new();

    private record TieneProyectoResponse(bool TieneProyecto);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        correo = AuthProvider.ObtenerCorreo();
        if (string.IsNullOrWhiteSpace(correo) || !AuthProvider.EstaAutenticado)
        {
            Nav.NavigateTo("/login");
            return;
        }

        try
        {
            var entradaEvento = await ApiClient.GetFromJsonAsync<EntradaEventoRespuestaDto>($"api/evento/{EventoId}");
            if(entradaEvento == null)
            {
                error = "No se ha podido cargar el evento.";
                return;
            }
            if (entradaEvento.Rol.EsParticipante)
            {
                evento = entradaEvento.Evento;
            }

            if (evento == null)
            {
                error = "No se ha podido cargar el evento como participante.";
                return;
            }

            // Se agrega el query param solo si GrupoId tiene valor, para mantener compatibilidad con endpoints que lo aceptan de forma opcional
            var grupoQuery = GrupoId.HasValue ? $"?grupoId={GrupoId}" : ""; 

            var grupo = await ApiClient.GetFromJsonAsync<GrupoDto>($"api/participante/{EventoId}/mi-grupo{grupoQuery}");
            grupoActual = grupo;
            nombreGrupo = grupo?.Nombre ?? "Grupo sin nombre";

            var categoria = await ApiClient.GetFromJsonAsync<CategoriaDto>($"api/participante/{EventoId}/mi-categoria{grupoQuery}");
            nombreCategoria = categoria?.Nombre ?? "Sin categoría";

            miembrosGrupo = await ApiClient.GetFromJsonAsync<List<MiembroGrupoDto>>($"api/participante/{EventoId}/miembros-grupo{grupoQuery}") ?? new();

            var tpResp = await ApiClient.GetFromJsonAsync<TieneProyectoResponse>($"api/participante/{EventoId}/tiene-proyecto{grupoQuery}");
            tieneProyecto = tpResp?.TieneProyecto ?? false;
        }
        catch (HttpRequestException ex)
        {
            error = $"Error en la solicitud: {ex.Message}";
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private void VolverHome()
    {
        Nav.NavigateTo("/home");
    }

    private void IrAPresentarProyecto()
    {
        if (tieneProyecto)
        {
            mensaje = "Ya tienes un proyecto entregado para este evento.";
            return;
        }

        if (GrupoId != null)
            Nav.NavigateTo($"/eventoparticipantepresentar/{EventoId}/{GrupoId}");
        else
            Nav.NavigateTo($"/eventoparticipantepresentar/{EventoId}");
    }

    private void IrAListaProyectos()
    {
        Nav.NavigateTo($"/listaproyectos/{EventoId}");
    }

    private void IrADashboard()
    {
        if (grupoActual == null)
        {
            error = "No estás en ningún grupo.";
            return;
        }
        Nav.NavigateTo($"/dashboard/{EventoId}/{grupoActual.IdCategoria}");
    }

    private async Task EliminarProyecto()
    {
        mensaje = null;
        error = null;

        try
        {
            var grupoQuery = GrupoId.HasValue ? $"?grupoId={GrupoId}" : "";
            var response = await ApiClient.DeleteAsync($"api/participante/{EventoId}/proyecto{grupoQuery}");

            if (response.IsSuccessStatusCode)
            {
                tieneProyecto = false;
                mensaje = "Proyecto eliminado correctamente.";
            }
            else
            {
                error = "No se pudo eliminar el proyecto.";
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            StateHasChanged();
        }
    }

    private string ObtenerIniciales(string? nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre))
            return "?";

        var partes = nombre
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(p => char.ToUpperInvariant(p[0]));

        return string.Concat(partes);
    }

    private string GetFaseLabel(EventoDto ev)
    {
        var hoy = DateOnly.FromDateTime(DateTime.Now);
        if (hoy <= ev.FechaFinInscripciones) return "En fase de inscripción";
        if (hoy <= ev.FechaFinEntrega)        return "En fase de entrega";
        if (hoy <= ev.FechaFinVotaciones)     return "En fase de votación";
        return "Finalizado";
    }

    private string GetFaseClass(EventoDto ev)
    {
        var hoy = DateOnly.FromDateTime(DateTime.Now);
        if (hoy <= ev.FechaFinInscripciones) return "fase-inscripciones";
        if (hoy <= ev.FechaFinEntrega)        return "fase-entregas";
        if (hoy <= ev.FechaFinVotaciones)     return "fase-votaciones";
        return "fase-finalizado";
    }

    private bool EsFaseInscripcion()
    {
        if (evento == null) return false;
        var hoy = DateOnly.FromDateTime(DateTime.Now);
        return hoy <= evento.FechaFinInscripciones;
    }

    private bool EsFaseEntrega()
    {
        if (evento == null) return false;
        var hoy = DateOnly.FromDateTime(DateTime.Now);
        return hoy > evento.FechaFinInscripciones && hoy <= evento.FechaFinEntrega;
    }

    private bool EsFaseVotacion()
    {
        if (evento == null) return false;
        var hoy = DateOnly.FromDateTime(DateTime.Now);
        return hoy > evento.FechaFinEntrega && hoy <= evento.FechaFinVotaciones;
    }

    private bool EsFaseFinalizada()
    {
        if (evento == null) return false;
        var hoy = DateOnly.FromDateTime(DateTime.Now);
        return hoy > evento.FechaFinVotaciones;
    }
}