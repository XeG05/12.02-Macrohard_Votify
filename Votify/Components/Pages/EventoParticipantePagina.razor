@page "/eventoparticipante/{EventoId:long}"
@rendermode InteractiveServer
@using Votify.Modelos
@using Votify.Modelos.BusinessLogic.Domain
@using Votify.Modelos.BusinessLogic.Services
@inject I_Evento_Service Evento_Service
@inject EventoContextService EventoCtx
@inject NavigationManager Nav
@inject BlazorAuthStateProvider AuthProvider

@if (cargando)
{
    <div class="epp-loading-state">
        <div class="epp-spinner"></div>
        <p>Cargando vista del participante...</p>
    </div>
}
else if (!string.IsNullOrWhiteSpace(error))
{
    <div class="epp-wrapper">
        <div class="epp-alert epp-alert-error">@error</div>
    </div>
}
else if (eventoParticipante is null)
{
    <div class="epp-wrapper">
        <div class="epp-alert epp-alert-error">No se ha podido cargar el evento del participante.</div>
    </div>
}
else
{
    <div class="epp-wrapper">
        <div class="epp-hero">
            <div class="epp-hero-content">
                <div class="epp-breadcrumb" @onclick="VolverHome">← Volver al home</div>

                <div class="epp-hero-top">
                    <div>
                        <div class="epp-eyebrow">Panel de participante</div>
                        <h1>@eventoParticipante.Nombre</h1>
                        <p>Gestiona tu proyecto, revisa tu grupo y accede a las opciones del evento desde un único sitio.</p>
                    </div>

                    <div class="epp-hero-side">
                        <span class="epp-role-badge">Participante</span>
                        <span class="epp-phase-pill @GetFaseClass(eventoParticipante)">@GetFaseLabel(eventoParticipante)</span>

                        <span class="epp-status-badge @(tieneProyecto ? "is-ok" : "is-pending")">
                            @(tieneProyecto ? "Proyecto entregado" : "Pendiente de entrega")
                        </span>
                    </div>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(mensaje))
        {
            <div class="epp-alert epp-alert-ok">@mensaje</div>
        }

        <div class="epp-main-grid">
            <section class="epp-panel epp-group-panel">
                <div class="epp-panel-header">
                    <div>
                        <span class="epp-panel-kicker">Tu equipo</span>
                        <h2>@nombreGrupo</h2>
                    </div>
                    <span class="epp-count-badge">@miembrosGrupo.Count</span>
                </div>

                @if (miembrosGrupo.Count == 0)
                {
                    <div class="epp-empty-state">
                        <span class="epp-empty-icon">👥</span>
                        <p>No hay participantes cargados en el grupo.</p>
                    </div>
                }
                else
                {
                    <div class="epp-members-list">
                        @foreach (var miembro in miembrosGrupo)
                        {
                            <div class="epp-member-card">
                                <div class="epp-member-avatar">
                                    @ObtenerIniciales(miembro.Nombre)
                                </div>
                                <div class="epp-member-info">
                                    <strong>@miembro.Nombre</strong>
                                    <span>@miembro.Correo</span>
                                </div>
                            </div>
                        }
                    </div>
                }
            </section>

            <section class="epp-panel epp-status-panel">
                <div class="epp-panel-header">
                    <div>
                        <span class="epp-panel-kicker">Estado</span>
                        <h2>Resumen rápido</h2>
                    </div>
                </div>

                <div class="epp-status-card @(tieneProyecto ? "is-ok" : "is-pending")">
                    <div class="epp-status-icon">@(tieneProyecto ? "✅" : "⏳")</div>
                    <div>
                        <strong>@(tieneProyecto ? "Entrega completada" : "Entrega pendiente")</strong>
                        <p>
                            @(tieneProyecto
                                                    ? "Tu grupo ya tiene un proyecto entregado para este evento."
                                                    : "Todavía no has entregado ningún proyecto.")
                        </p>
                    </div>
                </div>

                <div class="epp-tip-box">
                    <strong>Siguiente paso</strong>
                    <p>
                        @(tieneProyecto
                                            ? "Puedes eliminar la entrega si necesitas volver a subir una nueva versión."
                                            : "Sube el proyecto para dejar registrada la propuesta de tu grupo.")
                    </p>
                </div>
            </section>
        </div>

        <section class="epp-actions-section">
            <div class="epp-section-header">
                <div class="epp-section-indicator"></div>
                <h2>Acciones del evento</h2>
            </div>

            <div class="epp-actions-grid">
                <button class="epp-action-card epp-action-primary"
                        @onclick="IrAPresentarProyecto"
                        disabled="@tieneProyecto"
                        title="@(tieneProyecto ? "Ya has entregado un proyecto" : "Subir proyecto")">
                    <div class="epp-action-icon">📤</div>
                    <div class="epp-action-text">
                        <strong>@(tieneProyecto ? "Proyecto entregado" : "Subir proyecto")</strong>
                        <span>
                            @(tieneProyecto
                                                    ? "Ya existe una entrega registrada para tu grupo."
                                                    : "Completa el formulario y adjunta el material de tu proyecto.")
                        </span>
                    </div>
                </button>

                <button class="epp-action-card epp-action-danger"
                        @onclick="EliminarProyecto"
                        disabled="@(!tieneProyecto)">
                    <div class="epp-action-icon">🗑️</div>
                    <div class="epp-action-text">
                        <strong>Eliminar proyecto</strong>
                        <span>Quita la entrega actual para poder volver a presentarla.</span>
                    </div>
                </button>

                <button class="epp-action-card"
                        disabled
                        title="Pendiente de implementar">
                    <div class="epp-action-icon">📊</div>
                    <div class="epp-action-text">
                        <strong>Ver dashboard</strong>
                        <span>Consulta métricas, evolución y resultados del evento.</span>
                    </div>
                </button>

                <button class="epp-action-card"
                        disabled
                        title="Pendiente de implementar">
                    <div class="epp-action-icon">📋</div>
                    <div class="epp-action-text">
                        <strong>Lista de proyectos</strong>
                        <span>Explora las propuestas presentadas dentro del evento.</span>
                    </div>
                </button>
            </div>
        </section>
    </div>
}

@code {
    [Parameter] public long EventoId { get; set; }

    private EventoParticipante? eventoParticipante;
    private bool cargando = true;
    private string? error;
    private string? mensaje;
    private bool tieneProyecto;

    private string nombreGrupo = "Grupo";
    private List<(string Nombre, string Correo)> miembrosGrupo = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var correo = AuthProvider.ObtenerCorreo();
        if (string.IsNullOrWhiteSpace(correo) || !AuthProvider.EstaAutenticado)
        {
            Nav.NavigateTo("/login");
            return;
        }

        try
        {
            var entradaEvento = await Evento_Service.EntrarEvento(correo, EventoId);

            if (entradaEvento.Evento is EventoParticipante participante)
            {
                eventoParticipante = participante;
            }

            if (eventoParticipante == null)
            {
                error = "No se ha podido cargar el evento como participante.";
                return;
            }

            try { EventoCtx.EstablecerEvento(entradaEvento.Evento, "PARTICIPANTE", EventoId); } catch { }

            var grupo = await eventoParticipante.ObtenerMiGrupo();
            nombreGrupo = grupo?.Nombre ?? "Grupo sin nombre";

            miembrosGrupo = await eventoParticipante.ObtenerMiembrosGrupo();
            tieneProyecto = await eventoParticipante.TieneProyecto();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private void VolverHome()
    {
        Nav.NavigateTo("/home");
    }

    private void IrAPresentarProyecto()
    {
        if (tieneProyecto)
        {
            mensaje = "Ya tienes un proyecto entregado para este evento.";
            return;
        }

        Nav.NavigateTo($"/eventoparticipantepresentar/{EventoId}");
    }

    private async Task EliminarProyecto()
    {
        mensaje = null;
        error = null;

        try
        {
            if (eventoParticipante == null)
                return;

            await eventoParticipante.EliminarProyecto();
            tieneProyecto = false;
            mensaje = "Proyecto eliminado correctamente.";
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private string ObtenerIniciales(string? nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre))
            return "?";

        var partes = nombre
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(p => char.ToUpperInvariant(p[0]));

        return string.Concat(partes);
    }

    private string GetFaseLabel(EventoBase ev)
    {
        var hoy = DateOnly.FromDateTime(DateTime.Now);
        if (hoy <= ev.FechaFinInscripciones) return "Inscripciones";
        if (hoy <= ev.FechaFinVotaciones) return "Votaciones";
        return "Finalizado";
    }

    private string GetFaseClass(EventoBase ev)
    {
        var hoy = DateOnly.FromDateTime(DateTime.Now);
        if (hoy <= ev.FechaFinInscripciones) return "fase-inscripciones";
        if (hoy <= ev.FechaFinVotaciones) return "fase-votaciones";
        return "fase-finalizado";
    }
}