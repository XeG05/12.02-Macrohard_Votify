@page "/eventoparticipante"
@rendermode InteractiveServer
@using Votify.Modelos
@using Votify.Modelos.BusinessLogic.Domain
@using Votify.Modelos.BusinessLogic.Services
@inject I_Evento_Service Evento_Service
@inject EventoContextService EventoCtx
@inject NavigationManager Nav

@if (cargando)
{
    <p>Cargando vista del participante...</p>
}
else if (!string.IsNullOrWhiteSpace(error))
{
    <div class="vp-alert vp-alert-error">@error</div>
}
else if (eventoParticipante is null)
{
    <div class="vp-alert vp-alert-error">No se ha podido cargar el evento del participante.</div>
}
else
{
    <div class="vp-wrapper">
        <div class="vp-header">
            <button class="vp-home-btn" @onclick="VolverHome">🏠</button>
            <h1>@eventoParticipante.Nombre</h1>
            <div class="vp-logo">V</div>
        </div>

        <div class="vp-toolbar">
            <button class="vp-back-btn" @onclick="VolverAtras">←</button>
        </div>

        <div class="vp-card">
            <h3>@nombreGrupo</h3>

            @if (miembrosGrupo.Count == 0)
            {
                <p>No hay participantes cargados en el grupo.</p>
            }
            else
            {
                <table class="vp-table">
                    <tbody>
                        @foreach (var miembro in miembrosGrupo)
                        {
                            <tr>
                                <td>@miembro.Nombre</td>
                                <td>@miembro.Correo</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(mensaje))
        {
            <div class="vp-alert vp-alert-ok">@mensaje</div>
        }

        <div class="vp-grid">
            <button class="vp-action" @onclick="IrAPresentarProyecto">
                <span class="vp-icon">📤</span>
                <span>Subir proyecto</span>
            </button>

            <button class="vp-action vp-danger" @onclick="EliminarProyecto" disabled="@(!tieneProyecto)">
                <span class="vp-icon">🗑️</span>
                <span>Eliminar proyecto</span>
            </button>

            <button class="vp-action" disabled title="Pendiente de implementar">
                <span class="vp-icon">📊</span>
                <span>Ver dashboard</span>
            </button>

            <button class="vp-action" disabled title="Pendiente de implementar">
                <span class="vp-icon">📋</span>
                <span>Lista de proyectos</span>
            </button>
        </div>

        <div class="vp-foot-note">
            @if (tieneProyecto)
            {
                <p><strong>Estado actual:</strong> ya tienes un proyecto entregado para este evento.</p>
            }
            else
            {
                <p><strong>Estado actual:</strong> todavía no has entregado ningún proyecto.</p>
            }
        </div>
    </div>
}

@code {
    [Parameter] public long EventoId { get; set; }

    private EventoParticipante? eventoParticipante;
    private bool cargando = true;
    private string? error;
    private string? mensaje;
    private bool tieneProyecto;

    private string nombreGrupo = "Grupo";
    private List<(string Nombre, string Correo)> miembrosGrupo = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            eventoParticipante = EventoCtx.EventoActual as EventoParticipante;

            if (eventoParticipante == null)
            {
                error = "No hay contexto de participante cargado para este evento.";
                return;
            }

            var grupo = await eventoParticipante.ObtenerMiGrupo();
            nombreGrupo = grupo?.Nombre ?? "Grupo sin nombre";

            miembrosGrupo = await eventoParticipante.ObtenerMiembrosGrupo();
            tieneProyecto = await eventoParticipante.TieneProyecto();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    private void VolverHome()
    {
        Nav.NavigateTo("/");
    }

    private void VolverAtras()
    {
        Nav.NavigateTo("/");
    }

    private void IrAPresentarProyecto()
    {
        Nav.NavigateTo($"/evento/{EventoId}/participante/presentar");
    }

    private async Task EliminarProyecto()
    {
        mensaje = null;
        error = null;

        try
        {
            if (eventoParticipante == null)
                return;

            await eventoParticipante.EliminarProyecto();
            tieneProyecto = false;
            mensaje = "Proyecto eliminado correctamente.";
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }
}

<style>
    .vp-wrapper {
        max-width: 1100px;
        margin: 0 auto;
        padding: 24px;
        font-family: Arial, Helvetica, sans-serif;
    }

    .vp-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid #d9d9d9;
        padding-bottom: 18px;
        margin-bottom: 18px;
    }

        .vp-header h1 {
            margin: 0;
            font-size: 2.2rem;
            font-weight: 600;
            text-align: center;
            flex: 1;
        }

    .vp-logo {
        font-size: 2.5rem;
        font-weight: 800;
        min-width: 40px;
        text-align: right;
    }

    .vp-home-btn,
    .vp-back-btn {
        border: 1px solid #cfcfcf;
        background: white;
        border-radius: 10px;
        padding: 10px 14px;
        font-size: 1.4rem;
        cursor: pointer;
    }

    .vp-toolbar {
        margin-bottom: 20px;
    }

    .vp-card {
        border: 1px solid #d9d9d9;
        border-radius: 14px;
        padding: 20px;
        margin-bottom: 22px;
        background: #fff;
    }

        .vp-card h3 {
            margin-top: 0;
            margin-bottom: 14px;
            font-size: 1.5rem;
        }

    .vp-table {
        width: 100%;
        border-collapse: collapse;
    }

        .vp-table td {
            padding: 10px 6px;
            border-top: 1px solid #ececec;
        }

    .vp-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(260px, 1fr));
        gap: 18px;
    }

    .vp-action {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 14px;
        min-height: 110px;
        border: 1px solid #d9d9d9;
        border-radius: 16px;
        background: white;
        font-size: 1.5rem;
        cursor: pointer;
    }

        .vp-action:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

    .vp-danger {
        border-color: #e3b7b7;
    }

    .vp-icon {
        font-size: 2rem;
    }

    .vp-alert {
        border-radius: 10px;
        padding: 12px 16px;
        margin-bottom: 16px;
    }

    .vp-alert-ok {
        background: #eefaf1;
        border: 1px solid #bde2c4;
    }

    .vp-alert-error {
        background: #fff1f1;
        border: 1px solid #efb8b8;
    }

    .vp-foot-note {
        margin-top: 18px;
    }

    @@media (max-width: 768px) {
        .vp-grid {
            grid-template-columns: 1fr;
        }

        .vp-header h1 {
            font-size: 1.6rem;
        }
    }
</style>