@page "/eventoparticipante/{EventoId:long}"
@rendermode InteractiveServer
@using Votify.Modelos
@using Votify.Modelos.BusinessLogic.Domain
@using Votify.Modelos.BusinessLogic.Services
@inject I_Evento_Service Evento_Service
@inject EventoContextService EventoCtx
@inject NavigationManager Nav
@inject BlazorAuthStateProvider AuthProvider

@if (cargando)
{
    <p>Cargando vista del participante...</p>
}
else if (!string.IsNullOrWhiteSpace(error))
{
    <div class="vp-alert vp-alert-error">@error</div>
}
else if (eventoParticipante is null)
{
    <div class="vp-alert vp-alert-error">No se ha podido cargar el evento del participante.</div>
}
else
{
    <div class="vp-wrapper">
        <div class="vp-header">
            <div class="vp-header-left">
                <button class="vp-back-btn" @onclick="VolverHome">← Volver</button>
            </div>

            <h1 class="vp-header-title">@eventoParticipante.Nombre</h1>

            <div class="vp-header-right">
                <span class="rol-badge participante-badge">Participante</span>
            </div>
        </div>

        <div class="vp-card">
            <h3>@nombreGrupo</h3>

            @if (miembrosGrupo.Count == 0)
            {
                <p>No hay participantes cargados en el grupo.</p>
            }
            else
            {
                <table class="vp-table">
                    <tbody>
                        @foreach (var miembro in miembrosGrupo)
                        {
                            <tr>
                                <td>@miembro.Nombre</td>
                                <td>@miembro.Correo</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(mensaje))
        {
            <div class="vp-alert vp-alert-ok">@mensaje</div>
        }

        <div class="vp-grid">
            <button class="vp-action" @onclick="IrAPresentarProyecto" disabled="@tieneProyecto" title="@(tieneProyecto ? "Ya has entregado un proyecto" : "Subir proyecto")">
                <span class="vp-icon">📤</span>
                <span>@(tieneProyecto ? "Proyecto entregado" : "Subir proyecto")</span>
            </button>

            <button class="vp-action vp-danger" @onclick="EliminarProyecto" disabled="@(!tieneProyecto)">
                <span class="vp-icon">🗑️</span>
                <span>Eliminar proyecto</span>
            </button>

            <button class="vp-action" disabled title="Pendiente de implementar">
                <span class="vp-icon">📊</span>
                <span>Ver dashboard</span>
            </button>

            <button class="vp-action" disabled title="Pendiente de implementar">
                <span class="vp-icon">📋</span>
                <span>Lista de proyectos</span>
            </button>
        </div>

        <div class="vp-foot-note">
            @if (tieneProyecto)
            {
                <p><strong>Estado actual:</strong> Ya tienes un proyecto entregado para este evento.</p>
            }
            else
            {
                <p><strong>Estado actual:</strong> Todavía no has entregado ningún proyecto.</p>
            }
        </div>
    </div>
}

@code {
    [Parameter] public long EventoId { get; set; }

    private EventoParticipante? eventoParticipante;
    private bool cargando = true;
    private string? error;
    private string? mensaje;
    private bool tieneProyecto;

    private string nombreGrupo = "Grupo";
    private List<(string Nombre, string Correo)> miembrosGrupo = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var correo = AuthProvider.ObtenerCorreo();
        if (string.IsNullOrWhiteSpace(correo) || !AuthProvider.EstaAutenticado)
        {
            // usuario no autenticado, volver al login
            Nav.NavigateTo("/login");
            return;
        }

        try
        {
            var entradaEvento = await Evento_Service.EntrarEvento(correo, EventoId);

            if (entradaEvento.Evento is EventoParticipante participante)
            {
                eventoParticipante = participante;
            }

            if (eventoParticipante == null)
            {
                error = "No se ha podido cargar el evento como participante.";
                return;
            }

            // Establecer contexto del evento (no romper si falla)
            try { EventoCtx.EstablecerEvento(entradaEvento.Evento, "PARTICIPANTE", EventoId); } catch { }

            var grupo = await eventoParticipante.ObtenerMiGrupo();
            nombreGrupo = grupo?.Nombre ?? "Grupo sin nombre";

            miembrosGrupo = await eventoParticipante.ObtenerMiembrosGrupo();
            tieneProyecto = await eventoParticipante.TieneProyecto();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private void VolverHome()
    {
        Nav.NavigateTo("/home");
    }

    private void VolverAtras()
    {
        Nav.NavigateTo("/home");
    }

    private void IrAPresentarProyecto()
    {
        if (tieneProyecto)
        {
            mensaje = "Ya tienes un proyecto entregado para este evento.";
            return;
        }

        // Navegar a la página de presentar proyecto incluyendo el id del evento
        Nav.NavigateTo($"/eventoparticipantepresentar/{EventoId}");
    }

    private async Task EliminarProyecto()
    {
        mensaje = null;
        error = null;

        try
        {
            if (eventoParticipante == null)
                return;

            await eventoParticipante.EliminarProyecto();
            tieneProyecto = false;
            mensaje = "Proyecto eliminado correctamente.";
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }
}
