@page "/eventoadmin/{EventoId:long}/categoria/{CategoriaId:long}"
@rendermode InteractiveServer
@inject ApiClient ApiClient
@inject BlazorAuthStateProvider AuthProvider
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ToastService Toasts

@if (cargando)
{
    <p>Cargando...</p>
}
else if (!string.IsNullOrWhiteSpace(error))
{
    <div style="color:red">@error</div>
}
else
{
    <!-- PANCARTA -->
    <div style="background:linear-gradient(90deg,#0f172a,#1e293b);color:white;padding:25px;border-radius:18px;margin-bottom:25px;">

        <div style="
        display:flex;
        align-items:center;
        gap:10px;
        flex-wrap:wrap;
        margin-bottom:18px;
        color:#cbd5e1;
        font-size:0.95rem;">

            <span @onclick='() => Nav.NavigateTo("/home")'
                  style="cursor:pointer;">
                Home
            </span>

            <span>›</span>

            <span @onclick='() => Nav.NavigateTo($"/eventoadmin/{EventoId}")'
                  style="cursor:pointer;">
                @evento?.Nombre
            </span>

            <span>›</span>

            <span style="color:white;font-weight:600;">
                Categoría
            </span>

        </div>

        <h1 style="margin-top:12px;">@evento?.Nombre</h1>
        <p style="color:#cbd5e1;">@evento?.Descripcion</p>

        <span style="background:#2563eb;padding:6px 12px;border-radius:8px;">
            Fase actual: @faseActual?.Fase
        </span>
    </div>

    <!-- CATEGORÍA -->
    <div style="margin-bottom:25px;">
        <h2>@categoria?.Nombre</h2>
        <p>@categoria?.Descripcion</p>
    </div>

    @if (categoria?.CorreosJurados != null && categoria.CorreosJurados.Any())
    {
        <div style="margin-bottom:25px;
                        background:#f1f5f9;
                        padding:16px;
                        border-radius:12px;
                        border:1px solid #e2e8f0;">

            <h3 style="margin-bottom:10px;"> Jurados de esta categoría</h3>

            <div style="display:flex;flex-wrap:wrap;gap:10px;">
                @foreach (var jurado in categoria.CorreosJurados)
                {
                    <span style="background:#2563eb;
                                         color:white;
                                         padding:6px 12px;
                                         border-radius:999px;
                                         font-size:13px;">
                        @jurado
                    </span>
                }
            </div>
        </div>
    }

    @if (faseActual?.Fase == "Inscripciones")
    {
        <button @onclick="CrearGrupo"
                style="background:#16a34a;color:white;border:none;padding:10px 16px;border-radius:10px;margin-bottom:20px;">
            + Añadir grupo
        </button>
    }

    <!-- GRUPOS -->
    @foreach (var g in grupos)
    {
        <div style="border:1px solid #e5e7eb;border-radius:14px;padding:16px;margin-bottom:16px;">

            <!-- NOMBRE -->
            <div style="display:flex;align-items:center;gap:10px;">

                <input type="text"
                       @bind="g.Nombre"
                       disabled="@(faseActual?.Fase != "Inscripciones")"
                       style="font-weight:bold;font-size:16px;" />

                @if (faseActual?.Fase == "Inscripciones")
                {
                    <button @onclick="() => GuardarNombreGrupo(g)"
                            style="background:#2563eb;color:white;border:none;padding:6px 10px;border-radius:8px;">
                        Guardar nombre
                    </button>

                    <button @onclick="() => EliminarGrupo(g.Id)"
                            style="background:#dc2626;color:white;border:none;padding:6px 10px;border-radius:8px;">
                        ✕
                    </button>
                }
            </div>

            <hr />

            <!-- PARTICIPANTES -->
            @if (faseActual?.Fase == "Inscripciones")
            {
                @foreach (var item in g.CorreosParticipantes.Select((value, index) => new { value, index }))
                {
                    <div style="display:flex;gap:8px;align-items:center;margin-bottom:8px;">

                        <input type="text"
                               value="@item.value"
                               @oninput='e => g.CorreosParticipantes[item.index] = e.Value?.ToString() ?? ""'
                               style="width:260px;" />

                        <button @onclick="() => EliminarParticipante(g, item.index)">
                            ❌
                        </button>

                        @if (item.value == "Invitación Pendiente")
                        {
                            <span style="color:#d97706;font-size:13px;">
                                Invitación enviada
                            </span>
                        }

                    </div>
                }

                <button @onclick="() => AñadirParticipante(g)"
                        style="margin-top:6px;">
                    + Añadir participante
                </button>

                <br />

                <button @onclick="() => GuardarGrupo(g)"
                        style="margin-top:10px;background:#2563eb;color:white;border:none;padding:8px 12px;border-radius:8px;">
                    💾 Guardar cambios
                </button>
            }
            else
            {
                <ul>
                    @foreach (var p in g.CorreosParticipantes)
                    {
                        <li>@p</li>
                    }
                </ul>
            }

        </div>
    }
}

@code {

    [Parameter] public long EventoId { get; set; }
    [Parameter] public long CategoriaId { get; set; }

    EventoDto? evento;
    FaseDto? faseActual;
    CategoriaDto? categoria;

    List<GrupoDto> grupos = new();

    bool cargando = true;
    string error = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            var entrada = await ApiClient.GetFromJsonAsync<EntradaEventoRespuestaDto>(
                $"api/evento/{EventoId}");

            evento = entrada?.Evento;

            faseActual = await ApiClient.GetFromJsonAsync<FaseDto>(
                $"api/administrador/{EventoId}/fase");

            var categorias = await ApiClient.GetFromJsonAsync<List<CategoriaDto>>(
                $"api/evento/{EventoId}/categorias");

            categoria = categorias?.FirstOrDefault(x => x.Id == CategoriaId);

            grupos = await ApiClient.GetFromJsonAsync<List<GrupoDto>>(
                $"api/administrador/categoria/{CategoriaId}/grupos") ?? new();

            foreach (var g in grupos)
                await CargarParticipantes(g);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    async Task CargarParticipantes(GrupoDto grupo)
    {
        var participantes = await ApiClient.GetFromJsonAsync<List<MiembroGrupoDto>>(
            $"api/administrador/grupo/{grupo.Id}/participantes");

        var pendientes = await ApiClient.GetFromJsonAsync<int>(
            $"api/administrador/grupo/{grupo.Id}/pendientes");

        grupo.CorreosParticipantes = participantes?
            .Select(x => x.Correo)
            .ToList() ?? new();

        for (int i = 0; i < pendientes; i++)
            grupo.CorreosParticipantes.Add("Invitación Pendiente");
    }

    void Volver()
    {
        Nav.NavigateTo($"/eventoadmin/{EventoId}");
    }

    async Task CrearGrupo()
    {
        var dto = new GrupoDto
        {
            Nombre = "Nuevo grupo",
            IdCategoria = CategoriaId,
            CorreosParticipantes = new()
        };

        var loadingId = Toasts.ShowLoading("Creando grupo...");
        try
        {
            var response = await ApiClient.PostAsJsonAsync(
                $"api/administrador/categoria/{CategoriaId}/grupo", dto);

            if (response.IsSuccessStatusCode)
            {
                Toasts.ShowSuccess("Grupo creado correctamente.");
                Nav.NavigateTo(Nav.Uri, true);
            }
            else
            {
                Toasts.ShowError(await ApiClient.LeerError(response) ?? "No se pudo crear el grupo.");
            }
        }
        catch (Exception ex)
        {
            Toasts.ShowError($"Error al crear el grupo: {ex.Message}");
        }
        finally
        {
            Toasts.Dismiss(loadingId);
        }
    }

    async Task GuardarNombreGrupo(GrupoDto grupo)
    {
        try
        {
            var response = await ApiClient.PutAsJsonAsync(
                $"api/administrador/grupo/{grupo.Id}", grupo);

            if (response.IsSuccessStatusCode)
                Toasts.ShowSuccess($"Nombre del grupo '{grupo.Nombre}' guardado.");
            else
                Toasts.ShowError(await ApiClient.LeerError(response) ?? "No se pudo guardar el nombre del grupo.");
        }
        catch (Exception ex)
        {
            Toasts.ShowError($"Error al guardar el nombre del grupo: {ex.Message}");
        }
    }

    async Task GuardarGrupo(GrupoDto grupo)
    {
        var loadingId = Toasts.ShowLoading($"Guardando participantes de '{grupo.Nombre}'...");
        try
        {
            var response = await ApiClient.PutAsJsonAsync(
                $"api/administrador/{EventoId}/grupo/{grupo.Id}/participantes",
                grupo.CorreosParticipantes);

            if (response.IsSuccessStatusCode)
            {
                Toasts.ShowSuccess($"Participantes de '{grupo.Nombre}' actualizados. Las invitaciones se enviarán a los correos pendientes.");
                Nav.NavigateTo(Nav.Uri, true);
            }
            else
            {
                Toasts.ShowError(await ApiClient.LeerError(response) ?? "No se pudieron guardar los participantes.");
            }
        }
        catch (Exception ex)
        {
            Toasts.ShowError($"Error al guardar los participantes: {ex.Message}");
        }
        finally
        {
            Toasts.Dismiss(loadingId);
        }
    }

    async Task EliminarGrupo(long idGrupo)
    {
        var ok = await JS.InvokeAsync<bool>("confirm", "¿Eliminar grupo?");
        if (!ok) return;

        var loadingId = Toasts.ShowLoading("Eliminando grupo...");
        try
        {
            var response = await ApiClient.DeleteAsync($"api/administrador/grupo/{idGrupo}");

            if (response.IsSuccessStatusCode)
            {
                Toasts.ShowSuccess("Grupo eliminado.");
                Nav.NavigateTo(Nav.Uri, true);
            }
            else
            {
                Toasts.ShowError(await ApiClient.LeerError(response) ?? "No se pudo eliminar el grupo.");
            }
        }
        catch (Exception ex)
        {
            Toasts.ShowError($"Error al eliminar el grupo: {ex.Message}");
        }
        finally
        {
            Toasts.Dismiss(loadingId);
        }
    }

    void AñadirParticipante(GrupoDto grupo)
    {
        grupo.CorreosParticipantes.Add("");
    }

    void EliminarParticipante(GrupoDto grupo, int index)
    {
        grupo.CorreosParticipantes.RemoveAt(index);
    }
}