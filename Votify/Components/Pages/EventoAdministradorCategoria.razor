@page "/eventoadmin/{EventoId:long}/categoria/{CategoriaId:long}"
@rendermode InteractiveServer
@inject ApiClient ApiClient
@inject BlazorAuthStateProvider AuthProvider
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ToastService Toasts

@if (cargando)
{
    <p>Cargando...</p>
}
else if (!string.IsNullOrWhiteSpace(error))
{
    <div style="color:red">@error</div>
}
else
{
    <!-- PANCARTA HERO -->
    <div class="ejp-wrapper">
        <div class="ejp-hero">
            <div class="ejp-hero-content">
                <div class="ejp-hero-top">
                    <div style="flex: 1; display: flex; flex-direction: column; justify-content: flex-start;">
                        <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap; margin-bottom:18px; color:#cbd5e1; font-size:0.95rem;">
                            <span @onclick='() => Nav.NavigateTo("/home")' style="cursor:pointer;" class="ejp-breadcrumb">
                                Home
                            </span>
                            <span style="display: flex; align-items: center; margin-bottom: 1rem;">›</span>
                            <span @onclick='() => Nav.NavigateTo($"/eventoadmin/{EventoId}")' style="cursor:pointer;" class="ejp-breadcrumb">
                                @evento?.Nombre
                            </span>
                            <span style="display: flex; align-items: center; margin-bottom: 1rem;">›</span>
                            <span style="color:white;font-weight:600; margin-bottom: 1rem;">
                                Categoría
                            </span>
                        </div>

                        <span style="display:inline-block; padding: 4px 10px; background: rgba(255,255,255,0.15); border-radius: 6px; font-size: 0.85rem; font-weight: 600; width: fit-content; margin-bottom: 5px;">
                            @evento?.Nombre
                        </span>
                        <h1 style="margin: 0; font-size: 2.2rem;">@categoria?.Nombre</h1>

                        <div style="display: flex; gap: 0.65rem;">
                            @if (evento != null)
                            {
                                <span class="ejp-phase-pill @GetFaseClass(evento)">@GetFaseLabel(evento)</span>
                            }
                        </div>
                    </div>

                    <div class="ejp-descripcion-container" style="border-left: 2px solid rgba(255,255,255,0.2); padding-left: 1rem; margin-left: 1rem; flex: 2; display: flex; align-items: flex-start; justify-content: flex-start;">
                        <p style="margin: 0; max-width: 700px; color: rgba(255,255,255,0.78); font-size: 1rem; line-height: 1.6;">@categoria?.Descripcion</p>
                    </div>

                    <div class="ejp-hero-side" style="border-left: 2px solid rgba(255,255,255,0.2); padding-left: 1rem; margin-left: 1rem;">
                        <span class="ejp-role-badge">Administrador</span>
                        <span class="ejp-role-badge-white">Panel de categoría</span>
                    </div>
                </div>
            </div>
        </div>

        @if (categoria?.CorreosJurados != null && categoria.CorreosJurados.Any())
        {
            <div style="margin-bottom:25px;
                            background:#f1f5f9;
                            padding:16px;
                            border-radius:12px;
                            border:1px solid #e2e8f0;">

                <h3 style="margin-bottom:10px;"> Jurados de esta categoría</h3>

                <div style="display:flex;flex-wrap:wrap;gap:10px;">
                    @foreach (var jurado in categoria.CorreosJurados)
                    {
                        <span style="background:#2563eb;
                                             color:white;
                                             padding:6px 12px;
                                             border-radius:999px;
                                             font-size:13px;">
                            @jurado
                        </span>
                    }
                </div>
            </div>
        }

        @if (faseActual?.Fase == "Inscripciones")
        {
            <button class="btn-secundario" @onclick="CrearGrupo" style="margin-bottom:20px;">
                + Añadir grupo
            </button>
        }

        <!-- GRUPOS -->
        @foreach (var g in grupos)
        {
            <div class="grup-container">

                <!-- NOMBRE Y ACCIONES -->
                <div class="grup-sup">

                    <input type="text"
                           @bind="g.Nombre"
                           disabled="@(faseActual?.Fase != "Inscripciones")"
                           class="input input-grupo"
                           style="margin-right: 15px;" />

                    @if (faseActual?.Fase == "Inscripciones")
                    {
                        <div style="display: flex; gap: 8px; flex-wrap: nowrap; align-items:center; flex-shrink: 0;">
                            <button class="btn-secundario" @onclick="() => GuardarNombreGrupo(g)" style="white-space: nowrap;">
                                Cambiar nombre
                            </button>

                            <div style="width: 25px;"></div> <!-- Pequeño espacio -->

                            <button class="btn-secundario btn-primario" @onclick="() => GuardarGrupo(g)" style="white-space: nowrap; font-weight: 600;">
                                💾 Guardar Todo
                            </button>
                            <button class="btn-eliminar" @onclick="() => EliminarGrupo(g.Id)" style="white-space: nowrap;">
                                Eliminar grupo
                            </button>
                        </div>
                    }
                </div>

                <!-- PARTICIPANTES -->
                <div class="participantes" style="padding:15px; background: transparent; border: none;">
                    @if (faseActual?.Fase == "Inscripciones")
                    {
                        @foreach (var item in g.CorreosParticipantes.Select((value, index) => new { value, index }))
                        {
                            <div class="participante">

                                <input type="text"
                                       class="input"
                                       value="@item.value"
                                       @oninput='e => g.CorreosParticipantes[item.index] = e.Value?.ToString() ?? ""' />

                                @if (item.value == "Invitación Pendiente")
                                {
                                    <span style="color:#d97706;font-size:13px; font-weight:500; white-space:nowrap;">
                                        Invitación enviada
                                    </span>
                                }

                                <button class="btn-eliminar" @onclick="() => EliminarParticipante(g, item.index)" style="flex-shrink:0;">
                                    ✕
                                </button>

                            </div>
                        }

                        <div style="padding-left:15px; margin-top:5px;">
                            <button class="btn-secundario" @onclick="() => AñadirParticipante(g)">
                                + Añadir participante
                            </button>
                        </div>
                    }
                    else
                    {
                        <ul style="padding-left:25px; margin-top:5px; color:#555;">
                            @foreach (var p in g.CorreosParticipantes)
                            {
                                <li>@p</li>
                            }
                        </ul>
                    }
                </div>
            </div>
        }
    </div>
}

@code {

    [Parameter] public long EventoId { get; set; }
    [Parameter] public long CategoriaId { get; set; }

    EventoDto? evento;
    FaseDto? faseActual;
    CategoriaDto? categoria;

    List<GrupoDto> grupos = new();

    bool cargando = true;
    string error = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            var entrada = await ApiClient.GetFromJsonAsync<EntradaEventoRespuestaDto>(
                $"api/evento/{EventoId}");

            evento = entrada?.Evento;

            faseActual = await ApiClient.GetFromJsonAsync<FaseDto>(
                $"api/administrador/{EventoId}/fase");

            var categorias = await ApiClient.GetFromJsonAsync<List<CategoriaDto>>(
                $"api/evento/{EventoId}/categorias");

            categoria = categorias?.FirstOrDefault(x => x.Id == CategoriaId);

            grupos = await ApiClient.GetFromJsonAsync<List<GrupoDto>>(
                $"api/administrador/categoria/{CategoriaId}/grupos") ?? new();

            foreach (var g in grupos)
                await CargarParticipantes(g);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    async Task CargarParticipantes(GrupoDto grupo)
    {
        var participantes = await ApiClient.GetFromJsonAsync<List<MiembroGrupoDto>>(
            $"api/administrador/grupo/{grupo.Id}/participantes");

        var pendientes = await ApiClient.GetFromJsonAsync<int>(
            $"api/administrador/grupo/{grupo.Id}/pendientes");

        grupo.CorreosParticipantes = participantes?
            .Select(x => x.Correo)
            .ToList() ?? new();

        for (int i = 0; i < pendientes; i++)
            grupo.CorreosParticipantes.Add("Invitación Pendiente");
    }

    void Volver()
    {
        Nav.NavigateTo($"/eventoadmin/{EventoId}");
    }

    async Task CrearGrupo()
    {
        var dto = new GrupoDto
        {
            Nombre = "Nuevo grupo",
            IdCategoria = CategoriaId,
            CorreosParticipantes = new()
        };

        var loadingId = Toasts.ShowLoading("Creando grupo...");
        try
        {
            var response = await ApiClient.PostAsJsonAsync(
                $"api/administrador/categoria/{CategoriaId}/grupo", dto);

            if (response.IsSuccessStatusCode)
            {
                Toasts.ShowSuccess("Grupo creado correctamente.");
                Nav.NavigateTo(Nav.Uri, true);
            }
            else
            {
                Toasts.ShowError(await ApiClient.LeerError(response) ?? "No se pudo crear el grupo.");
            }
        }
        catch (Exception ex)
        {
            Toasts.ShowError($"Error al crear el grupo: {ex.Message}");
        }
        finally
        {
            Toasts.Dismiss(loadingId);
        }
    }

    async Task GuardarNombreGrupo(GrupoDto grupo)
    {
        try
        {
            var response = await ApiClient.PutAsJsonAsync(
                $"api/administrador/grupo/{grupo.Id}", grupo);

            if (response.IsSuccessStatusCode)
                Toasts.ShowSuccess($"Nombre del grupo '{grupo.Nombre}' guardado.");
            else
                Toasts.ShowError(await ApiClient.LeerError(response) ?? "No se pudo guardar el nombre del grupo.");
        }
        catch (Exception ex)
        {
            Toasts.ShowError($"Error al guardar el nombre del grupo: {ex.Message}");
        }
    }

    async Task GuardarGrupo(GrupoDto grupo)
    {
        var loadingId = Toasts.ShowLoading($"Guardando participantes de '{grupo.Nombre}'...");
        try
        {
            var response = await ApiClient.PutAsJsonAsync(
                $"api/administrador/{EventoId}/grupo/{grupo.Id}/participantes",
                grupo.CorreosParticipantes);

            if (response.IsSuccessStatusCode)
            {
                Toasts.ShowSuccess($"Participantes de '{grupo.Nombre}' actualizados. Las invitaciones se enviarán a los correos pendientes.");
                Nav.NavigateTo(Nav.Uri, true);
            }
            else
            {
                Toasts.ShowError(await ApiClient.LeerError(response) ?? "No se pudieron guardar los participantes.");
            }
        }
        catch (Exception ex)
        {
            Toasts.ShowError($"Error al guardar los participantes: {ex.Message}");
        }
        finally
        {
            Toasts.Dismiss(loadingId);
        }
    }

    async Task EliminarGrupo(long idGrupo)
    {
        var ok = await JS.InvokeAsync<bool>("confirm", "¿Eliminar grupo?");
        if (!ok) return;

        var loadingId = Toasts.ShowLoading("Eliminando grupo...");
        try
        {
            var response = await ApiClient.DeleteAsync($"api/administrador/grupo/{idGrupo}");

            if (response.IsSuccessStatusCode)
            {
                Toasts.ShowSuccess("Grupo eliminado.");
                Nav.NavigateTo(Nav.Uri, true);
            }
            else
            {
                Toasts.ShowError(await ApiClient.LeerError(response) ?? "No se pudo eliminar el grupo.");
            }
        }
        catch (Exception ex)
        {
            Toasts.ShowError($"Error al eliminar el grupo: {ex.Message}");
        }
        finally
        {
            Toasts.Dismiss(loadingId);
        }
    }

    void AñadirParticipante(GrupoDto grupo)
    {
        grupo.CorreosParticipantes.Add("");
    }

    void EliminarParticipante(GrupoDto grupo, int index)
    {
        grupo.CorreosParticipantes.RemoveAt(index);
    }

    private string GetFaseClass(EventoDto ev)
    {
        var hoy = DateOnly.FromDateTime(DateTime.Now);
        if (hoy <= ev.FechaFinInscripciones) return "fase-inscripciones";
        if (hoy <= ev.FechaFinEntrega) return "fase-entregas";
        if (hoy <= ev.FechaFinVotaciones) return "fase-votaciones";
        if (hoy <= ev.FechaFinEvaluacionExperta) return "fase-evaluacion-experta";
        if (hoy <= ev.FechaFinVotExperta) return "fase-votacion-experta";
        return "fase-finalizado";
    }

    private string GetFaseLabel(EventoDto ev)
    {
        var hoy = DateOnly.FromDateTime(DateTime.Now);
        if (hoy <= ev.FechaFinInscripciones) return "En fase de inscripciones";
        if (hoy <= ev.FechaFinEntrega) return "En fase de entregas";
        if (hoy <= ev.FechaFinVotaciones) return "En fase de votaciones";
        if (hoy <= ev.FechaFinEvaluacionExperta) return "En fase de evaluación experta";
        if (hoy <= ev.FechaFinVotExperta) return "En fase de votación experta";   
        return "Finalizado";
    }
}