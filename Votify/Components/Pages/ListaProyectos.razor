@page "/listaproyectos/{idEvento:long}"
@rendermode InteractiveServer
@inject BlazorAuthStateProvider AuthProvider
@inject NavigationManager Nav

@inject ApiClient ApiClient

@if (error != null)
{
    <div class="evp-alert evp-alert-error">@error</div>
}
else if (evento == null)
{
    <div class="evp-loading-state">
        <div class="evp-spinner"></div>
        <p>Cargando evento...</p>
    </div>
}
else
{
    <div class="evp-wrapper">
        <div class="evp-hero">
            <div class="evp-hero-content">
                <div class="evp-breadcrumb" @onclick="VolverHome">← Volver al home</div>

                <div class="evp-hero-top">
                    <div>
                        <div class="evp-eyebrow">Panel de proyectos</div>
                        <h1>@evento.Nombre</h1>
                        <p>@evento.Descripcion</p>
                    </div>

                    <div class="evp-hero-side">
                        <span class="evp-role-badge">@tipoRol</span>
                        <span class="evp-phase-pill @GetFaseClass(evento)">@GetFaseLabel(evento)</span>
                    </div>
                </div>
            </div>
        </div>

        @if (proyectos == null)
        {
            <div class="evp-loading-state">
                <div class="evp-spinner"></div>
                <p>Cargando proyectos...</p>
            </div>
        }
        else if (GetFaseLabel(evento) == "En fase de inscripción" || GetFaseLabel(evento) == "En fase de entrega")
        {
            <div class="evp-alert evp-alert-info">Los proyectos aún no son visibles durante las fases de inscripciones y entregas.</div>
        }
        else if (proyectos.Count == 0)
        {
            <div class="evp-alert evp-alert-info">No hay proyectos para mostrar en este evento.</div>
        }
        else
        {
            <div class="proyectos-lista">
                @foreach (var cat in categorias.Values)
                {
                    var proyectosDeCat = proyectos.Where(p => proyectoCategoria.ContainsKey(p.Id) && proyectoCategoria[p.Id] == cat.Id).ToList();
                    if (proyectosDeCat.Any())
                    {
                        <div class="categoria-seccion">
                            <h2 class="categoria-titulo">Categoría: @cat.Nombre</h2>
                            <div class="categoria-proyectos">
                                @foreach (var p in proyectosDeCat)
                                {
                                    <div class="proyectos" @onclick="() => IrAProyecto(p.Id)">
                                        <div class="nombreProyecto">
                                            <p>@p.Nombre</p>
                                        </div>
                                        <div class="informacionProyecto">
                                            <div class="participantesProyecto">
                                                @if (participantesPorGrupo.ContainsKey(p.IdGrupo))
                                                {
                                                    foreach (var pa in participantesPorGrupo[p.IdGrupo])
                                                    {
                                                        <p>@pa.Nombre</p>
                                                    }
                                                }
                                            </div>
                                            <div class="descripcionProyecto">
                                                <p>@p.DescripcionBreve</p>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        }
    </div>
}

@code {
    [Parameter] public long idEvento { get; set; }

    List<ProyectoDto>? proyectos;
    EventoDto? evento;
    string tipoRol = "";
    string? error;

    Dictionary<long, List<MiembroGrupoDto>> participantesPorGrupo = new();
    Dictionary<long, CategoriaDto> categorias = new();
    Dictionary<long, long> proyectoCategoria = new();

    private void VolverHome()
    {
        Nav.NavigateTo($"/home");
    }



    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (!AuthProvider.EstaAutenticado)
        {
            Nav.NavigateTo("/");
            return;
        }

        try
        {
            var entrada = await ApiClient.GetFromJsonAsync<EntradaEventoRespuestaDto>($"api/evento/{idEvento}");
            if (entrada is null)
            {
                error = "No se pudo cargar el evento.";
                return;
            }

            evento = entrada.Evento;
            if (entrada.Rol.EsAdministrador)  tipoRol = "Administrador";
            else if (entrada.Rol.EsJurado)    tipoRol = "Jurado";
            else if (entrada.Rol.EsParticipante) tipoRol = "Participante";
            else tipoRol = "Visitante";

            StateHasChanged();

            var proyectosTask  = ApiClient.GetFromJsonAsync<List<ProyectoDto>>($"api/evento/{idEvento}/proyectos");
            var categoriasTask = ApiClient.GetFromJsonAsync<List<CategoriaDto>>($"api/evento/{idEvento}/categorias");
            await Task.WhenAll(proyectosTask, categoriasTask);//En paralelo para optimizar tiempos de carga

            proyectos = await proyectosTask ?? new();
            var cats  = await categoriasTask ?? new();

            foreach (var c in cats) categorias[c.Id] = c;

            var tareas = proyectos.Select(async p =>
            {
                var miembrosTask = ApiClient.GetFromJsonAsync<List<MiembroGrupoDto>>($"api/evento/proyecto/{p.Id}/grupo/{p.IdGrupo}/participantes");
                var grupoTask = ApiClient.GetFromJsonAsync<GrupoDto>($"api/evento/grupo/{p.IdGrupo}");

                await Task.WhenAll(miembrosTask, grupoTask);

                var miembros = await miembrosTask;
                var grupo = await grupoTask;

                if (miembros is not null) participantesPorGrupo[p.IdGrupo] = miembros;
                if (grupo is not null) proyectoCategoria[p.Id]          = grupo.IdCategoria;
            });
            await Task.WhenAll(tareas);
        }
        catch (HttpRequestException ex)
        {
            error = $"Error cargando datos ({(int?)ex.StatusCode}): {ex.Message}";
        }
        catch (Exception ex)
        {
            error = $"Error inesperado: {ex.Message}";
        }
        finally
        {
            StateHasChanged();
        }
    }

    protected async Task IrAProyecto( long id)
    {
        Nav.NavigateTo($"/{idEvento}/proyecto/{id}");
    }

    private string GetFaseLabel(EventoDto ev)
    {
        var hoy = DateOnly.FromDateTime(DateTime.Now);
        if (hoy <= ev.FechaFinInscripciones) return "En fase de inscripción";
        if (hoy <= ev.FechaFinEntrega) return "En fase de entrega";
        if (hoy <= ev.FechaFinVotaciones) return "En fase de votación";
        return "Finalizado";
    }

    private string GetFaseClass(EventoDto ev)
    {
        var hoy = DateOnly.FromDateTime(DateTime.Now);
        if (hoy <= ev.FechaFinInscripciones) return "fase-inscripciones";
        if (hoy <= ev.FechaFinEntrega) return "fase-entregas";
        if (hoy <= ev.FechaFinVotaciones) return "fase-votaciones";
        return "fase-finalizado";
    }
}
