@page "/eventovotantelista/{idEvento:long}"
@rendermode InteractiveServer
@inject BlazorAuthStateProvider AuthProvider
@inject NavigationManager Nav

@inject IEventoService EventoService

@if (proyectos == null)
{
    <p>Cargando proyectos...</p>
}
else if (proyectos.Count == 0)
{
    <p>No hay proyectos para mostrar</p>
}
else
{
    @foreach (var p in proyectos)
    {
        <div class="proyectos" @onclick="() => IrAProyecto(p.Id)">
            <div class="nombreProyecto">
                <p>@p.Nombre</p>
            </div>
            <div class="informacionProyecto">
                <div class="participantesProyecto">

                    @if (participantesPorGrupo.ContainsKey(p.IdGrupo))
                    {
                        foreach (var pa in participantesPorGrupo[p.IdGrupo])
                        {
                            <p>@pa.Nombre</p>
                        }
                    }
                </div>
                <div class="descripcionProyecto">
                    <p>@p.DescripcionBreve</p>
                </div>
            </div>
        </div>
    }
}




@code {
    [Parameter] public long idEvento { get; set; }

    List<Proyecto>? proyectos;

    EventoVotante? eventoVotante;

    Dictionary<long, List<Usuario>> participantesPorGrupo = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var correo = AuthProvider.ObtenerCorreo();
        if (string.IsNullOrWhiteSpace(correo) || !AuthProvider.EstaAutenticado)
        {
            // usuario no autenticado, volver al login
            Nav.NavigateTo("/");
            return;
        }

        try
        {
            var entrada = await EventoService.EntrarEvento(correo, idEvento);

            if (entrada.Evento is EventoVotante evVot)
            {
                eventoVotante = evVot;
                proyectos = await eventoVotante.ListaProyectos(idEvento);

                participantesPorGrupo = new();

                foreach (var p in proyectos)
                {
                    var participantes = await eventoVotante.UsuariosParticipantesGrupo(p.IdGrupo);
                    participantesPorGrupo[p.IdGrupo] = participantes;
                }
            }
            else
            {
                proyectos = new List<Proyecto>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.ToString());
            throw;
        }
        finally
        {
            StateHasChanged();
        }
    }

    protected async Task IrAProyecto( long id)
    {
        Nav.NavigateTo($"/{idEvento}/proyecto/{id}");
    }
}
