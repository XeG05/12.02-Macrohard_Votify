@page "/eventovotantelista/{idEvento:long}"
@rendermode InteractiveServer
@using Votify.Modelos
@using Votify.Modelos.BusinessLogic.Domain
@inject BlazorAuthStateProvider AuthProvider
@inject NavigationManager Nav

@inject I_Evento_Service EventoService

@if (proyectos == null)
{
    <p>Ha habido un error al cargar los proyectos</p>
}
else if (proyectos.Count == 0)
{
    <p>No hay proyectos para mostrar</p>
}
