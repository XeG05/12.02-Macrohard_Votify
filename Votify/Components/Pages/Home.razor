@page "/home"
@rendermode InteractiveServer
@inject ApiClient ApiClient
@inject BlazorAuthStateProvider AuthProvider
@inject NavigationManager Nav

<div class="home-wrapper">

    <div class="home-header">
        <div class="home-header-text">
            <h1>Bienvenido, <span class="nombre-usuario">@nombre</span></h1>
            <p>Gestiona tus eventos o únete a los de tu comunidad</p>
        </div>
        <a class="btn-crear" href="EventCreator">
            <span class="btn-crear-icon">＋</span>
            Crear evento
        </a>
    </div>

    @if (cargando)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Cargando eventos...</p>
        </div>
    }
    else
    {
        <section class="seccion">
            <div class="seccion-header">
                <div class="seccion-indicador admin-color"></div>
                <h2>Mis eventos</h2>
                <span class="badge">@eventosCreados.Count</span>
            </div>

            @if (eventosCreados.Count == 0)
            {
                <div class="empty-state">
                    <span class="empty-icon">📋</span>
                    <p>Todavía no has creado ningún evento.</p>
                    <a href="EventCreator" class="link-accion">Crea tu primer evento →</a>
                </div>
            }
            else
            {
                <div class="eventos-grid">
                    @foreach (var ev in eventosCreados)
                    {
                        var eventoId = ev.Id;
                        <div class="evento-card" @onclick="() => IrAEventoAdmin(eventoId)">
                            <div class="evento-card-top">
                                <div class="fase-pill @GetFaseClass(ev)">@GetFaseLabel(ev)</div>
                                <span class="rol-badge admin-badge">Administrador</span>
                            </div>
                            <h3 class="evento-nombre">@ev.Nombre</h3>
                            <p class="evento-desc">@TruncarTexto(ev.Descripcion, 90)</p>
                            <div class="evento-fechas">
                                <div class="fecha-item">
                                    <span class="fecha-label">Inscripciones</span>
                                    <span class="fecha-valor">@ev.FechaFinInscripciones.ToString("dd MMM yyyy")</span>
                                </div>
                                <div class="fecha-item">
                                    <span class="fecha-label">Votaciones</span>
                                    <span class="fecha-valor">@ev.FechaFinVotaciones.ToString("dd MMM yyyy")</span>
                                </div>
                            </div>
                            <div class="evento-footer">
                                <span class="ver-mas">Ver evento →</span>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>

        <section class="seccion">
            <div class="seccion-header">
                <div class="seccion-indicador participante-color"></div>
                <h2>Participando en</h2>
                <span class="badge">@eventoParticipando.Count</span>
            </div>

            @if (eventoParticipando.Count == 0)
            {
                <div class="empty-state">
                    <span class="empty-icon">🔍</span>
                    <p>No estás participando en ningún evento actualmente.</p>
                </div>
            }
            else
            {
                <div class="eventos-grid">
                    @foreach (var part in eventoParticipando)
                    {
                        var eventoId = part.Evento.Id;
                        var ev = part.Evento;
                        var rolTxt = part.Rol;
                        var grupoId = part.Grupo?.Id;
                        <div class="evento-card" @onclick="() => IrAEventoParticipante(eventoId, grupoId)">
                            <div class="evento-card-top">
                                <div class="fase-pill @GetFaseClass(ev)">@GetFaseLabel(ev)</div>
                                <span class="rol-badge participante-badge">@rolTxt</span>
                            </div>
                            <h3 class="evento-nombre">@ev.Nombre</h3>
                            @if (part.Grupo != null)
                            {
                                <p class="evento-desc" style="font-weight: 500; font-size: 0.9em; color: var(--text-2); margin-bottom: 2px;">Grupo: @part.Grupo.Nombre</p>
                            }
                            <p class="evento-desc">@TruncarTexto(ev.Descripcion, 70)</p>
                            <div class="evento-fechas">
                                <div class="fecha-item">
                                    <span class="fecha-label">Inscripciones</span>
                                    <span class="fecha-valor">@ev.FechaFinInscripciones.ToString("dd MMM yyyy")</span>
                                </div>
                                <div class="fecha-item">
                                    <span class="fecha-label">Votaciones</span>
                                    <span class="fecha-valor">@ev.FechaFinVotaciones.ToString("dd MMM yyyy")</span>
                                </div>
                            </div>
                            <div class="evento-footer">
                                <span class="ver-mas">Ver evento →</span>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>

        <section class="seccion">
            <div class="seccion-header">
                <div class="seccion-indicador votante-color"></div>
                <h2>Otros eventos</h2>
                <span class="badge">@eventosDisponibles.Count</span>
            </div>
            @if (eventosDisponibles.Count == 0)
            {
                <div class="empty-state">
                    <span class="empty-icon">🔍</span>
                    <p>No existe ningún evento más actualmente.</p>
                </div>
            }
            else
            {
                <div class="eventos-grid">
                    @foreach (var ev in eventosDisponibles)
                    {
                        var eventoId = ev.Id;
                        <div class="evento-card" @onclick="() => IrAEventoVotante(eventoId)">
                            <div class="evento-card-top">
                                <div class="fase-pill @GetFaseClass(ev)">@GetFaseLabel(ev)</div>
                                <span class="rol-badge votante-badge">Votante</span>
                            </div>
                            <h3 class="evento-nombre">@ev.Nombre</h3>
                            <p class="evento-desc">@TruncarTexto(ev.Descripcion, 90)</p>
                            <div class="evento-fechas">
                                <div class="fecha-item">
                                    <span class="fecha-label">Inscripciones</span>
                                    <span class="fecha-valor">@ev.FechaFinInscripciones.ToString("dd MMM yyyy")</span>
                                </div>
                                <div class="fecha-item">
                                    <span class="fecha-label">Votaciones</span>
                                    <span class="fecha-valor">@ev.FechaFinVotaciones.ToString("dd MMM yyyy")</span>
                                </div>
                            </div>
                            <div class="evento-footer">
                                <span class="ver-mas">Ver evento →</span>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>

        <section class="seccion">
            <div class="seccion-header">
                <div class="seccion-indicador jurado-color"></div>
                <h2>Eventos como jurado</h2>
                <span class="badge">@eventosJurado.Count</span>
            </div>

            @if (eventosJurado.Count == 0)
            {
                <div class="empty-state">
                    <span class="empty-icon">⚖️</span>
                    <p>No tienes eventos asignados como jurado.</p>
                </div>
            }
            else
            {
                <div class="eventos-grid">
                    @foreach (var ev in eventosJurado)
                    {
                        var eventoId = ev.Id;
                        var evento = ev;

                        <div class="evento-card" @onclick="() => IrAEventoJurado(eventoId)">
                            <div class="evento-card-top">
                                <div class="fase-pill @GetFaseClass(evento)">@GetFaseLabel(evento)</div>
                                <span class="rol-badge jurado-badge">Jurado</span>
                            </div>

                            <h3 class="evento-nombre">@evento.Nombre</h3>
                            <p class="evento-desc">@TruncarTexto(evento.Descripcion, 90)</p>

                            <div class="evento-fechas">
                                <div class="fecha-item">
                                    <span class="fecha-label">Inscripciones</span>
                                    <span class="fecha-valor">@evento.FechaFinInscripciones.ToString("dd MMM yyyy")</span>
                                </div>
                                <div class="fecha-item">
                                    <span class="fecha-label">Votaciones</span>
                                    <span class="fecha-valor">@evento.FechaFinVotaciones.ToString("dd MMM yyyy")</span>
                                </div>
                            </div>

                            <div class="evento-footer">
                                <span class="ver-mas">Evaluar →</span>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>
    }
</div>

@code {
    private string nombre = "";
    private bool cargando = true;
    private List<EventoDto> eventosCreados = new();
    private List<EventoParticipanteDto> eventoParticipando = new();
    private List<EventoDto> eventosDisponibles = new();
    private List<EventoDto> eventosJurado = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        if (!AuthProvider.EstaAutenticado)
        {
            Nav.NavigateTo("/");
            return;
        }

        nombre = AuthProvider.ObtenerNombre() ?? AuthProvider.ObtenerCorreo() ?? "";

        try
        {
            eventosCreados = await ApiClient.GetFromJsonAsync<List<EventoDto>>("api/evento/creados") ?? new();

            eventoParticipando = await ApiClient.GetFromJsonAsync<List<EventoParticipanteDto>>("api/evento/participacion") ?? new();

            eventosDisponibles = await ApiClient.GetFromJsonAsync<List<EventoDto>>("api/evento/disponibles") ?? new();

            eventosJurado = await ApiClient.GetFromJsonAsync<List<EventoDto>>("api/evento/experto") ?? new();
        }
        catch (Exception e)
        {
            Console.WriteLine(e.Message);
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private string GetFaseLabel(EventoDto ev)
    {
        var hoy = DateOnly.FromDateTime(DateTime.Now);
        if (hoy <= ev.FechaFinInscripciones) return "Inscripciones";
        if (hoy <= ev.FechaFinEntrega) return "Entregas";
        if (hoy <= ev.FechaFinVotaciones) return "Votaciones";
        if (hoy <= ev.FechaFinEvaluacionExperta) return "Evaluación experta";
        return "Finalizado";
    }

    private string GetFaseClass(EventoDto ev)
    {
        var hoy = DateOnly.FromDateTime(DateTime.Now);
        if (hoy <= ev.FechaFinInscripciones) return "fase-inscripciones";
        if (hoy <= ev.FechaFinEntrega) return "fase-entregas";
        if (hoy <= ev.FechaFinVotaciones) return "fase-votaciones";
        if (hoy <= ev.FechaFinEvaluacionExperta) return "fase-experta";
        return "fase-finalizado";
    }

    private void IrAEventoAdmin(long id) => Nav.NavigateTo($"/eventoadmin/{id}");

    private void IrAEventoParticipante(long id, long? grupoId)
    {
        if (grupoId.HasValue)
            Nav.NavigateTo($"/eventoparticipante/{id}/{grupoId.Value}");
        else
            Nav.NavigateTo($"/eventoparticipante/{id}");
    }

    private void IrAEventoVotante(long id) => Nav.NavigateTo($"/listaproyectos/{id}");

    private string TruncarTexto(string texto, int max)
    {
        if (string.IsNullOrEmpty(texto)) return "";
        return texto.Length <= max ? texto : texto[..max] + "…";
    }

    private void IrAEventoJurado(long id)
    {
        Nav.NavigateTo($"/eventojurado/{id}");
    }
}
