@page "/"
@rendermode InteractiveServer
@inject I_Usuario_Service UsuarioService
@inject JwtService JwtService
@inject BlazorAuthStateProvider AuthProvider
@inject NavigationManager Nav
@layout NoLayout

<div class="layout">
    <h1>Votify</h1>

    <div class="input">
        <p>Correo electrónico:</p>
        <input @bind="correo" placeholder="Inserte su correo electrónico" />
    </div>
    <div class="input">
        <p>Contraseña:</p>
        <input @bind="contraseña" type="password" placeholder="Inserte su contraseña" @onkeydown="OnKeyDown" />
    </div>
    <div class="button">
        <button @onclick="SignIn" disabled="@cargando">
            @(cargando ? "Iniciando..." : "Iniciar sesión")
        </button>
    </div>
    @if (!string.IsNullOrEmpty(mensaje))
    {
        <p class="@(error ? "error" : "ok")">@mensaje</p>
    }
    <div class="options">
        <NavLink href="/register">¿Tu primera vez en votify? Crea tu cuenta</NavLink>
        <NavLink href="/register">¿Has olvidado tu contraseña?</NavLink>
    </div>
  
</div>

@code {

    string correo = "";
    string contraseña = "";
    string mensaje = "";
    bool error = false;
    bool cargando = false;
 
    async Task SignIn()
    {
        cargando = true;
        mensaje = "";
 
        try
        {
            var usuario = await UsuarioService.Login(correo, contraseña);
 
            if (usuario != null)
            {
                var token = JwtService.GenerateToken(usuario);
                await AuthProvider.MarcarAutenticado(token);  // ← await
                Nav.NavigateTo("/home");
            }
        }
        catch (Exception ex)
        {
            mensaje = ex.Message;
            error = true;
        }
        finally
        {
            cargando = false;
        }
    }
 
    async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SignIn();
    }
}
