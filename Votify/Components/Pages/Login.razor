@page "/"
@page "/login"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject ApiClient ApiClient
@inject BlazorAuthStateProvider AuthProvider
@inject NavigationManager Nav
@layout NoLayout

<div class="layout">
    <h1>Votify</h1>

    <div class="input">
        <p>Correo electrónico:</p>
        <input @bind="correo" @bind:event="oninput" placeholder="Inserte su correo electrónico" />
    </div>
    <div class="input">
        <p>Contraseña:</p>
        <input @bind="contraseña" @bind:event="oninput" type="password" placeholder="Inserte su contraseña" @onkeydown="OnKeyDown" />
    </div>
    <div class="button">
        <button @onclick="SignIn" disabled="@cargando">
            @(cargando ? "Iniciando..." : "Iniciar sesión")
        </button>
    </div>
    @if (!string.IsNullOrEmpty(mensaje))
    {
        <p class="@(error ? "error" : "ok")">@mensaje</p>
    }
    <div class="options">
        <NavLink href="/register">¿Tu primera vez en Votify? Crea tu cuenta</NavLink>
        <NavLink href="/register">¿Has olvidado tu contraseña?</NavLink>
    </div>
  
</div>

@code {

    string correo = "";
    string contraseña = "";
    string mensaje = "";
    bool error = false;
    bool cargando = false;
 
    async Task SignIn()
    {
        cargando = true;
        mensaje = "";
 
        try
        {
            var response = await ApiClient.PostAnonymousAsync("api/usuario/login", new { correo, contraseña });

            if (response.IsSuccessStatusCode)
            {
                var auth = await response.Content.ReadFromJsonAsync<AuthDto>();
                if (auth != null)
                {
                    await AuthProvider.MarcarAutenticado(auth.Token);
                    Nav.NavigateTo("/home");
                }
            }
            else
            {
                var err = await response.Content.ReadFromJsonAsync<ErrorDto>();
                mensaje = err?.Error ?? "Credenciales incorrectas";
                error = true;
            }
        }
        catch (Exception ex)
        {
            mensaje = ex.Message;
            error = true;
        }
        finally
        {
            cargando = false;
        }
    }
 
    async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SignIn();
    }
}
