@page "/login"
@inject I_Usuario_Service UsuarioService

<div class="layout">
    <h1>Votify</h1>

    <div class="input">
        <p>Correo electrónico:</p>
        <input @bind="correo" placeholder="Inserte su correo electrónico" />
    </div>
    <div class="input">
        <p>Contraseña:</p>
        <input @bind="contraseña" type="password" placeholder="Inserte su contraseña" />
    </div>
    <div class="button">
        <button @onclick="login">Iniciar sesión</button>
    </div>
    <p>@mensaje</p>
    <div class="options">
        <NavLink href="/register">¿Tu primera vez en votify? Crea tu cuenta</NavLink>
        <NavLink href="/register">¿Has olvidado tu contraseña?</NavLink>
    </div>
  
</div>

@code {

    string correo;
    string contraseña;
    string mensaje;

    async Task login()
    {
        var user = await UsuarioService.Login(correo, contraseña);

        if (user == null)
            mensaje = "Usuario o contraseña incorrectos";
        else
            mensaje = "Login correcto";
    }
}
