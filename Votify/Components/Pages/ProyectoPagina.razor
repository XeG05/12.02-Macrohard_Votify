@page "/{idEvento:long}/proyecto/{idProyecto:long}"
@rendermode InteractiveServer
@inject BlazorAuthStateProvider AuthProvider
@inject NavigationManager Nav
@inject HttpClient Http
@inject IJSRuntime JS

@inject IEventoService EventoService
@if(proyecto != null)
{
    <div class="page">
        <!-- Botón de volver -->
        <div class="cabecera-proyecto">
             <button class="btn-volver" @onclick="VolverAtras" title="Volver a la lista de proyectos">
                 <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-arrow-left" viewBox="0 0 16 16">
                     <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z"/>
                 </svg>
             </button>
        </div>

        <!-- Contenedor superior con nombre, participantes e imágenes -->
        <div class="rectangulo-info">
            <div class="nom-par">
                <div class="nombrePr">
                    <h3>@proyecto.Nombre</h3>
                </div>
                <div class="participantesPr">
                    @if(participantes != null && participantes.Any())
                    {
                        @foreach (var participante in participantes)
                        {
                            <p>@participante.Nombre</p>
                        }
                    } else
                    {
                        <p>No hay participantes para este grupo</p>
                    }

                </div>
            </div>

            <div class="imagenes">
                @if (proyecto.Imagenes != null && proyecto.Imagenes.Any())
                {
                    <button class="arrow-btn" @onclick="ImagenAnterior">&lt;</button>
                    <!-- Asumiendo que ImagenProyecto tiene una propiedad con la URL o el contenido en Base64 -->
                    <div class="imagen-actual-container">
                        <span>Imagen @(imagenActual + 1) de @proyecto.Imagenes.Count</span>
                        img src="..." alt="Imagen del proyecto"
                    </div>
                    <button class="arrow-btn" @onclick="ImagenSiguiente">&gt;</button>
                }
                else
                {
                    <div class="sin-imagenes">
                        <span>Imágenes a añadir por los participantes</span>
                    </div>
                }
            </div>
        </div>

        <!-- Descripción larga debajo del recuadro principal -->
        <div class="descripcion-larga">
            <p>@proyecto.Descripcion</p>
        </div>

        <!-- Botón de descarga -->
        <div class="acciones-proyecto">
             <button class="btn-secundario" @onclick="DescargarProyecto">Descargar proyecto</button>
        </div>

        <!-- Área de comentarios -->
        <div class="seccion-comentarios">
            <textarea placeholder="Escribe aquí comentarios sobre el proyecto" @bind="nuevoComentario" disabled="@comentarioEnviado"></textarea>
            <div class="enviar-btn-container">
                <button class="btn-secundario" @onclick="EnviarComentario" disabled="@comentarioEnviado">Enviar comentario</button>
            </div>
        </div>

        <!-- Sección de votación -->
        <div class="seccion-votar">
            <label class="checkbox-votar">
                <input type="checkbox" /> Votar por el proyecto
            </label>
            <span class="votos-restantes">X/3 votos restantes</span>
        </div>
    </div>
}
else {
    <div class="page">
        <p>Cargando proyecto...</p>
    </div>
}

@code {
    [Parameter] public long idProyecto { get; set; }
    [Parameter] public long idEvento { get; set; }

    Proyecto? proyecto;
    EventoVotante? eventoVotante;
    List<Usuario>? participantes;

    string nuevoComentario = "";
    int imagenActual = 0;
    bool comentarioEnviado = false;

    //Tengo que hacer que primero compruebe si ya hay un comentario mandado por parte de ese usuario

    private async Task EnviarComentario()
    {
        if (string.IsNullOrWhiteSpace(nuevoComentario) || proyecto == null) return;

        var baseUrl = Nav.BaseUri;

        var peticion = new 
        {
            IdEvento = idEvento,
            IdGrupo = proyecto.IdGrupo,
            Comentario = nuevoComentario
        };

        var token = await AuthProvider.ObtenerToken(); 
        Http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

        var response = await Http.PostAsJsonAsync($"{baseUrl}api/Evento/proyecto/comentar", peticion);

        if (response.IsSuccessStatusCode)
        {
            comentarioEnviado = true;
        }
        else
        {
            Console.WriteLine("Error al enviar el comentario.");
        }
    }

    private async Task DescargarProyecto()
    {
        if (proyecto?.Archivo != null && proyecto.Archivo.Length > 0)
        {
            var fileName = $"{proyecto.Nombre.Replace(" ", "_")}_Proyecto.zip";
            var base64 = Convert.ToBase64String(proyecto.Archivo);
            var script = $@"
                var a = document.createElement('a');
                a.href = 'data:application/octet-stream;base64,{base64}';
                a.download = '{fileName}';
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
            ";
            await JS.InvokeVoidAsync("eval", script);
        }
    }

    private void VolverAtras()
    {
        Nav.NavigateTo($"/eventovotantelista/{idEvento}");
    }

    private void ImagenAnterior()
    {
        if (proyecto?.Imagenes != null && proyecto.Imagenes.Any())
        {
            imagenActual--;
            if (imagenActual < 0) imagenActual = proyecto.Imagenes.Count - 1;
        }
    }

    private void ImagenSiguiente()
    {
        if (proyecto?.Imagenes != null && proyecto.Imagenes.Any())
        {
            imagenActual++;
            if (imagenActual >= proyecto.Imagenes.Count) imagenActual = 0;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var correo = AuthProvider.ObtenerCorreo();
        if (string.IsNullOrWhiteSpace(correo) || !AuthProvider.EstaAutenticado)
        {
            // usuario no autenticado, volver al login
            Nav.NavigateTo("/");
            return;
        }

        try
        {
            var entrada = await EventoService.EntrarEvento(correo, idEvento);

            if (entrada.Evento is EventoVotante evVot)
            {
                eventoVotante = evVot;
                
                var baseUrl = Nav.BaseUri;

                var token = await AuthProvider.ObtenerToken(); 
                Http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

                proyecto = await Http.GetFromJsonAsync<Proyecto>($"{baseUrl}api/Evento/proyecto/{idProyecto}");
                if(proyecto == null)
                {
                    throw new Exception("No se pudo cargar el proyecto.");
                }
                participantes = await Http.GetFromJsonAsync<List<Usuario>>($"{baseUrl}api/Evento/proyecto/{idProyecto}/grupo/{proyecto.IdGrupo}/participantes");
                
            }
            else
            {
                throw new Exception("El usuario no es un votante en este evento.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.ToString());
            proyecto = null;
        }
        finally
        {
            StateHasChanged();
        }
    }
}
