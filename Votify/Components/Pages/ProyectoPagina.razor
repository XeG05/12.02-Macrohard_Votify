@page "/{idEvento:long}/proyecto/{idProyecto:long}"
@rendermode InteractiveServer
@inject BlazorAuthStateProvider AuthProvider
@inject NavigationManager Nav

@inject IEventoService EventoService

<div class="page">
    <div class="rectangulo-info">
        <div class="nom-par">
            <div class="nombrePr">
            </div>
            <div class="participantesPr">
            </div>
        </div>
        <div class="imagenes">
        </div>
    </div>
</div>

@code {
    [Parameter] public long idProyecto { get; set; }
    [Parameter] public long idEvento { get; set; }

    EventoVotante? eventoVotante;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var correo = AuthProvider.ObtenerCorreo();
        if (string.IsNullOrWhiteSpace(correo) || !AuthProvider.EstaAutenticado)
        {
            // usuario no autenticado, volver al login
            Nav.NavigateTo("/");
            return;
        }

        try
        {
            var entrada = await EventoService.EntrarEvento(correo, idEvento);

            if (entrada.Evento is EventoVotante evVot)
            {
                eventoVotante = evVot;
                proyectos = await EventoService.ListaProyectos(idEvento);

                participantesPorGrupo = new();

                foreach (var p in proyectos)
                {
                    var participantes = await eventoVotante.UsuariosParticipantesGrupo(p.IdGrupo);
                    participantesPorGrupo[p.IdGrupo] = participantes;
                }
            }
            else
            {
                proyectos = new List<Proyecto>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.ToString());
            throw;
        }
        finally
        {
            StateHasChanged();
        }
    }
}
