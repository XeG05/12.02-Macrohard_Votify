@page "/{idEvento:long}/proyecto/{idProyecto:long}"
@rendermode InteractiveServer
@inject BlazorAuthStateProvider AuthProvider
@inject NavigationManager Nav
@inject HttpClient Http
@inject IJSRuntime JS

@inject IEventoService EventoService
@if(proyecto != null)
{
    <div class="page">
        <div class="cabecera-proyecto">
             <button class="btn-volver" @onclick="VolverAtras" title="Volver a la lista de proyectos">
                 <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-arrow-left" viewBox="0 0 16 16">
                     <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z"/>
                 </svg>
             </button>
        </div>

        <div class="rectangulo-info">
            <div class="nom-par">
                <div class="nombrePr">
                    <h3>@proyecto.Nombre</h3>
                </div>
                <div class="participantesPr">
                    @if(participantes != null && participantes.Any())
                    {
                        @foreach (var participante in participantes)
                        {
                            <p>@participante.Nombre</p>
                        }
                    } else
                    {
                        <p>No hay participantes para este grupo</p>
                    }

                </div>
            </div>

            <div class="imagenes">
                @if (proyecto.Imagenes != null && proyecto.Imagenes.Any())
                {
                    <button class="arrow-btn" @onclick="ImagenAnterior">&lt;</button>
                    <div class="imagen-actual-container">
                        <span>Imagen @(imagenActual + 1) de @proyecto.Imagenes.Count</span>
                        <img src="data:image/jpeg;base64,@Convert.ToBase64String(proyecto.Imagenes[imagenActual].Archivo)" alt="Imagen del proyecto" />
                    </div>
                    <button class="arrow-btn" @onclick="ImagenSiguiente">&gt;</button>
                }
                else
                {
                    <div class="sin-imagenes">
                        <span>Imágenes a añadir por los participantes</span>
                    </div>
                }
            </div>
        </div>

        <div class="descripcion-larga">
            <p>@proyecto.Descripcion</p>
        </div>

        <div class="acciones-proyecto">
             <button class="btn-secundario" @onclick="DescargarProyecto">Descargar proyecto</button>
        </div>

        @if(!string.IsNullOrEmpty(errorMessage))
        {
            <div class="evp-alert" style="background-color: #fef2f2; color: #991b1b; border: 1px solid #fecaca; padding: 1rem; border-radius: 12px; margin-bottom: 1rem;">
                @errorMessage
            </div>
        }

        @if (esVotante)
        {
            <div class="seccion-comentarios">
                <textarea placeholder="Escribe aquí comentarios sobre el proyecto" @bind="nuevoComentario" disabled="@comentarioEnviado"></textarea>
                <div class="enviar-btn-container">
                    <button class="btn-secundario" @onclick="EnviarComentario" disabled="@comentarioEnviado">Enviar comentario</button>
                </div>
            </div>

            @if (eventoBase?.ObtenerFaseActual() == Votify.LógicaNegocio.Enums.FasesEvento.Votaciones)
            {
                <div class="seccion-votar">
                    <label class="checkbox-votar">
                        <input type="checkbox" checked="@haVotado" disabled="@(haVotado || votosTotalesEvento >= 3)" @onchange="EmitirVoto" /> Votar por el proyecto
                    </label>
                    <span class="votos-restantes">@(Math.Max(0, 3 - votosTotalesEvento))/3 votos restantes (por categoría)</span>
                </div>
            }
            else
            {
                <div class="seccion-votar">
                    <div class="evp-alert evp-alert-info">Las votaciones solo están habilitadas durante la fase de votaciones.</div>
                </div>
            }
        }
    </div>
}
else {
    <div class="page">
        <p>Cargando proyecto...</p>
    </div>
}

@code {
    [Parameter] public long idProyecto { get; set; }
    [Parameter] public long idEvento { get; set; }

    Proyecto? proyecto;
    Votify.LógicaNegocio.Domain.EventoBase? eventoBase;
    List<Usuario>? participantes;

    string nuevoComentario = "";
    int imagenActual = 0;
    bool comentarioEnviado = false;
    bool votoEnviado = false;
    bool haVotado = false;
    int votosTotalesEvento = 0;
    string errorMessage = "";
    private long _ultimoIdCargado = 0;
    bool esVotante = false;

    private class ComentarioDto {
        public string Contenido { get; set; } = "";
    }

    private class VotoInfoDto {
        public int VotosRestantes { get; set; }
        public bool HaVotado { get; set; }
    }

    private async Task EmitirVoto(ChangeEventArgs e)
    {
        if (eventoBase?.ObtenerFaseActual() != Votify.LógicaNegocio.Enums.FasesEvento.Votaciones) return;

        bool isChecked = (bool)(e.Value ?? false);
        if (!isChecked)
        {
            if (haVotado)
            {
                haVotado = true;
                StateHasChanged();
            }
            return;
        }

        if (haVotado || votosTotalesEvento >= 3) return;

        var baseUrl = Nav.BaseUri;
        var peticion = new 
        {
            IdEvento = idEvento,
            IdProyecto = idProyecto
        };

        var token = await AuthProvider.ObtenerToken(); 
        Http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

        var response = await Http.PostAsJsonAsync($"{baseUrl}api/Evento/proyecto/votar", peticion);

        if (response.IsSuccessStatusCode)
        {
            haVotado = true;
            votosTotalesEvento++;
            errorMessage = "";
        }
        else
        {
            var errorContent = await response.Content.ReadAsStringAsync();
            Console.WriteLine($"Error al emitir el voto: {errorContent}");
            errorMessage = "Error al emitir el voto: " + errorContent;
            // Si hay error desmarcamos visualmente
            haVotado = false;
            StateHasChanged();
        }
    }

    private async Task EnviarComentario()
    {
        if (string.IsNullOrWhiteSpace(nuevoComentario) || proyecto == null) return;

        var baseUrl = Nav.BaseUri;

        var peticion = new 
        {
            IdEvento = idEvento,
            IdProyecto = idProyecto,
            Comentario = nuevoComentario
        };

        var token = await AuthProvider.ObtenerToken(); 
        Http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

        var response = await Http.PostAsJsonAsync($"{baseUrl}api/Evento/proyecto/comentar", peticion);

        if (response.IsSuccessStatusCode)
        {
            comentarioEnviado = true;
        }
        else
        {
            Console.WriteLine("Error al enviar el comentario.");
        }
    }

    private async Task DescargarProyecto()
    {
        if (proyecto?.Archivo != null && proyecto.Archivo.Length > 0)
        {
            var fileName = $"{proyecto.Nombre.Replace(" ", "_")}_Proyecto.zip";
            var base64 = Convert.ToBase64String(proyecto.Archivo);
            var script = $@"
                var a = document.createElement('a');
                a.href = 'data:application/octet-stream;base64,{base64}';
                a.download = '{fileName}';
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
            ";
            await JS.InvokeVoidAsync("eval", script);
        }
    }

    private void VolverAtras()
    {
        Nav.NavigateTo($"/listaproyectos/{idEvento}");
    }

    private void ImagenAnterior()
    {
        if (proyecto?.Imagenes != null && proyecto.Imagenes.Any())
        {
            imagenActual--;
            if (imagenActual < 0) imagenActual = proyecto.Imagenes.Count - 1;
        }
    }

    private void ImagenSiguiente()
    {
        if (proyecto?.Imagenes != null && proyecto.Imagenes.Any())
        {
            imagenActual++;
            if (imagenActual >= proyecto.Imagenes.Count) imagenActual = 0;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_ultimoIdCargado == idProyecto) return;

        _ultimoIdCargado = idProyecto;

        proyecto = null;
        participantes = null;
        nuevoComentario = "";
        comentarioEnviado = false;
        votoEnviado = false;
        haVotado = false;
        votosTotalesEvento = 0;
        imagenActual = 0;
        errorMessage = "";
        StateHasChanged();

        var correo = AuthProvider.ObtenerCorreo();
        if (string.IsNullOrWhiteSpace(correo) || !AuthProvider.EstaAutenticado)
        {
            // usuario no autenticado, volver al login
            Nav.NavigateTo("/");
            return;
        }

        try
        {
            var entrada = await EventoService.EntrarEvento(correo, idEvento);

            eventoBase = entrada.Evento;
            esVotante = entrada.TipoRol.Votante != null && entrada.TipoRol.Administrador == null && entrada.TipoRol.Jurado == null && (entrada.TipoRol.Participantes == null || !entrada.TipoRol.Participantes.Any());

            var baseUrl = Nav.BaseUri;

            var token = await AuthProvider.ObtenerToken(); 
            Http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

            proyecto = await Http.GetFromJsonAsync<Proyecto>($"{baseUrl}api/Evento/proyecto/{idProyecto}");
            if(proyecto == null)
            {
                throw new Exception("No se pudo cargar el proyecto.");
            }
            participantes = await Http.GetFromJsonAsync<List<Usuario>>($"{baseUrl}api/Evento/proyecto/{idProyecto}/grupo/{proyecto.IdGrupo}/participantes");

            // Al solicitar el comentario, si no existe o devuelve NoContent(204), HttpClient lanzará una excepción o devolverá null
            try
            {
                var responseComentario = await Http.GetAsync($"{baseUrl}api/Evento/proyecto/{idProyecto}/comentario/usuario");
                if (responseComentario.IsSuccessStatusCode && responseComentario.StatusCode != System.Net.HttpStatusCode.NoContent)
                {
                    // IMPORTANTE: Leemos con el ComentarioDto temporal en vez del Comentario de entidad EF.
                    var comentarioExistente = await responseComentario.Content.ReadFromJsonAsync<ComentarioDto>();
                    if (comentarioExistente != null && !string.IsNullOrWhiteSpace(comentarioExistente.Contenido))
                    {
                        nuevoComentario = comentarioExistente.Contenido;
                        comentarioEnviado = true;
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine("Error al obtener el comentario del usuario (o no existe): " + ex.Message);
            }

            if (esVotante) {
                try
                {
                    var responseVoto = await Http.GetAsync($"{baseUrl}api/Evento/proyecto/{idProyecto}/evento/{idEvento}/voto-info");
                    if (responseVoto.IsSuccessStatusCode)
                    {
                        var votoInfo = await responseVoto.Content.ReadFromJsonAsync<VotoInfoDto>();
                        if (votoInfo != null)
                        {
                            haVotado = votoInfo.HaVotado;
                            votosTotalesEvento = 3 - votoInfo.VotosRestantes;
                        }
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine("Error al obtener la info del voto: " + ex.Message);
                }
            }

        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.ToString());
            proyecto = null;
        }
        finally
        {
            StateHasChanged();
        }
    }
}
