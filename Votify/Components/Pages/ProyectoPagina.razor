@page "/{idEvento:long}/proyecto/{idProyecto:long}"
@rendermode InteractiveServer
@inject BlazorAuthStateProvider AuthProvider
@inject NavigationManager Nav
@inject ApiClient ApiClient
@inject IJSRuntime JS

@if(proyecto != null)
{
    <div class="page">
        <div class="cabecera-proyecto">
             <button class="btn-volver" @onclick="VolverAtras" title="Volver a la lista de proyectos">
                 <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-arrow-left" viewBox="0 0 16 16">
                     <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z"/>
                 </svg>
             </button>
        </div>

        <div class="rectangulo-info">
            <div class="nom-par">
                <div class="nombrePr">
                    <h3>@proyecto.Nombre</h3>
                </div>
                <div class="participantesPr">
                    @if(participantes != null && participantes.Any())
                    {
                        @foreach (var participante in participantes)
                        {
                            <p>@participante.Nombre</p>
                        }
                    } else
                    {
                        <p>No hay participantes para este grupo</p>
                    }
                </div>
            </div>

            <div class="imagenes">
                @if (proyecto.Imagenes != null && proyecto.Imagenes.Any())
                {
                    <button class="arrow-btn" @onclick="ImagenAnterior">&lt;</button>
                    <div class="imagen-actual-container">
                        <img src="data:image/jpeg;base64,@proyecto.Imagenes[imagenActual]" alt="Imagen del proyecto" />
                        <span>Imagen @(imagenActual + 1) de @proyecto.Imagenes.Count</span>
                    </div>
                    <button class="arrow-btn" @onclick="ImagenSiguiente">&gt;</button>
                }
                else
                {
                    <div class="sin-imagenes">
                        <span>Imágenes a añadir por los participantes</span>
                    </div>
                }
            </div>
        </div>

        <div class="descripcion-larga">
            <p>@proyecto.Descripcion</p>
        </div>

        <div class="acciones-proyecto">
             <button class="btn-secundario" @onclick="DescargarProyecto">Descargar proyecto</button>
        </div>

        @if(!string.IsNullOrEmpty(errorMessage))
        {
            <div class="evp-alert" style="background-color: #fef2f2; color: #991b1b; border: 1px solid #fecaca; padding: 1rem; border-radius: 12px; margin-bottom: 1rem;">
                @errorMessage
            </div>
        }

        @if (esVotante || esJurado)
        {
            bool puedeVotarSegunFase = false;
            bool puedeComentarSegunFase = false;
            var faseActual = GetFaseClass(evento);

            if (esVotante && faseActual == "votaciones")
            {
                puedeVotarSegunFase = true;
                puedeComentarSegunFase = true;
            }
            else if (esJurado)
            {
                if (faseActual == "votacion-experta")
                {
                    puedeVotarSegunFase = true;
                    puedeComentarSegunFase = false;
                }
                else if (faseActual == "evaluacion")
                {
                    puedeVotarSegunFase = false;
                    puedeComentarSegunFase = true;
                }
            }

            @if (puedeVotarSegunFase || puedeComentarSegunFase)
            {
                <div class="votacion-criterios">
                    <h3>Votación</h3>

                    @foreach (var criterio in criteriosCategoria)
                    {
                        var abierto = criteriosAbiertos.Contains(criterio.Id);
                        var info = votoInfoPorCriterio.ContainsKey(criterio.Id)
                            ? votoInfoPorCriterio[criterio.Id]
                            : new CriterioVotoInfoDto { IdCriterio = criterio.Id };

                        var comentarioObligatorioFaltante = evento!.TipoComentario == TipoComentario.Obligatorio
                            && !(comentariosEnviados.ContainsKey(criterio.Id) && comentariosEnviados[criterio.Id]);

                        <div class="criterio-voto-card">
                            <button type="button"
                                    class="criterio-voto-header"
                                    @onclick="() => ToggleCriterio(criterio.Id)">
                                <span>@criterio.Nombre</span>
                                    @if (evento!.TipoVotacion == TipoVotacion.Puntos)
                                    {
                                        var restantes = info.PuntosRestantes ?? evento!.PuntosARepartir;
                                        <span class="puntos-criterio-badge @(restantes == 0 ? "agotado" : restantes < evento!.PuntosARepartir / 4 ? "bajo" : "")">
                                            @restantes / @evento!.PuntosARepartir pts
                                        </span>
                                    }
                                <span>@(abierto ? "▲" : "▼")</span>
                            </button>

                            @if (abierto)
                            {
                                <div class="criterio-voto-body">
                                    @if (puedeVotarSegunFase && comentarioObligatorioFaltante)
                                    {
                                        <div class="aviso-comentario-obligatorio">
                                            Envía tu comentario antes de votar en este criterio.
                                        </div>
                                    }
                                    @if (puedeVotarSegunFase)
                                    {
                                        @if (evento!.TipoVotacion == TipoVotacion.Simple)
                                        {
                                            <div class="criterio-voto-footer">
                                                <label class="checkbox-votar">
                                                    <input type="checkbox"
                                                           checked="@info.HaVotado"
                                                           disabled="@(info.HaVotado || info.VotosRestantes <= 0 || comentarioObligatorioFaltante)" )"
                                                           @onchange="e => EmitirVotoSimple(e, criterio.Id)" />
                                                    Votar por el proyecto
                                                </label>
                                                <span class="votos-restantes">
                                                    @info.VotosRestantes / @evento.NumVotarProyectos votos restantes
                                                </span>
                                            </div>
                                        }
                                        else if (evento!.TipoVotacion == TipoVotacion.Nota)
                                        {
                                            <div class="criterio-voto-footer">
                                                <label>Nota (1 - 10):</label>
                                                <input type="number" min="1" max="10"
                                                       value="@ObtenerValorPendiente(criterio.Id, info)"
                                                       @onchange="e => ActualizarValorPendiente(criterio.Id, e)" />
                                                <button class="btn-secundario"
                                                        disabled="@comentarioObligatorioFaltante"
                                                        @onclick="() => EmitirVotoNota(criterio.Id)">
                                                    @(info.HaVotado ? "Actualizar nota" : "Guardar nota")
                                                </button>
                                                @if (info.HaVotado)
                                                {
                                                    <span class="votos-restantes">Nota actual: @info.NotaDada</span>
                                                }
                                            </div>
                                        }
                                        else if (evento!.TipoVotacion == TipoVotacion.Puntos)
                                        {
                                            <div class="criterio-voto-footer">
                                                <label>Puntos a asignar:</label>
                                                <input type="number" min="0"
                                                       max="@((info.PuntosAsignados ?? 0) + (info.PuntosRestantes ?? 0))"
                                                       value="@ObtenerValorPendiente(criterio.Id, info)"
                                                       @onchange="e => ActualizarValorPendiente(criterio.Id, e)" />
                                                <button class="btn-secundario"
                                                        disabled="@comentarioObligatorioFaltante"
                                                        @onclick="() => EmitirVotoPuntos(criterio.Id)">
                                                    Asignar puntos
                                                </button>
                                            </div>
                                            <div class="puntos-criterio-detalle">
                                                <span class="puntos-asignados-proyecto">
                                                    Este proyecto: <b>@(info.PuntosAsignados ?? 0)</b> pts
                                                </span>
                                                <span class="puntos-restantes-criterio @(info.PuntosRestantes == 0 ? "agotado" : "")">
                                                    Restantes: <b>@(info.PuntosRestantes ?? evento!.PuntosARepartir)</b> / @evento!.PuntosARepartir
                                                </span>
                                            </div>
                                        }
                                    }

                                    @if (puedeComentarSegunFase && evento!.TipoComentario != TipoComentario.SinComentarios)
                                    {
                                        var textoComentario = comentariosPorCriterio.TryGetValue(criterio.Id, out var tc) ? tc : "";
                                        var enviado = comentariosEnviados.TryGetValue(criterio.Id, out var ce) && ce;

                                        <div class="comentario-section" style="margin-top:12px;">
                                            <h5 style="margin-bottom:6px;">
                                                Comentario
                                                @if (evento.TipoComentario == TipoComentario.Obligatorio)
                                                {
                                                    <span style="color:#ef4444; font-size:0.85rem;"> (obligatorio)</span>
                                                }
                                                else
                                                {
                                                    <span style="color:#6b7280; font-size:0.85rem;"> (opcional)</span>
                                                }
                                            </h5>
                                            @if (!enviado)
                                            {
                                                <textarea placeholder="Escribe tu comentario sobre este criterio..."
                                                          value="@textoComentario"
                                                          @onchange="ev => ActualizarComentario(criterio.Id, ev)"
                                                          rows="3" style="width:100%; box-sizing:border-box;"></textarea>
                                                <button class="btn-secundario"
                                                        @onclick="() => EnviarComentario(criterio.Id)"
                                                        disabled="@(string.IsNullOrWhiteSpace(textoComentario))">
                                                    Enviar comentario
                                                </button>
                                            }
                                            else
                                            {
                                                <div style="background:#f0fdf4; border:1px solid #86efac; border-radius:8px; padding:0.75rem;">
                                                    <p style="margin:0; color:#166534;">@textoComentario</p>
                                                    <small style="color:#6b7280;">✓ Comentario enviado</small>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="seccion-votar">
                    <div class="evp-alert evp-alert-info">
                        Las votaciones y los comentarios solo están habilitados durante tu fase correspondiente 
                        @(esJurado ? "(evaluación experta)" : "(fase de votaciones)").
                    </div>
                </div>
            }
        }
    </div>
}
else {
    <div class="page">
        <p>Cargando proyecto...</p>
    </div>
}

@code {
    [Parameter] public long idProyecto { get; set; }
    [Parameter] public long idEvento { get; set; }

    ProyectoDto? proyecto;
    EventoDto? evento;
    List<MiembroGrupoDto>? participantes;
    List<CriterioDto> criteriosCategoria = new();
    Dictionary<long, CriterioVotoInfoDto> votoInfoPorCriterio = new();
    Dictionary<long, int> valoresPendientes = new();
    HashSet<long> criteriosAbiertos = new();
    Dictionary<long, string> comentariosPorCriterio = new();
    Dictionary<long, bool> comentariosEnviados = new();

    int imagenActual = 0;
    string errorMessage = "";
    private long _ultimoIdCargado = 0;
    private long _idCategoria = 0;
    bool esVotante = false;
    bool esJurado = false;    
    
    private int ObtenerValorPendiente(long idCriterio, CriterioVotoInfoDto info)
    {
        if (valoresPendientes.TryGetValue(idCriterio, out var v)) return v;
        if (evento?.TipoVotacion == TipoVotacion.Nota) return (int)(info.NotaDada ?? 1);
        if (evento?.TipoVotacion == TipoVotacion.Puntos) return (int)(info.PuntosAsignados ?? 0);
        return 0;
    }

    private void ActualizarValorPendiente(long idCriterio, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var val))
            valoresPendientes[idCriterio] = val;
    }

    private async Task EmitirVotoSimple(ChangeEventArgs e, long idCriterio)
    {
        if (evento == null) return;
        bool isChecked = (bool)(e.Value ?? false);
        if (!isChecked) return;

        if (!votoInfoPorCriterio.ContainsKey(idCriterio))
            votoInfoPorCriterio[idCriterio] = new CriterioVotoInfoDto { IdCriterio = idCriterio };

        var info = votoInfoPorCriterio[idCriterio];

        if (info.HaVotado || info.VotosRestantes <= 0) return;

        var peticion = new { IdEvento = idEvento, IdProyecto = idProyecto, IdCriterio = idCriterio, Valor = (int?)null };
        var response = await ApiClient.PostAsJsonAsync("api/evento/proyecto/votar", peticion);

        if (response.IsSuccessStatusCode)
        {
            info.HaVotado = true;
            info.VotosRestantes = Math.Max(0, (info.VotosRestantes ?? 0) - 1);
            errorMessage = "";
        }
        else
        {
            errorMessage = "Error al emitir el voto: " + await response.Content.ReadAsStringAsync();
        }
        StateHasChanged();
    }

    private async Task EmitirVotoNota(long idCriterio)
    {
        if (evento == null) return;
        if (!valoresPendientes.TryGetValue(idCriterio, out var nota) || nota <= 0)
        {
            errorMessage = "Introduce una nota válida (mayor que 0).";
            return;
        }

        var peticion = new { IdEvento = idEvento, IdProyecto = idProyecto, IdCriterio = idCriterio, Valor = (int?)nota };
        var response = await ApiClient.PostAsJsonAsync("api/evento/proyecto/votar", peticion);

        if (response.IsSuccessStatusCode)
        {
            await RecargarInfoVoto();
            errorMessage = "";
        }
        else
        {
            errorMessage = "Error al guardar la nota: " + await response.Content.ReadAsStringAsync();
        }
        StateHasChanged();
    }

    private async Task EmitirVotoPuntos(long idCriterio)
    {
        if (evento == null) return;
        if (!valoresPendientes.TryGetValue(idCriterio, out var puntos))
            puntos = 0;

        var peticion = new { IdEvento = idEvento, IdProyecto = idProyecto, IdCriterio = idCriterio, Valor = (int?)puntos };
        var response = await ApiClient.PostAsJsonAsync("api/evento/proyecto/votar", peticion);

        if (response.IsSuccessStatusCode)
        {
            await RecargarInfoVoto();
            errorMessage = "";
        }
        else
        {
            errorMessage = "Error al asignar puntos: " + await response.Content.ReadAsStringAsync();
        }
        StateHasChanged();
    }

    private async Task RecargarInfoVoto()
    {
        var responseVoto = await ApiClient.GetAsync($"api/evento/proyecto/{idProyecto}/evento/{idEvento}/voto-info");
        if (responseVoto.IsSuccessStatusCode)
        {
            var infoCriterios = await responseVoto.Content.ReadFromJsonAsync<List<CriterioVotoInfoDto>>();
            if (infoCriterios != null)
                votoInfoPorCriterio = infoCriterios.ToDictionary(v => v.IdCriterio, v => v);
        }
    }

    private void ToggleCriterio(long idCriterio)
    {
        if (!criteriosAbiertos.Add(idCriterio))
            criteriosAbiertos.Remove(idCriterio);
    }

    private void ActualizarComentario(long idCriterio, ChangeEventArgs e)
    {
        comentariosPorCriterio[idCriterio] = e.Value?.ToString() ?? "";
    }

    private async Task EnviarComentario(long idCriterio)
    {
        if (evento == null || proyecto == null) return;
        if (!comentariosPorCriterio.TryGetValue(idCriterio, out var texto) || string.IsNullOrWhiteSpace(texto)) return;
        var faseActual = GetFaseClass(evento);
        if ((esVotante && faseActual != "votaciones") || (esJurado && faseActual != "evaluacion")) return;

        var peticion = new
        {
            IdEvento = idEvento,
            IdProyecto = idProyecto,
            IdCriterio = idCriterio,
            Comentario = texto
        };

        var response = await ApiClient.PostAsJsonAsync("api/evento/proyecto/comentar", peticion);

        if (response.IsSuccessStatusCode)
        {
            comentariosEnviados[idCriterio] = true;
        }
        else
        {
            errorMessage = "Error al enviar el comentario: " + await response.Content.ReadAsStringAsync();
        }
        StateHasChanged();
    }

    // Descarga — sin eval, usando el endpoint directamente
    private async Task DescargarProyecto()
    {
        if (proyecto != null && proyecto.TieneArchivo)
            {
            var response = await ApiClient.GetAsync($"api/evento/proyecto/{idProyecto}/descargar");
            if (response.IsSuccessStatusCode)
            {
                var contentBytes = await response.Content.ReadAsByteArrayAsync();
                var nombreArchivo = response.Content.Headers.ContentDisposition?.FileNameStar 
                                    ?? response.Content.Headers.ContentDisposition?.FileName 
                                    ?? $"{proyecto.Nombre}.zip";

                nombreArchivo = nombreArchivo.Trim('"');

                using var streamRef = new DotNetStreamReference(new MemoryStream(contentBytes));
                await JS.InvokeVoidAsync("downloadFileFromStream", nombreArchivo, streamRef);
            }
            else
            {
                errorMessage = "Error al descargar el proyecto. Código: " + response.StatusCode;
            }
        }
    }

    private void VolverAtras()
    {
        if (esJurado && _idCategoria > 0)
        {
            Nav.NavigateTo($"/eventojurado/{idEvento}/categoria/{_idCategoria}");
        }
        else
        {
            Nav.NavigateTo($"/listaproyectos/{idEvento}");
        }
    }

    private void ImagenAnterior()
    {
        if (proyecto?.Imagenes != null && proyecto.Imagenes.Any())
        {
            imagenActual--;
            if (imagenActual < 0) imagenActual = proyecto.Imagenes.Count - 1;
        }
    }

    private void ImagenSiguiente()
    {
        if (proyecto?.Imagenes != null && proyecto.Imagenes.Any())
        {
            imagenActual++;
            if (imagenActual >= proyecto.Imagenes.Count) imagenActual = 0;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_ultimoIdCargado == idProyecto) return;

        _ultimoIdCargado = idProyecto;

        proyecto = null;
        participantes = null;
        comentariosPorCriterio = new();
        comentariosEnviados = new();
        imagenActual = 0;
        errorMessage = "";
        criteriosCategoria = new();
        votoInfoPorCriterio = new();
        valoresPendientes = new();
        criteriosAbiertos = new();
        StateHasChanged();

        var correo = AuthProvider.ObtenerCorreo();
        if (string.IsNullOrWhiteSpace(correo) || !AuthProvider.EstaAutenticado)
        {
            // usuario no autenticado, volver al login
            Nav.NavigateTo("/");
            return;
        }

        try
        {
            var entrada = await ApiClient.GetFromJsonAsync<EntradaEventoRespuestaDto>($"api/evento/{idEvento}");
            if(entrada == null)
            {
                Nav.NavigateTo("/home");
                return;
            }
            evento = entrada.Evento;
            esVotante = entrada.Rol.EsVotante && !entrada.Rol.EsAdministrador
                && !entrada.Rol.EsJurado && !entrada.Rol.EsParticipante;
            esJurado = entrada.Rol.EsJurado;

            proyecto = await ApiClient.GetFromJsonAsync<ProyectoDto>($"api/evento/proyecto/{idProyecto}");
            if (proyecto == null)
            {
                errorMessage = "No se pudo cargar el proyecto. Por favor, inténtalo de nuevo más tarde.";
                return;
            }
            participantes = await ApiClient.GetFromJsonAsync<List<MiembroGrupoDto>>($"api/evento/proyecto/{idProyecto}/grupo/{proyecto.IdGrupo}/participantes");
            var categorias = await ApiClient.GetFromJsonAsync<List<CategoriaDto>>($"api/evento/{idEvento}/categorias") ?? new();
            var grupoProyecto = await ApiClient.GetFromJsonAsync<GrupoDto>($"api/evento/grupo/{proyecto.IdGrupo}");

            if (grupoProyecto != null)
            {
                _idCategoria = grupoProyecto.IdCategoria;
                var categoriaProyecto = categorias.FirstOrDefault(c => c.Id == grupoProyecto.IdCategoria);
                criteriosCategoria = categoriaProyecto?.Criterios ?? new();

                if (criteriosCategoria.Any())
                {
                    criteriosAbiertos.Add(criteriosCategoria.First().Id);
                }
            }
            // Al solicitar el comentario, si no existe o devuelve NoContent(204), HttpClient lanzará una excepción o devolverá null
            try
            {
                var responseComentario = await ApiClient.GetAsync($"api/evento/proyecto/{idProyecto}/comentario/usuario");
                if (responseComentario.IsSuccessStatusCode && responseComentario.StatusCode != System.Net.HttpStatusCode.NoContent)
                {
                    var comentariosExistentes = await responseComentario.Content.ReadFromJsonAsync<List<ComentarioDto>>();
                    if (comentariosExistentes != null)
                    {
                        foreach (var c in comentariosExistentes)
                        {
                            comentariosPorCriterio[c.IdCriterio] = c.Contenido;
                            comentariosEnviados[c.IdCriterio] = true;
                        }
                    }
                }
            }
            catch { }

            if (esVotante || esJurado)
            {
                try
                {
                    await RecargarInfoVoto();
                    // Inicializar valores pendientes con los ya asignados
                    foreach (var (idCrit, info) in votoInfoPorCriterio)
                    {
                        if (evento.TipoVotacion == TipoVotacion.Nota && info.NotaDada.HasValue)
                            valoresPendientes[idCrit] = (int)info.NotaDada.Value;
                        else if (evento.TipoVotacion == TipoVotacion.Puntos)
                            valoresPendientes[idCrit] = (int)(info.PuntosAsignados ?? 0);
                    }
                }
                catch (Exception ex) 
                { 
                    Console.WriteLine("Error voto-info: " + ex.Message); 
                }
            }

        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.ToString());
            proyecto = null;
        }
        finally
        {
            StateHasChanged();
        }

    }

    private string GetFaseClass(EventoDto ev)
    {
        var hoy = DateOnly.FromDateTime(DateTime.Now);
        if (hoy <= ev.FechaFinInscripciones) return "inscripciones";
        if (hoy <= ev.FechaFinEntrega) return "entregas";
        if (hoy <= ev.FechaFinVotaciones) return "votaciones";
        if (hoy <= ev.FechaFinEvaluacionExperta) return "evaluacion";
        if (hoy <= ev.FechaFinVotExperta) return "votacion-experta";
        return "resultados";
    }
}
