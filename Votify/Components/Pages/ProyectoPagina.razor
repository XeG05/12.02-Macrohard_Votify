@page "/{idEvento:long}/proyecto/{idProyecto:long}"
@rendermode InteractiveServer
@inject BlazorAuthStateProvider AuthProvider
@inject NavigationManager Nav
@inject ApiClient ApiClient
@inject IJSRuntime JS

@if(proyecto != null)
{
    <div class="page">
        <div class="cabecera-proyecto">
             <button class="btn-volver" @onclick="VolverAtras" title="Volver a la lista de proyectos">
                 <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-arrow-left" viewBox="0 0 16 16">
                     <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z"/>
                 </svg>
             </button>
        </div>

        <div class="rectangulo-info">
            <div class="nom-par">
                <div class="nombrePr">
                    <h3>@proyecto.Nombre</h3>
                </div>
                <div class="participantesPr">
                    @if(participantes != null && participantes.Any())
                    {
                        @foreach (var participante in participantes)
                        {
                            <p>@participante.Nombre</p>
                        }
                    } else
                    {
                        <p>No hay participantes para este grupo</p>
                    }

                </div>
            </div>

            <div class="imagenes">
                @if (proyecto.Imagenes != null && proyecto.Imagenes.Any())
                {
                    <button class="arrow-btn" @onclick="ImagenAnterior">&lt;</button>
                    <div class="imagen-actual-container">
                        // HTML — imágenes desde base64
                        <img src="data:image/jpeg;base64,@proyecto.Imagenes[imagenActual]" alt="Imagen del proyecto" />
                        <span>Imagen @(imagenActual + 1) de @proyecto.Imagenes.Count</span>
                    </div>
                    <button class="arrow-btn" @onclick="ImagenSiguiente">&gt;</button>
                }
                else
                {
                    <div class="sin-imagenes">
                        <span>Imágenes a añadir por los participantes</span>
                    </div>
                }
            </div>
        </div>

        <div class="descripcion-larga">
            <p>@proyecto.Descripcion</p>
        </div>

        <div class="acciones-proyecto">
             <button class="btn-secundario" @onclick="DescargarProyecto">Descargar proyecto</button>
        </div>

        @if(!string.IsNullOrEmpty(errorMessage))
        {
            <div class="evp-alert" style="background-color: #fef2f2; color: #991b1b; border: 1px solid #fecaca; padding: 1rem; border-radius: 12px; margin-bottom: 1rem;">
                @errorMessage
            </div>
        }

        @if (esVotante)
        {
            @if (GetFaseClass(evento) == "votaciones")
            {
                <div class="votacion-criterios">
                    <h3>Votación</h3>

                    @foreach (var criterio in criteriosCategoria)
                    {
                        var abierto = criteriosAbiertos.Contains(criterio.Id);
                        var info = votoInfoPorCriterio.ContainsKey(criterio.Id)
                            ? votoInfoPorCriterio[criterio.Id]
                            : new CriterioVotoInfoDto { IdCriterio = criterio.Id, VotosRestantes = 3, HaVotado = false };

                        <div class="criterio-voto-card">
                            <button type="button"
                                    class="criterio-voto-header"
                                    @onclick="() => ToggleCriterio(criterio.Id)">
                                <span>@criterio.Nombre</span>
                                <span>@(abierto ? "▲" : "▼")</span>
                            </button>

                            @if (abierto)
                            {
                                <div class="criterio-voto-body">
                                    <textarea placeholder="Escribe aquí el comentario sobre el criterio"
                                              disabled></textarea>

                                    <div class="criterio-voto-actions">
                                        <button class="btn-secundario" disabled>
                                            Enviar comentario
                                        </button>
                                    </div>

                                    <div class="criterio-voto-footer">
                                        <label class="checkbox-votar">
                                            <input type="checkbox"
                                                   checked="@info.HaVotado"
                                                   disabled="@(info.HaVotado || info.VotosRestantes <= 0)"
                                                   @onchange="e => EmitirVotoCriterio(e, criterio.Id)" />
                                            Votar por el proyecto
                                        </label>

                                        <span class="votos-restantes">
                                            @info.VotosRestantes/3 votos restantes
                                        </span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="seccion-votar">
                    <div class="evp-alert evp-alert-info">Las votaciones y los comentarios solo están habilitados durante la fase de votaciones.</div>
                </div>
            }
        }
    </div>
}
else {
    <div class="page">
        <p>Cargando proyecto...</p>
    </div>
}

@code {
    [Parameter] public long idProyecto { get; set; }
    [Parameter] public long idEvento { get; set; }

    ProyectoDto? proyecto;
    EventoDto? evento;
    List<MiembroGrupoDto>? participantes;
    List<CriterioDto> criteriosCategoria = new();
    Dictionary<long, CriterioVotoInfoDto> votoInfoPorCriterio = new();
    HashSet<long> criteriosAbiertos = new();

    string nuevoComentario = "";
    int imagenActual = 0;
    bool comentarioEnviado = false;
    bool votoEnviado = false;
    bool haVotado = false;
    int votosTotalesEvento = 0;
    string errorMessage = "";
    private long _ultimoIdCargado = 0;
    bool esVotante = false;

    private async Task EmitirVotoCriterio(ChangeEventArgs e, long idCriterio)
    {
        if (evento == null || GetFaseClass(evento) != "votaciones") return;

        bool isChecked = (bool)(e.Value ?? false);
        if (!isChecked) return;

        if (!votoInfoPorCriterio.ContainsKey(idCriterio))
        {
            votoInfoPorCriterio[idCriterio] = new CriterioVotoInfoDto
            {
                IdCriterio = idCriterio,
                VotosRestantes = 3,
                HaVotado = false
            };
        }

        var info = votoInfoPorCriterio[idCriterio];

        if (info.HaVotado || info.VotosRestantes <= 0)
            return;

        var peticion = new
        {
            IdEvento = idEvento,
            IdProyecto = idProyecto,
            IdCriterio = idCriterio
        };

        var response = await ApiClient.PostAsJsonAsync("api/evento/proyecto/votar", peticion);

        if (response.IsSuccessStatusCode)
        {
            info.HaVotado = true;
            info.VotosRestantes = Math.Max(0, info.VotosRestantes - 1);
            errorMessage = "";
        }
        else
        {
            var errorContent = await response.Content.ReadAsStringAsync();
            errorMessage = "Error al emitir el voto: " + errorContent;
        }

        StateHasChanged();
    }

    private void ToggleCriterio(long idCriterio)
    {
        if (!criteriosAbiertos.Add(idCriterio))
            criteriosAbiertos.Remove(idCriterio);
    }

    private async Task EnviarComentario()
    {
        if (GetFaseClass(evento) != "votaciones") return;
        if (string.IsNullOrWhiteSpace(nuevoComentario) || proyecto == null) return;

        var peticion = new 
        {
            IdEvento = idEvento,
            IdProyecto = idProyecto,
            Comentario = nuevoComentario
        };

        var response = await ApiClient.PostAsJsonAsync("api/evento/proyecto/comentar", peticion);

        if (response.IsSuccessStatusCode)
        {
            comentarioEnviado = true;
        }
        else
        {
            Console.WriteLine("Error al enviar el comentario.");
        }
    }

    // Descarga — sin eval, usando el endpoint directamente
    private async Task DescargarProyecto()
    {
        if (proyecto != null && proyecto.TieneArchivo)
            await JS.InvokeVoidAsync("open", $"/api/evento/proyecto/{idProyecto}/descargar", "_blank");
    }

    private void VolverAtras()
    {
        Nav.NavigateTo($"/listaproyectos/{idEvento}");
    }

    private void ImagenAnterior()
    {
        if (proyecto?.Imagenes != null && proyecto.Imagenes.Any())
        {
            imagenActual--;
            if (imagenActual < 0) imagenActual = proyecto.Imagenes.Count - 1;
        }
    }

    private void ImagenSiguiente()
    {
        if (proyecto?.Imagenes != null && proyecto.Imagenes.Any())
        {
            imagenActual++;
            if (imagenActual >= proyecto.Imagenes.Count) imagenActual = 0;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_ultimoIdCargado == idProyecto) return;

        _ultimoIdCargado = idProyecto;

        proyecto = null;
        participantes = null;
        nuevoComentario = "";
        comentarioEnviado = false;
        votoEnviado = false;
        haVotado = false;
        votosTotalesEvento = 0;
        imagenActual = 0;
        errorMessage = "";
        criteriosCategoria = new();
        votoInfoPorCriterio = new();
        criteriosAbiertos = new();
        StateHasChanged();

        var correo = AuthProvider.ObtenerCorreo();
        if (string.IsNullOrWhiteSpace(correo) || !AuthProvider.EstaAutenticado)
        {
            // usuario no autenticado, volver al login
            Nav.NavigateTo("/");
            return;
        }

        try
        {
            var entrada = await ApiClient.GetFromJsonAsync<EntradaEventoRespuestaDto>($"api/evento/{idEvento}");
            if(entrada == null)
            {
                Nav.NavigateTo("/home");
                return;
            }
            evento = entrada.Evento;
            esVotante = entrada.Rol.EsVotante && !entrada.Rol.EsAdministrador
            && !entrada.Rol.EsJurado && !entrada.Rol.EsParticipante;

            proyecto = await ApiClient.GetFromJsonAsync<ProyectoDto>($"api/evento/proyecto/{idProyecto}");
            if(proyecto == null)
            {
                errorMessage = "No se pudo cargar el proyecto. Por favor, inténtalo de nuevo más tarde.";
                return;
            }
            participantes = await ApiClient.GetFromJsonAsync<List<MiembroGrupoDto>>($"api/evento/proyecto/{idProyecto}/grupo/{proyecto.IdGrupo}/participantes");
            var categorias = await ApiClient.GetFromJsonAsync<List<CategoriaDto>>($"api/evento/{idEvento}/categorias") ?? new();
            var grupoProyecto = await ApiClient.GetFromJsonAsync<GrupoDto>($"api/evento/grupo/{proyecto.IdGrupo}");

            if (grupoProyecto != null)
            {
                var categoriaProyecto = categorias.FirstOrDefault(c => c.Id == grupoProyecto.IdCategoria);
                criteriosCategoria = categoriaProyecto?.Criterios ?? new();

                if (criteriosCategoria.Any())
                {
                    criteriosAbiertos.Add(criteriosCategoria.First().Id);
                }
            }
            // Al solicitar el comentario, si no existe o devuelve NoContent(204), HttpClient lanzará una excepción o devolverá null
            try
            {
                var responseComentario = await ApiClient.GetAsync($"api/evento/proyecto/{idProyecto}/comentario/usuario");
                if (responseComentario.IsSuccessStatusCode && responseComentario.StatusCode != System.Net.HttpStatusCode.NoContent)
                {
                    // IMPORTANTE: Leemos con el ComentarioDto temporal en vez del Comentario de entidad EF.
                    var comentarioExistente = await responseComentario.Content.ReadFromJsonAsync<ComentarioDto>();
                    if (comentarioExistente != null && !string.IsNullOrWhiteSpace(comentarioExistente.Contenido))
                    {
                        nuevoComentario = comentarioExistente.Contenido;
                        comentarioEnviado = true;
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine("Error al obtener el comentario del usuario (o no existe): " + ex.Message);
            }

            if (esVotante)
            {
                try
                {
                    var responseVoto = await ApiClient.GetAsync($"api/evento/proyecto/{idProyecto}/evento/{idEvento}/voto-info");
                    if (responseVoto.IsSuccessStatusCode)
                    {
                        var infoCriterios = await responseVoto.Content.ReadFromJsonAsync<List<CriterioVotoInfoDto>>();

                        if (infoCriterios != null)
                        {
                            votoInfoPorCriterio = infoCriterios.ToDictionary(v => v.IdCriterio, v => v);
                        }
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine("Error al obtener la info del voto: " + ex.Message);
                }
            }

        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.ToString());
            proyecto = null;
        }
        finally
        {
            StateHasChanged();
        }

    }

    private string GetFaseClass(EventoDto ev)
    {
        var hoy = DateOnly.FromDateTime(DateTime.Now);
        if (hoy <= ev.FechaFinInscripciones) return "inscripciones";
        if (hoy <= ev.FechaFinEntrega) return "entregas";
        if (hoy <= ev.FechaFinVotaciones) return "votaciones";
        return "resultados";
    }
}
