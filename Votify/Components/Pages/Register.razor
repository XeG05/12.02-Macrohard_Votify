@page "/register"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject ApiClient ApiClient
@inject BlazorAuthStateProvider AuthProvider
@inject NavigationManager Nav
@layout NoLayout

<div class="layout">
    <h1>Votify</h1>

    <div class="input">
        <p>Nombre completo:</p>
        <input @bind="nombre" placeholder="Inserte su nombre y apellidos" />
    </div>
    <div class="input">
        <p>Correo electrónico:</p>
        <input @bind="correo" placeholder="Inserte su correo electrónico" />
    </div>
    <div class="input">
        <p>Contraseña:</p>
        <input @bind="contraseña" type="password" placeholder="Inserte su contraseña" />
    </div>
    <div class="input">
        <p>Repetir contraseña:</p>
        <input @bind="contraseña2" type="password" placeholder="Inserte su contraseña de nuevo" />
    </div>
    <div class="button">
        <button @onclick="register" disabled="@cargando">
            @(cargando ? "Registrando..." : "Registrarse")
        </button>
    </div>
    <p class="@(error ? "error" : "ok")">@mensaje</p>
    <div class="options">
        <NavLink href="/login">¿Ya tienes cuenta? Inicia sesión</NavLink>
    </div>
  
</div>

@code {

    string nombre = "";
    string correo = "";
    string contraseña = "";
    string contraseña2 = "";
    string mensaje = "Registro de ejemplo";
    bool error = false;
    bool cargando = false;


    async Task register()
    {
        bool navegarAHome = false;
        mensaje = "Intentando registrar";
        try
        {
            var response = await ApiClient.PostAnonymousAsync("api/usuario/register", new { Nombre = nombre, Correo = correo, Contraseña = contraseña, ConfirmarContraseña = contraseña2 });
            if (response.IsSuccessStatusCode)
            {
                var auth = await response.Content.ReadFromJsonAsync<AuthDto>();
                if(auth != null)
                {
                    await AuthProvider.MarcarAutenticado(auth.Token);
                    navegarAHome = true;
                }
            }
            else
            {
                mensaje = await ApiClient.LeerError(response);
                error = true;
            }
        }
        catch (Exception ex)
        {
            mensaje = ex.Message;
            error = true;
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
        if (navegarAHome)
            Nav.NavigateTo("/home");
    }
}
