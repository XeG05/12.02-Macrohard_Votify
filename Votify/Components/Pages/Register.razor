@page "/register"
@rendermode InteractiveServer
@inject I_Usuario_Service UsuarioService

<div class="layout">
    <h1>Votify</h1>

    <div class="input">
        <p>Nombre completo:</p>
        <input @bind="nombre" placeholder="Inserte su nombre y apellidos" />
    </div>
    <div class="input">
        <p>Correo electrónico:</p>
        <input @bind="correo" placeholder="Inserte su correo electrónico" />
    </div>
    <div class="input">
        <p>Contraseña:</p>
        <input @bind="contraseña" type="password" placeholder="Inserte su contraseña" />
    </div>
    <div class="input">
        <p>Repetir contraseña:</p>
        <input @bind="contraseña2" placeholder="Inserte su contraseña de nuevo" />
    </div>
    <div class="button">
        <button @onclick="register">Registrarse</button>
    </div>
    <p>@mensaje</p>
    <div class="options">
        <NavLink href="/login">¿Ya tienes cuenta? Inicia sesión</NavLink>
    </div>
  
</div>

@code {

    string nombre = "";
    string correo = "";
    string contraseña = "";
    string contraseña2 = "";
    string mensaje = "Registro de ejemplo";


    async Task register()
    {
        
        mensaje = "Intentando registrar";
        try
        {
            await UsuarioService.Register(nombre, correo, contraseña, contraseña2);
            mensaje = "Usuario creado";
        }
        catch (Exception ex)
        {
            mensaje = ex.Message;
        }
    }
}
