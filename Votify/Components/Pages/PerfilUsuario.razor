@page "/perfilusuario"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject ApiClient ApiClient
@inject BlazorAuthStateProvider AuthProvider
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject ToastService Toasts

<link rel="stylesheet" href="css/perfil-usuario.css" />

<div class="perfil-contenedor">

    <div class="perfil-imagen">
        <div class="placeholder-imagen">
            @if (!string.IsNullOrEmpty(imagenPerfilBase64))
            {
                <img src="data:image/jpeg;base64,@imagenPerfilBase64" class="perfil-img-elemento" alt="Imagen de perfil" />
            }
            else
            {
                <svg class="icono-imagen" width="80" height="80" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 12C14.7614 12 17 9.76142 17 7C17 4.23858 14.7614 2 12 2C9.23858 2 7 4.23858 7 7C7 9.76142 9.23858 12 12 12Z" fill="#9a9a9a" />
                    <path d="M19.2101 15.74C17.6534 14.3725 15.5492 13.5 12.0001 13.5C8.45095 13.5 6.34673 14.3725 4.79007 15.74C3.21447 17.124 2.45508 19.068 2.47352 21.05C2.47648 21.365 2.70997 21.611 3.01834 21.611H20.9818C21.2902 21.611 21.5236 21.365 21.5266 21.05C21.545 19.068 20.7857 17.124 19.2101 15.74Z" fill="#9a9a9a" />
                </svg>
            }
        </div>
        @if (editando)
        {
            <div class="botones-imagen-edicion">
                <div class="btn-cambiar-imagen">
                    <label for="upload-imagen" class="btn-cambiar-imagen-label">Cambiar Imagen</label>
                    <InputFile id="upload-imagen" OnChange="OnImagenSeleccionada" accept="image/jpeg, image/png" style="display: none;" />
                </div>

                @if (!string.IsNullOrEmpty(imagenPerfilBase64) || archivoImagen != null)
                {
                    <button class="btn-eliminar-imagen-pequeno" @onclick="ConfirmarEliminarImagen" title="Eliminar imagen">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 6h18"></path>
                            <path d="M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"></path>
                        </svg>
                        Quitar
                    </button>
                }
            </div>
            @if (nombreImagenSeleccionada != null)
            {
                <span class="nombre-archivo-imagen">@nombreImagenSeleccionada</span>
            }
        }
    </div>

    <div class="perfil-formulario">

        <div class="campo">
            <label>Nombre de usuario:</label>
            <input @bind="nombre"
                   @bind:event="oninput"
                   disabled="@(!editando)"
                   class="input-perfil" />
        </div>

        <div class="campo">
            <label>Correo electrónico:</label>
            <input value="@correo"
                   disabled
                   class="input-perfil input-bloqueado" />
        </div>

        @if (editando)
        {
            <div class="campo">
                <label>Nueva contraseña:</label>
                <input @bind="nuevaContraseña"
                       @bind:event="oninput"
                       type="password"
                       class="input-perfil" />
            </div>

            <div class="campo">
                <label>Repetir contraseña:</label>
                <input @bind="repetirContraseña"
                       @bind:event="oninput"
                       type="password"
                       class="input-perfil" />
            </div>

            <div class="botones-edicion">
                <button class="btn-primario" @onclick="GuardarCambios" 
                        disabled="@(cargando || (nombre == nombreOriginal && string.IsNullOrWhiteSpace(nuevaContraseña) && archivoImagen == null && !quitarImagen))">
                    @(cargando ? "Guardando..." : "Confirmar cambios")
                </button>

                <button class="btn-secundario" @onclick="CancelarEdicion" disabled="@cargando">
                    Cancelar
                </button>
            </div>
        }

    </div>

    @if (!editando)
    {
        <div class="perfil-botones-acciones">
            <button class="btn-primario" @onclick="ActivarEdicion">Editar perfil</button>
            <button class="btn-peligro" @onclick="ConfirmarCerrarSesion">Cerrar sesión</button>
        </div>
    }

</div>

@if (mostrarModalLogout)
{
    <div class="modal-overlay">
        <div class="modal-contenido">
            <h3>Cerrar sesión</h3>
            <p>¿Estás seguro de que deseas salir de tu cuenta?</p>
            <div class="modal-botones">
                <button class="btn-secundario" @onclick="CancelarCerrarSesion">Cancelar</button>
                <button class="btn-peligro" @onclick="EjecutarCerrarSesion">Sí, cerrar sesión</button>
            </div>
        </div>
    </div>
}

@if (mostrarModalEliminarImagen)
{
    <div class="modal-overlay">
        <div class="modal-contenido">
            <h3>Quitar imagen</h3>
            <p>¿Estás seguro de que deseas quitar tu imagen de perfil?</p>
            <div class="modal-botones">
                <button class="btn-secundario" @onclick="CancelarEliminarImagen">Cancelar</button>
                <button class="btn-peligro" @onclick="EjecutarEliminarImagen">Quitar imagen</button>
            </div>
        </div>
    </div>
}

@code {
    private string nombre = "";
    private string nombreOriginal = "";
    private string correo = "";
    private string? imagenPerfilBase64 = null;
    private string? imagenPerfilBase64Original = null;
    private IBrowserFile? archivoImagen = null;
    private string? nombreImagenSeleccionada = null;
    private bool quitarImagen = false;

    private string nuevaContraseña = "";
    private string repetirContraseña = "";

    private string mensaje = "";
    private bool error = false;
    private bool editando = false;
    private bool cargando = false;
    private bool mostrarModalLogout = false;
    private bool mostrarModalEliminarImagen = false;

    private void ConfirmarCerrarSesion()
    {
        mostrarModalLogout = true;
    }

    private void CancelarCerrarSesion()
    {
        mostrarModalLogout = false;
    }

    private async Task EjecutarCerrarSesion()
    {
        mostrarModalLogout = false;
        await AuthProvider.MarcarDesconectado();
        NavigationManager.NavigateTo("/", forceLoad: true);
    }

    private void ConfirmarEliminarImagen()
    {
        mostrarModalEliminarImagen = true;
    }

    private void CancelarEliminarImagen()
    {
        mostrarModalEliminarImagen = false;
    }

    private void EjecutarEliminarImagen()
    {
        mostrarModalEliminarImagen = false;
        quitarImagen = true;
        archivoImagen = null;
        nombreImagenSeleccionada = null;
        imagenPerfilBase64 = null; 
    }

    protected override async Task OnInitializedAsync()
    {
        await CargarPerfil();
    }

    private async Task CargarPerfil()
    {
        try
        {
            var perfil = await ApiClient.GetFromJsonAsync<PerfilUsuarioDto>("api/usuario/perfil");

            if (perfil != null)
            {
                nombre = perfil.Nombre;
                nombreOriginal = perfil.Nombre;
                correo = perfil.Correo;
                imagenPerfilBase64 = perfil.ImagenBase64;
                imagenPerfilBase64Original = perfil.ImagenBase64;
            }
        }
        catch (Exception ex)
        {
            error = true;
            mensaje = ex.Message;
        }
    }

    private void ActivarEdicion()
    {
        editando = true;
        mensaje = "";
        error = false;
        nuevaContraseña = "";
        repetirContraseña = "";
        quitarImagen = false;
    }

    private void CancelarEdicion()
    {
        editando = false;
        nombre = nombreOriginal;
        nuevaContraseña = "";
        repetirContraseña = "";
        archivoImagen = null;
        nombreImagenSeleccionada = null;
        quitarImagen = false;
        imagenPerfilBase64 = imagenPerfilBase64Original;
        mensaje = "";
        error = false;
    }

    private void OnImagenSeleccionada(InputFileChangeEventArgs e)
    {
        archivoImagen = e.File;
        nombreImagenSeleccionada = e.File.Name;
        quitarImagen = false;
    }

    private async Task GuardarCambios()
    {
        mensaje = "";
        error = false;

        if (string.IsNullOrWhiteSpace(nombre))
        {
            error = true;
            mensaje = "El nombre no puede estar vacío";
            return;
        }

        bool quiereCambiarContraseña =
            !string.IsNullOrWhiteSpace(nuevaContraseña) ||
            !string.IsNullOrWhiteSpace(repetirContraseña);

        if (quiereCambiarContraseña)
        {
            if (string.IsNullOrWhiteSpace(nuevaContraseña) ||
                string.IsNullOrWhiteSpace(repetirContraseña))
            {
                error = true;
                mensaje = "Debes rellenar los dos campos de contraseña";
                return;
            }

            if (nuevaContraseña != repetirContraseña)
            {
                error = true;
                mensaje = "Las contraseñas no coinciden";
                return;
            }
        }

        cargando = true;
        var loadingId = Toasts.ShowLoading("Guardando perfil...");

        try
        {
            var content = new MultipartFormDataContent();
            content.Add(new StringContent(nombre), "Nombre");

            if (!string.IsNullOrWhiteSpace(nuevaContraseña))
            {
                content.Add(new StringContent(nuevaContraseña), "NuevaContraseña");
                content.Add(new StringContent(repetirContraseña), "RepetirContraseña");
            }

            content.Add(new StringContent(quitarImagen.ToString()), "EliminarImagen");

            if (archivoImagen != null)
            {
                var maxFileSize = 10 * 1024 * 1024;
                var ms = new MemoryStream();
                using var stream = archivoImagen.OpenReadStream(maxFileSize);
                await stream.CopyToAsync(ms);
                ms.Position = 0;
                content.Add(new StreamContent(ms), "Imagen", archivoImagen.Name);
            }

            // IMPORTANTE Cambiar a ApiClient o Http normal, según la implementación, pero `PutAsync` con form data.
            // Para simplicidad usamos PostMultipartAsync si existe, o httpClient directamente.
            var response = await ApiClient.PutMultipartAsync("api/usuario/perfil", content);

            if (response.IsSuccessStatusCode)
            {
                var auth = await response.Content.ReadFromJsonAsync<AuthDto>();

                if (auth != null)
                {
                    await AuthProvider.MarcarAutenticado(auth.Token);
                    imagenPerfilBase64 = auth.ImagenBase64;
                    imagenPerfilBase64Original = auth.ImagenBase64;
                }

                nombreOriginal = nombre;
                nuevaContraseña = "";
                repetirContraseña = "";
                archivoImagen = null;
                nombreImagenSeleccionada = null;
                quitarImagen = false;
                editando = false;

                error = false;
                mensaje = "Perfil actualizado correctamente";
                Toasts.ShowSuccess(mensaje);
            }
            else
            {
                error = true;
                mensaje = await ApiClient.LeerError(response);
                Toasts.ShowError(mensaje);
            }
        }
        catch (Exception ex)
        {
            error = true;
            mensaje = ex.Message;
            Toasts.ShowError($"Error al guardar el perfil: {ex.Message}");
        }
        finally
        {
            Toasts.Dismiss(loadingId);
            cargando = false;
        }
    }

    public class PerfilUsuarioDto
    {
        public string Nombre { get; set; } = string.Empty;
        public string Correo { get; set; } = string.Empty;
        public string? ImagenBase64 { get; set; }
    }

    public class AuthDto
    {
        public string Token { get; set; } = string.Empty;
        public string Nombre { get; set; } = string.Empty;
        public string Correo { get; set; } = string.Empty;
        public string? ImagenBase64 { get; set; }
    }
}