@page "/EventCreator"
@rendermode InteractiveServer
@inject I_Evento_Service EventoService
@inject AuthenticationStateProvider AuthStateProvider
@inject BlazorAuthStateProvider AuthProvider
@inject NavigationManager Nav
 
@if (!autenticado)
{
    <p>Verificando sesión...</p>
}
else
{
    <div class="main-container">
        <h3>Crear Evento</h3>
        <hr />
        <div class="basic-info">
            <div>
                <h6>Nombre del evento:</h6>
                <input class="input" type="text" placeholder="Máximo 30 caracteres" @bind="dto.Nombre" maxlength="30" />
                <small>@dto.Nombre.Length / 30</small>
            </div>
            <div>
                <h6>Descripción breve:</h6>
                <input class="input" type="text" placeholder="Máximo 120 caracteres" @bind="dto.Descripcion" maxlength="120" />
                <small>@dto.Descripcion.Length / 120</small>
            </div>
        </div>

        <div class="time-container">
            <h4>Periodos</h4>
            <hr />
            <div>
                <h6>Fin de inscripciones:</h6>
                <input type="date" @bind="fechaFinInscripciones" @bind:format="yyyy-MM-dd" />
            </div>
            <div>
                <h6>Fin de entrega / inicio de votaciones:</h6>
                <input type="date" @bind="fechaFinEntrega" @bind:format="yyyy-MM-dd" />
            </div>
            <div>
                <h6>Fin de votaciones:</h6>
                <input type="date" @bind="fechaFinVotaciones" @bind:format="yyyy-MM-dd" />
            </div>
        </div>
        <div class="opciones">
            <h4>Opciones</h4>
            <hr />
            <div class="num-participantes">
                <p>Número de participantes por grupo:</p>
                <input type="number" min="1" max="4"
                       @bind="dto.NumParticipantes" />
            </div>
            <div>
                <input type="checkbox" @bind="dto.GruposCompletos" />
                <p>Los grupos han de estar completos</p>
            </div>
        </div>

        <div class="categorias">
            <h4>Categorías</h4>
            <hr />
            @foreach (var cat in dto.Categorias)
            {
                <div class="categoria-container" @key="cat">
                    <div class="categorias">
                        <input type="text" placeholder="Nombre categoría"
                               @bind="cat.Nombre" />
                        <input type="text" placeholder="Descripción"
                               @bind="cat.Descripcion" />
                        <div Class="votos">
                            <label>
                                Voto popular %
                                <input type="number" min="0" max="100"
                                       @bind="cat.PonderacionPopular" style="width:70px;" />
                            </label>
                            <label>
                                Voto experto %
                                <input type="number" min="0" max="100"
                                       @bind="cat.PonderacionExperto" style="width:70px;" />
                            </label>
                        </div>
                        @foreach (var crit in cat.Criterios)
                        {
                            <div class="criterios" @key="crit">
                                <input type="text" placeholder="Nombre criterio"
                                       @bind="crit.Nombre" />
                                <input type="text" placeholder="Descripción"
                                       @bind="crit.Descripcion" />
                                <input type="number" min="0" max="100" placeholder="Pond %"
                                       @bind="crit.Ponderacion" style="width:70px;" />
                                <button type="button" @onclick="() => EliminarCriterio(cat, crit)">✕</button>
                            </div>
                        }
                        <button type="button" @onclick="() => AñadirCriterio(cat)"
                                style="width:fit-content;margin-left:16px;">
                            + Añadir criterio
                        </button>
                        <div class="participantes">
                            <h4>Grupos y participantes</h4>
                            <hr />
                            @foreach (var grupo in cat.Grupos)   @* ← cat.Grupos, no dto.Grupos *@
                            {
                                <div class="grup-container" @key="grupo">
                                    <div class="grup-sup">
                                        <input type="text" placeholder="Nombre del grupo"
                                               @bind="grupo.Nombre" />
                                        <button type="button"
                                                @onclick="() => EliminarGrupo(cat, grupo)">
                                            ✕
                                        </button>
                                    </div>
                                    <hr />
                                    @for (int i = 0; i < grupo.CorreosParticipantes.Count; i++)
                                    {
                                        var idx = i;
                                        <div class="participante">
                                            <input type="text"
                                                   placeholder="correo@ejemplo.com"
                                                   value="@grupo.CorreosParticipantes[idx]"
                                                   @onchange="e => grupo.CorreosParticipantes[idx] =
                                                                               e.Value?.ToString() ?? string.Empty" />
</div>
                                    }
                                </div>
                            }
                            <button type="button"
                                    @onclick="() => AñadirGrupo(cat)">
                                + Añadir Grupo
                            </button>
                        </div>
                    </div>
                    <button type="button" @onclick="() => EliminarCategoria(cat)">✕</button>
                </div>
            }
            <button type="button" @onclick="AñadirCategoria">+ Añadir Categoría</button>
        </div>

        @if (!string.IsNullOrEmpty(mensaje))
        {
            <p class="@(error ? "msg-error" : "msg-ok")">@mensaje</p>
        }
        
        <hr />
        <div class="actions">
            <button type="button" @onclick="Guardar" disabled="@cargando">
                @(cargando ? "Guardando..." : "Guardar borrador")
            </button>
            <button type="button" @onclick="Publicar" disabled="@cargando">
                Publicar Evento
            </button>
        </div>
    </div>
}

@code {
    bool autenticado = false;
    private EventoCreacionDto dto = new()
    {
        TieneGrupos = true
    };
    private DateTime? fechaFinInscripciones;
    private DateTime? fechaFinEntrega;
    private DateTime? fechaFinVotaciones;
    private string mensaje = "";
    private bool error = false;
    private bool cargando = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();

        if (!authState.User.Identity?.IsAuthenticated ?? true)
        {
            Nav.NavigateTo("/login");
            return;
        }

        autenticado = true;
        StateHasChanged();
    }

    private void AñadirCategoria()
    {
        dto.Categorias.Add(new CategoriaCreacionDto());
    }

    private void EliminarCategoria(CategoriaCreacionDto cat)
    {
        dto.Categorias.Remove(cat);
    }

    private void AñadirCriterio(CategoriaCreacionDto cat)
    {
        cat.Criterios.Add(new CriterioCreacionDto());
    }

    private void EliminarCriterio(CategoriaCreacionDto cat, CriterioCreacionDto crit)
    {
        cat.Criterios.Remove(crit);
    }

    private void AñadirGrupo(CategoriaCreacionDto cat)
    {
        cat.Grupos.Add(new GrupoCreacionDto
        {
            CorreosParticipantes = Enumerable
                .Repeat(string.Empty, dto.NumParticipantes)
                .ToList()
        });
    }

    private void EliminarGrupo(CategoriaCreacionDto cat, GrupoCreacionDto grupo)
    {
        cat.Grupos.Remove(grupo);
    }

    private void SincronizarFechas()
    {
        dto.FechaFinInscripciones = fechaFinInscripciones.HasValue
            ? DateOnly.FromDateTime(fechaFinInscripciones.Value) : null;
 
        dto.FechaFinEntrega = fechaFinEntrega.HasValue
            ? DateOnly.FromDateTime(fechaFinEntrega.Value) : null;
 
        dto.FechaFinVotaciones = fechaFinVotaciones.HasValue
            ? DateOnly.FromDateTime(fechaFinVotaciones.Value) : null;
    }
 
    private async Task Guardar()
    {
        SincronizarFechas();
        await EjecutarCreacion(publicar: false);
    }
 
    private async Task Publicar()
    {
        SincronizarFechas();
        await EjecutarCreacion(publicar: true);
    }
 
    private async Task EjecutarCreacion(bool publicar)
    {
        cargando = true;
        mensaje = "";
        error = false;

        try
        {
            var correo = AuthProvider.ObtenerCorreo()!;
            var evento = await EventoService.CrearEvento(correo, dto);

            mensaje = publicar
                ? $"¡Evento '{evento.Nombre}' publicado con éxito!"
                : $"Borrador '{evento.Nombre}' guardado";

            Nav.NavigateTo($"/evento-creado/{evento.Id}");
        }
        catch (Exception ex)
        {
            mensaje = ex.Message;
            error = true;
        }
        finally
        {
            cargando = false;
        }
    }
}