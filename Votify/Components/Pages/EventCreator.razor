@page "/EventCreator"
@rendermode InteractiveServer
@inject ApiClient ApiClient
@inject BlazorAuthStateProvider AuthProvider
@inject NavigationManager Nav
 
@if (!autenticado)
{
    <p>Verificando sesión...</p>
}
else
{
    <div class="main-container">
        <h3>Crear Evento</h3>
        <hr />
        <div class="basic-info">
            <div>
                <h6>Nombre del evento:</h6>
                <input class="input" type="text" placeholder="Máximo 30 caracteres" @bind="dto.Nombre" maxlength="30" />
                <small>@dto.Nombre.Length / 30</small>
            </div>
            <div>
                <h6>Descripción breve:</h6>
                <input class="input" type="text" placeholder="Máximo 120 caracteres" @bind="dto.Descripcion" maxlength="120" />
                <small>@dto.Descripcion.Length / 120</small>
            </div>
        </div>

        <div class="time-container">
            <h4>Periodos</h4>
            <hr />
            <div>
                <h6>Fin de inscripciones:</h6>
                <input type="date" @bind="fechaFinInscripciones" @bind:format="yyyy-MM-dd" />
            </div>
            <div>
                <h6>Fin de entrega / inicio de votaciones:</h6>
                <input type="date" @bind="fechaFinEntrega" @bind:format="yyyy-MM-dd" />
            </div>
            <div>
                <h6>Fin de votaciones:</h6>
                <input type="date" @bind="fechaFinVotaciones" @bind:format="yyyy-MM-dd" />
            </div>
            <div>
                <h6>Fin de evaluación experta:</h6>
                <input type="date" @bind="fechaFinExperta" @bind:format="yyyy-MM-dd" />
            </div>
        </div>
        <div class="opcionesVotacion">
            <h4>Votaciones</h4>
            <hr/>
            <div>
                <div id="partvotar">
                    <input type="checkbox" @bind="dto.ParticipantesVotan"/>
                    <p>Los participantes pueden votar</p>
                </div>
                <div>
                    <p>Comentarios de los votantes</p>
                    <div class="radio-opcion">
                        <input type="radio" name="comentarios"
                               checked="@(dto.TipoComentario == TipoComentario.SinComentarios)"
                               @onchange="@(() => dto.TipoComentario = TipoComentario.SinComentarios)" />
                        <p>Sin comentarios</p>
                    </div>
                    <div class="radio-opcion">
                        <input type="radio" name="comentarios"
                               checked="@(dto.TipoComentario == TipoComentario.Opcional)"
                               @onchange="@(() => dto.TipoComentario = TipoComentario.Opcional)" />
                        <p>Comentarios opcionales</p>
                    </div>
                    <div class="radio-opcion">
                        <input type="radio" name="comentarios"
                               checked="@(dto.TipoComentario == TipoComentario.Obligatorio)"
                               @onchange="@(() => dto.TipoComentario = TipoComentario.Obligatorio)" />
                        <p>Comentarios obligatorios con el voto</p>
                    </div>
                </div>
                <div>
                    <p>Tipo de votación (por Criterio)</p>
                    <div class="radio-opcion">
                        <input type="radio" name="votos"
                               checked="@(dto.TipoVotacion == TipoVotacion.Nota)"
                               @onchange="@(() => dto.TipoVotacion = TipoVotacion.Nota)" />
                        <p>Calificar con nota (de 1 a 10)</p>
                    </div>
                    <div class="radio-opcion">
                        <input type="radio" name="votos"
                               checked="@(dto.TipoVotacion == TipoVotacion.Simple)"
                               @onchange="@(() => dto.TipoVotacion = TipoVotacion.Simple)" />
                        <p>Voto simple: votar X proyectos</p>
                        <input type="number" min="1" max="100" @bind="dto.NumVotarProyectos" disabled="@(dto.TipoVotacion != TipoVotacion.Simple)" />
                    </div>
                    <div class="radio-opcion">
                        <input type="radio" name="votos"
                               checked="@(dto.TipoVotacion == TipoVotacion.Puntos)"
                               @onchange="@(() => dto.TipoVotacion = TipoVotacion.Puntos)" />
                        <p>Repartir X puntos entre los criterios</p>
                        <input type="number" min="1" max="10000" @bind="dto.PuntosARepartir" disabled="@(dto.TipoVotacion != TipoVotacion.Puntos)" />
                    </div>
                </div>
            </div>
        </div>
        <div class="opciones">
            <h4>Opciones de grupo</h4>
            <hr />
            <div class="num-participantes">
                <p>Número de participantes por grupo:</p>
                <input type="number" min="1" max="4"
                       @bind="dto.NumParticipantes" />
            </div>
            <div>
                <input type="checkbox" @bind="dto.GruposCompletos" />
                <p>Los grupos han de estar completos</p>
            </div>
        </div>

        <div class="categorias">
            <h4>Categorías</h4>
            <hr />
            @foreach (var cat in dto.Categorias)
            {
                <div class="categoria-container" @key="cat">
                    <div class="categorias">
                        <input type="text" placeholder="Nombre categoría"
                               @bind="cat.Nombre" />
                        <input type="text" placeholder="Descripción"
                               @bind="cat.Descripcion" />
                        <div Class="votos">
                            <label>
                                Voto popular %
                                <input type="number" min="0" max="100"
                                       @bind="cat.PonderacionPopular" style="width:70px;" />
                            </label>
                            <label>
                                Voto experto %
                                <input type="number" min="0" max="100"
                                       @bind="cat.PonderacionExperto" style="width:70px;" />
                            </label>
                            <label>
                                Evaluación de criterios %
                                <span style="margin-left:8px; color:#666;">
                                    Los criterios deben sumar 100%
                                </span>
                            </label>
                        </div>
                        @foreach (var crit in cat.Criterios)
                        {
                            <div class="criterios" @key="crit">
                                <input type="text" placeholder="Nombre criterio"
                                       @bind="crit.Nombre" />
                                <input type="text" placeholder="Descripción"
                                       @bind="crit.Descripcion" />
                                <input type="number"
                                       min="0"
                                       max="100"
                                       placeholder="Pond %"
                                       @bind="crit.Ponderacion"
                                       style="width:70px;" />
                                <span>%</span>
                                <button type="button" @onclick="() => EliminarCriterio(cat, crit)">✕</button>
                            </div>
                        }
                        <button type="button" @onclick="() => AñadirCriterio(cat)"
                                style="width:fit-content;margin-left:16px;">
                            + Añadir criterio
                        </button>
                        <div class="participantes">
                            <h4>Grupos y participantes</h4>
                            <hr />
                            @foreach (var grupo in cat.Grupos)
                            {
                                <div class="grup-container" @key="grupo">
                                    <div class="grup-sup">
                                        <input type="text" placeholder="Nombre del grupo"
                                               @bind="grupo.Nombre" />
                                        <button type="button"
                                                @onclick="() => EliminarGrupo(cat, grupo)">
                                            ✕
                                        </button>
                                    </div>
                                    <hr />
                                    @for (int i = 0; i < grupo.CorreosParticipantes.Count; i++)
                                    {
                                        var idx = i;
                                        <div class="participante">
                                            <input type="text"
                                                   placeholder="correo@ejemplo.com"
                                                   value="@grupo.CorreosParticipantes[idx]"
                                                   @onchange="e => grupo.CorreosParticipantes[idx] =
                                                                               e.Value?.ToString() ?? string.Empty" />
                                        </div>
                                    }
                                </div>
                            }
                            <button type="button" @onclick="() => AñadirGrupo(cat)">
                                + Añadir Grupo
                            </button>
                        </div>
                        <div class="jurados-categoria">
                            <h4>Jurados</h4>
                            <hr />
                            @for (int i = 0; i < cat.CorreosJurados.Count; i++)
                            {
                                var idx = i;
                                <div class="participante">
                                    <input type="text"
                                           placeholder="correo@jurado.com"
                                           value="@cat.CorreosJurados[idx]"
                                           @onchange="e => cat.CorreosJurados[idx] = e.Value?.ToString() ?? string.Empty" />
                                    <button type="button" @onclick="() => EliminarJurado(cat, idx)">✕</button>
                                </div>
                            }
                            <button type="button" @onclick="() => AñadirJurado(cat)">
                                + Añadir Jurado
                            </button>
                        </div>
                    </div>
                    <button type="button" @onclick="() => EliminarCategoria(cat)">✕</button>
                </div>
            }
            <button type="button" @onclick="AñadirCategoria">+ Añadir Categoría</button>
        </div>

        @if (!string.IsNullOrEmpty(mensaje))
        {
            <p class="@(error ? "msg-error" : "msg-ok")" style="color:red">@mensaje</p>
        }
        
        <hr />
        <div class="actions">
            <button type="button" @onclick="Guardar" disabled="@cargando">
                @(cargando ? "Guardando..." : "Guardar borrador")
            </button>
            <button type="button" @onclick="Publicar" disabled="@cargando">
                Publicar Evento
            </button>
        </div>
    </div>
}

@code {
    bool autenticado = false;
    private EventoCreacionDto dto = new()
    {
        TieneGrupos = true
    };
    private DateTime? fechaFinInscripciones;
    private DateTime? fechaFinEntrega;
    private DateTime? fechaFinVotaciones;
    private DateTime? fechaFinExperta;
    private DateTime? fechaFinVotExperta;

    private string mensaje = "";
    private bool error = false;
    private bool cargando = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var authState = await AuthProvider.GetAuthenticationStateAsync();

        if (!authState.User.Identity?.IsAuthenticated ?? true)
        {
            Nav.NavigateTo("/login");
            return;
        }

        autenticado = true;
        StateHasChanged();
    }

    private void AñadirCategoria()
    {
        dto.Categorias.Add(new CategoriaDto
        {
            CriteriosSonPorcentaje = true
        });
    }

    private void EliminarCategoria(CategoriaDto cat)
    {
        dto.Categorias.Remove(cat);
    }

    private void AñadirCriterio(CategoriaDto cat)
    {
        cat.CriteriosSonPorcentaje = true;
        cat.Criterios.Add(new CriterioDto());
    }

    private void EliminarCriterio(CategoriaDto cat, CriterioDto crit)
    {
        cat.Criterios.Remove(crit);
    }

    private void AñadirGrupo(CategoriaDto cat)
    {
        cat.Grupos.Add(new GrupoDto
        {
            CorreosParticipantes = Enumerable
                .Repeat(string.Empty, dto.NumParticipantes)
                .ToList()
        });
    }

    private void EliminarGrupo(CategoriaDto cat, GrupoDto grupo)
    {
        cat.Grupos.Remove(grupo);
    }
    
    private void AñadirJurado(CategoriaDto cat)
    {
        cat.CorreosJurados.Add(string.Empty);
    }

    private void EliminarJurado(CategoriaDto cat, int idx)
    {
        cat.CorreosJurados.RemoveAt(idx);
    }

    private void SincronizarFechas()
    {
        dto.FechaFinInscripciones = fechaFinInscripciones.HasValue
            ? DateOnly.FromDateTime(fechaFinInscripciones.Value) : null;

        dto.FechaFinEntrega = fechaFinEntrega.HasValue
            ? DateOnly.FromDateTime(fechaFinEntrega.Value) : null;

        dto.FechaFinVotaciones = fechaFinVotaciones.HasValue
            ? DateOnly.FromDateTime(fechaFinVotaciones.Value) : null;

        dto.FechaFinExperta = fechaFinExperta.HasValue
            ? DateOnly.FromDateTime(fechaFinExperta.Value) : null;

        dto.FechaFinVotExperta = fechaFinVotExperta.HasValue
            ? DateOnly.FromDateTime(fechaFinVotExperta.Value) : null;
    }

    private async Task Guardar()
    {
        SincronizarFechas();
        await EjecutarCreacion(publicar: false);
    }

    private async Task Publicar()
    {
        SincronizarFechas();
        await EjecutarCreacion(publicar: true);
    }

    private async Task EjecutarCreacion(bool publicar)
    {
        try
        {
            cargando = true;
            mensaje = "";
            error = false;

            if (dto.Categorias.Count == 0)
            {
                mensaje = "Debe añadirse al menos una categoría al evento.";
                error = true;
                return;
            }

            if (dto.Categorias.Any(cat => cat.Grupos.Count == 0))
            {
                mensaje = "Cada categoría debe tener al menos un grupo.";
                error = true;
                return;
            }

            if(dto.GruposCompletos)
            {
                foreach (var cat in dto.Categorias)
                {
                    foreach (var grupo in cat.Grupos)
                    {
                        if (grupo.CorreosParticipantes.Any(c => string.IsNullOrWhiteSpace(c)))
                        {
                            mensaje = "Se requiere que los grupos estén completos, no puede haber participantes sin correo asignado.";
                            error = true;
                            return;
                        }
                    }
                }
            }

            var correo = AuthProvider.ObtenerCorreo()!;

            // No se puede añadir a uno mismo como participante
            var todosLosCorreos = dto.Categorias
                .SelectMany(cat => cat.Grupos)
                .SelectMany(g => g.CorreosParticipantes)
                .Where(c => !string.IsNullOrWhiteSpace(c));

            if (todosLosCorreos.Any(c => c.Trim().Equals(correo, StringComparison.OrdinalIgnoreCase)))
            {
                mensaje = "No puedes añadirte a ti mismo como participante.";
                error = true;
                return;
            }

            var response = await ApiClient.PostAsJsonAsync<EventoCreacionDto>("api/evento", dto);
            if (response.IsSuccessStatusCode)
            {
                var evento = await response.Content.ReadFromJsonAsync<EventoDto>();
                if(evento == null)
                {
                    mensaje = "Evento creado pero no se pudo obtener su información.";
                    error = true;
                    return;
                }
                Nav.NavigateTo($"/eventoadmin/{evento.Id}");
            }
            else
            {
                var error = await response.Content.ReadFromJsonAsync<ErrorDto>();
                mensaje = error?.Error ?? "Error desconocido al crear el evento.";
            }
        }
        catch (Exception ex)
        {
            mensaje = ex.Message;
            error = true;
        }
        finally
        {
            cargando = false;
        }
    }
}