@page "/aceptar-invitacion/{Token}"
@rendermode InteractiveServer
@layout NoLayout
@inject ApiClient ApiClient
@inject BlazorAuthStateProvider AuthProvider
@inject NavigationManager Nav



@if (cargando)
{
    <p>Verificando invitación...</p>
}
else if (invitacion == null)
{
    <p>Esta invitación no es válida o ha caducado.</p>
}
else if (invitacion.Aceptada)
{
    <p>Esta invitación ya fue aceptada.</p>
}
else if (aceptada)
{
    <p>¡Bienvenido! Redirigiendo...</p>
}
else
{
    <div class="layout">
        <h1>Votify</h1>
        <p>Has sido invitado al evento <strong>@nombreEvento</strong>.</p>

        @if (usuarioExiste)
        {
            <p>Inicia sesión para confirmar tu participación:</p>
            <div class="input">
                <p>Contraseña:</p>
                <input @bind="contraseña" type="password"
                       placeholder="Introduce tu contraseña" />
            </div>
        }
        else
        {
            <p>Crea tu cuenta para unirte:</p>
            <div class="input">
                <p>Nombre:</p>
                <input @bind="nombre" placeholder="Tu nombre completo" />
            </div>
            <div class="input">
                <p>Contraseña:</p>
                <input @bind="contraseña" type="password" />
            </div>
            <div class="input">
                <p>Repite contraseña:</p>
                <input @bind="contraseña2" type="password" />
            </div>
        }

        <div class="input">
            <p>Correo:</p>
            <input value="@invitacion.CorreoDestino" disabled />
        </div>

        @if (!string.IsNullOrEmpty(error))
        {
            <p style="color:red">@error</p>
        }

        <div class="button">
            <button @onclick="Aceptar">
                @(usuarioExiste ? "Confirmar participación" : "Crear cuenta y unirme")
            </button>
        </div>
    </div>
}

@code {
    [Parameter] public string Token { get; set; } = "";

    InvitacionPendiente? invitacion;
    string nombreEvento = "";
    bool cargando = true;
    bool aceptada = false;
    bool usuarioExiste = false;
    string error = "";

    string nombre = "";
    string contraseña = "";
    string contraseña2 = "";

    protected override async Task OnInitializedAsync()
    {
        var lista = await ApiClient.GetFromJsonAsync<List<InvitacionPendiente>>($"api/invitacion?token={Token}&aceptada=false&fechaExpiracion>{DateTime.UtcNow}");
        if(lista == null || !lista.Any())
        {
            cargando = false;
            return;
        }
        invitacion = lista.FirstOrDefault();

        if (invitacion != null)
        {
            var evento = await ApiClient.GetFromJsonAsync<Evento>($"api/evento/{invitacion.IdEvento}");
            nombreEvento = evento?.Nombre ?? "";

            // Comprobar si ya tiene cuenta
            var usuarios = await ApiClient.GetFromJsonAsync<List<Usuario>>($"api/usuario?correo={invitacion.CorreoDestino}");
            if(usuarios == null)
                usuarios = new List<Usuario>();
            usuarioExiste = usuarios.Any();
        }

        cargando = false;
    }

    async Task Aceptar()
    {
        try
        {
            var jwt = await ApiClient.PostAnonymousAsync("api/invitacion/aceptar", new { Token, contraseña, nombre, contraseña2 });
            if(jwt.IsSuccessStatusCode)
            {
                var jwtString = await jwt.Content.ReadAsStringAsync();
                if(string.IsNullOrEmpty(jwtString))
                {
                    error = "Error al procesar la invitación.";
                    return;
                }
                else
                {
                    await AuthProvider.MarcarAutenticado(jwtString);
                    aceptada = true;
                    StateHasChanged();
                    await Task.Delay(1500);
                    Nav.NavigateTo("/home");
                }
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }
}