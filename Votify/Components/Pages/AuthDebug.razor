@page "/auth-debug"
@rendermode InteractiveServer
@inject BlazorAuthStateProvider AuthProvider
@inject AuthenticationStateProvider AuthStateProvider

<h3>Estado de autenticación</h3>

<p>EstaAutenticado: <strong>@AuthProvider.EstaAutenticado</strong></p>
<p>Correo: <strong>@AuthProvider.ObtenerCorreo()</strong></p>
<p>Nombre: <strong>@AuthProvider.ObtenerNombre()</strong></p>

<hr />
<h4>Claims del AuthenticationState:</h4>
@if (claims.Any())
{
    <ul>
        @foreach (var claim in claims)
        {
            <li><strong>@claim.Type</strong>: @claim.Value</li>
        }
    </ul>
}
else
{
    <p>No hay claims — usuario no autenticado</p>
}

@code {
    private IEnumerable<System.Security.Claims.Claim> claims = [];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            claims = state.User.Claims;
            StateHasChanged();
        }
    }
}