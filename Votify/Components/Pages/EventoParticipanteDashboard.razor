@page "/dashboard/{EventoId:long}/{CategoriaId:long}"
@rendermode InteractiveServer
@inject ApiClient ApiClient
@inject BlazorAuthStateProvider AuthProvider
@inject NavigationManager Nav
@inject ToastService Toasts

@if (cargando)
{
    <p>Cargando...</p>
}
else if (!string.IsNullOrWhiteSpace(error))
{
    <div style="color:red">@error</div>
}
else if (dashboard != null)
{


    <!-- PANCARTA -->
    <div style="background:linear-gradient(90deg,#0f172a,#1e293b);color:white;padding:25px;border-radius:18px;margin-bottom:25px;">

        <div style="
                                    display:flex;
                                    align-items:center;
                                    gap:10px;
                                    flex-wrap:wrap;
                                    margin-bottom:18px;
                                    color:#cbd5e1;
                                    font-size:0.95rem;">

            <span @onclick='() => Nav.NavigateTo("/home")'
                  style="cursor:pointer;">
                Home
            </span>

            <span>›</span>

            <span @onclick="VolverEvento"
                  style="cursor:pointer;">
                @evento?.Nombre
            </span>

            <span>›</span>

            <span style="color:white;font-weight:600;">
                Mi Dashboard
            </span>

        </div>

        <h1 style="margin:10px 0;">Tu Dashboard</h1>
        <p style="color:#cbd5f5;">Resultados finales de tu participación</p>

        <div style="display:flex; justify-content:space-between; align-items:center;">
            <span style="background:#2563eb;padding:6px 12px;border-radius:8px;">
                Fase actual: @faseActual?.Fase
            </span>
            <button class="btn btn-warning" @onclick="AbrirReclamacion">Hacer una reclamación</button>
        </div>
    </div>



    <!-- INFO PROYECTO -->
    <div style="display:flex; gap:20px; flex-wrap:wrap;">

        <!-- PROYECTO -->
        <div style="flex:1; min-width:300px; border:1px solid #e5e7eb; border-radius:15px; padding:20px;">
            <h3>🎮 Tu proyecto</h3>

            <p><b>@dashboard.NombreProyecto</b></p>
            <p style="color:gray;">Grupo: @dashboard.NombreGrupo</p>
        </div>

        <!-- RESULTADOS -->
        <div style="flex:1; min-width:300px; border:1px solid #e5e7eb; border-radius:15px; padding:20px;">
            <h3>🏆 Resultados</h3>

            <div style="background:#ecfdf5; padding:15px; border-radius:10px; margin-bottom:10px;">
                <b>@dashboard.TotalVotos votos</b>
                <p style="margin:0; color:gray;">Total recibidos</p>
            </div>

            <div style="background:#eff6ff; padding:15px; border-radius:10px;">
                <b>Posición #@dashboard.Posicion</b>
                <p style="margin:0; color:gray;">Ranking en la categoría</p>
            </div>
        </div>
    </div>

    <!-- COMENTARIOS -->
    <div style="margin-top:30px; border:1px solid #e5e7eb; border-radius:15px; padding:20px;">
        <h3>💬 Comentarios recibidos</h3>

        @if (dashboard.Comentarios == null || dashboard.Comentarios.Count == 0)
        {
            <p style="color:gray;">No hay comentarios todavía.</p>
        }
        else
        {
            @foreach (var comentario in dashboard.Comentarios)
            {
                <div style="border-bottom:1px solid #eee; padding:12px 0;">

                    <p style="margin:0; font-weight:bold; color:#334155;">
                        @comentario.Autor
                    </p>

                    <p style="margin:5px 0 0 0;">
                        @comentario.Contenido
                    </p>

                </div>
            }
        }
    </div>

    <!-- MODAL RECLAMACIÓN -->
    @if (mostrandoModalReclamacion)
    {
        <div style="position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.5);display:flex;justify-content:center;align-items:center;z-index:1000;">
            <div style="background:white;padding:20px;border-radius:10px;width:90%;max-width:500px;">
                <h3 style="margin-top:0;">Enviar Reclamación al Administrador</h3>

                <textarea @bind="mensajeReclamacion" 
                          rows="5" 
                          style="width:100%;padding:10px;border-radius:5px;border:1px solid #ccc;margin-bottom:10px;"
                          placeholder="Describe el motivo de tu reclamación..."></textarea>

                <div style="display:flex;justify-content:flex-end;gap:10px;">
                    <button class="btn btn-secondary" @onclick="CerrarReclamacion">Cerrar</button>
                    <button class="btn btn-primary" @onclick="EnviarReclamacion" disabled="@enviandoReclamacion">
                        @(enviandoReclamacion ? "Enviando..." : "Enviar")
                    </button>
                </div>
            </div>
        </div>
    }
}
else
{
    <p>No se pudieron cargar los datos.</p>
}

@code {

    [Parameter] public long EventoId { get; set; }
    [Parameter] public long CategoriaId { get; set; }

    EventoDto? evento;
    DashboardParticipanteDto? dashboard;
    FaseDto? faseActual;

    bool cargando = true;
    string error = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var correo = AuthProvider.ObtenerCorreo();
        if (string.IsNullOrWhiteSpace(correo) || !AuthProvider.EstaAutenticado)
        {
            Nav.NavigateTo("/login");
            return;
        }

        try
        {
            var entradaEvento = await ApiClient.GetFromJsonAsync<EntradaEventoRespuestaDto>($"api/evento/{EventoId}");
            if(entradaEvento == null)
            {
                error = "No se encontró el evento.";
                return;
            }
            if (entradaEvento.Rol.EsParticipante)
            {
                evento = entradaEvento.Evento;

                faseActual = await ApiClient.GetFromJsonAsync<FaseDto>($"api/administrador/{EventoId}/fase");

                dashboard = await ApiClient.GetFromJsonAsync<DashboardParticipanteDto>($"api/participante/{EventoId}/dashboard/{CategoriaId}");
            }
            else
            {
                error = "No tienes permisos de participante en este evento.";
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }
    private void VolverEvento()
    {
        if (dashboard != null && dashboard.GrupoId != 0)
        {
            Nav.NavigateTo($"/eventoparticipante/{EventoId}/{dashboard.GrupoId}");
        }
        else
        {
            Nav.NavigateTo($"/eventoparticipante/{EventoId}");
        }
    }

    bool mostrandoModalReclamacion = false;
    string mensajeReclamacion = "";
    string errorReclamacion = "";
    string exitoReclamacion = "";
    bool enviandoReclamacion = false;

    private void AbrirReclamacion()
    {
        mostrandoModalReclamacion = true;
        mensajeReclamacion = "";
        errorReclamacion = "";
        exitoReclamacion = "";
    }

    private void CerrarReclamacion()
    {
        mostrandoModalReclamacion = false;
    }

    private async Task EnviarReclamacion()
    {
        if(string.IsNullOrWhiteSpace(mensajeReclamacion))
        {
            errorReclamacion = "El mensaje no puede estar vacío.";
            return;
        }

        enviandoReclamacion = true;
        errorReclamacion = "";
        exitoReclamacion = "";

        var loadingId = Toasts.ShowLoading("Enviando reclamación...");
        try
        {
            var reclamacionDto = new { Mensaje = mensajeReclamacion };
            var response = await ApiClient.PostAsJsonAsync($"api/participante/{EventoId}/reclamacion", reclamacionDto);

            if(response.IsSuccessStatusCode)
            {
                exitoReclamacion = "Reclamación enviada con éxito.";
                Toasts.ShowSuccess(exitoReclamacion);
                mensajeReclamacion = "";
                // Cerrar tras unos segundos o que el usuario cierre manualmente
            }
            else
            {
                errorReclamacion = "Error al enviar la reclamación.";
                Toasts.ShowError(errorReclamacion);
            }
        }
        catch(Exception ex)
        {
            errorReclamacion = "Error de conexión: " + ex.Message;
            Toasts.ShowError(errorReclamacion);
        }
        finally
        {
            Toasts.Dismiss(loadingId);
            enviandoReclamacion = false;
            StateHasChanged();
        }
    }
}