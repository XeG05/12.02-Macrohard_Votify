@page "/dashboard/{EventoId:long}/{CategoriaId:long}"
@rendermode InteractiveServer
@inject ApiClient ApiClient
@inject BlazorAuthStateProvider AuthProvider
@inject NavigationManager Nav

@if (cargando)
{
    <p>Cargando...</p>
}
else if (!string.IsNullOrWhiteSpace(error))
{
    <div style="color:red">@error</div>
}
else if (dashboard != null)
{


    <!-- PANCARTA -->
    <div style="background:linear-gradient(90deg,#0f172a,#1e293b);color:white;padding:25px;border-radius:18px;margin-bottom:25px;">

        <button @onclick="VolverEvento"
                style="background:none;border:none;color:#cbd5e1;cursor:pointer;">
            ← Volver
        </button>

        <h1 style="margin:10px 0;">Tu Dashboard</h1>
        <p style="color:#cbd5f5;">Resultados finales de tu participación</p>

        <span style="background:#2563eb;padding:6px 12px;border-radius:8px;">
            Fase actual: @faseActual?.Fase
        </span>
    </div>



    <!-- INFO PROYECTO -->
    <div style="display:flex; gap:20px; flex-wrap:wrap;">

        <!-- PROYECTO -->
        <div style="flex:1; min-width:300px; border:1px solid #e5e7eb; border-radius:15px; padding:20px;">
            <h3>🎮 Tu proyecto</h3>

            <p><b>@dashboard.NombreProyecto</b></p>
            <p style="color:gray;">Grupo: @dashboard.NombreGrupo</p>
        </div>

        <!-- RESULTADOS -->
        <div style="flex:1; min-width:300px; border:1px solid #e5e7eb; border-radius:15px; padding:20px;">
            <h3>🏆 Resultados</h3>

            <div style="background:#ecfdf5; padding:15px; border-radius:10px; margin-bottom:10px;">
                <b>@dashboard.TotalVotos votos</b>
                <p style="margin:0; color:gray;">Total recibidos</p>
            </div>

            <div style="background:#eff6ff; padding:15px; border-radius:10px;">
                <b>Posición #@dashboard.Posicion</b>
                <p style="margin:0; color:gray;">Ranking en la categoría</p>
            </div>
        </div>
    </div>

    <!-- COMENTARIOS -->
    <div style="margin-top:30px; border:1px solid #e5e7eb; border-radius:15px; padding:20px;">
        <h3>💬 Comentarios recibidos</h3>

        @if (dashboard.Comentarios == null || dashboard.Comentarios.Count == 0)
        {
            <p style="color:gray;">No hay comentarios todavía.</p>
        }
        else
        {
            @foreach (var comentario in dashboard.Comentarios)
            {
                <div style="border-bottom:1px solid #eee; padding:12px 0;">

                    <p style="margin:0; font-weight:bold; color:#334155;">
                        @comentario.Autor
                    </p>

                    <p style="margin:5px 0 0 0;">
                        @comentario.Contenido
                    </p>

                </div>
            }
        }
    </div>
}
else
{
    <p>No se pudieron cargar los datos.</p>
}

@code {

    [Parameter] public long EventoId { get; set; }
    [Parameter] public long CategoriaId { get; set; }

    EventoDto? evento;
    DashboardParticipanteDto? dashboard;
    FaseDto? faseActual;

    bool cargando = true;
    string error = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var correo = AuthProvider.ObtenerCorreo();
        if (string.IsNullOrWhiteSpace(correo) || !AuthProvider.EstaAutenticado)
        {
            Nav.NavigateTo("/login");
            return;
        }

        try
        {
            var entradaEvento = await ApiClient.GetFromJsonAsync<EntradaEventoRespuestaDto>($"api/evento/{EventoId}");
            if(entradaEvento == null)
            {
                error = "No se encontró el evento.";
                return;
            }
            if (entradaEvento.Rol.EsParticipante)
            {
                evento = entradaEvento.Evento;

                faseActual = await ApiClient.GetFromJsonAsync<FaseDto>($"api/administrador/{EventoId}/fase");

                dashboard = await ApiClient.GetFromJsonAsync<DashboardParticipanteDto>($"api/participante/{EventoId}/dashboard/{CategoriaId}");
            }
            else
            {
                error = "No tienes permisos de participante en este evento.";
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }
    private void VolverEvento()
    {
        if (dashboard != null && dashboard.GrupoId != 0)
        {
            Nav.NavigateTo($"/eventoparticipante/{EventoId}/{dashboard.GrupoId}");
        }
        else
        {
            Nav.NavigateTo($"/eventoparticipante/{EventoId}");
        }
    }
}