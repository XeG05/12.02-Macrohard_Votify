@page "/eventoparticipantepresentar/{EventoId:long}/{GrupoId:long?}"
@rendermode InteractiveServer
@inject ApiClient ApiClient
@inject NavigationManager Nav
@inject BlazorAuthStateProvider AuthProvider

@if (cargando)
{
    <div class="epr-loading-state">
        <div class="epr-spinner"></div>
        <p>Cargando formulario del proyecto...</p>
    </div>
}
else if (evento is null)
{
    <div class="epr-wrapper">
        <div class="epr-alert epr-alert-error">No se ha podido cargar el evento como participante.</div>
    </div>
}
else
{
    <div class="epr-wrapper">
        <div class="epr-hero">
            <div class="epr-hero-content">
                <div class="epr-breadcrumb" @onclick="VolverEvento">← Volver al evento</div>

                <div class="epr-hero-top">
                    <div>
                        <div class="epr-eyebrow">Entrega de proyecto</div>
                        <h1>@evento.Nombre</h1>
                        <p>@evento.Descripcion</p>
                    </div>

                    <div class="epr-hero-side">
                        <span class="epr-role-badge">Participante</span>

                        <div class="epr-mini-status @(tieneProyecto ? "is-ok" : "is-pending")">
                            @(tieneProyecto ? "Proyecto entregado" : "Entrega disponible")
                        </div>

                        <span class="epr-fase-badge @GetFaseClass(evento)">
                            @GetFaseLabel(evento)
                        </span>
                    </div>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="epr-alert epr-alert-error">@error</div>
        }

        @if (!string.IsNullOrWhiteSpace(mensaje))
        {
            <div class="epr-alert epr-alert-ok">@mensaje</div>
        }

        <div class="epr-layout">
            <section class="epr-main">
                <div class="epr-section-header">
                    <div class="epr-section-indicator"></div>
                    <h2>Información del proyecto</h2>
                </div>

                <div class="epr-form-card">
                    <div class="epr-field">
                        <div class="epr-label-row">
                            <label for="nombreProyecto">Nombre del proyecto</label>
                            <span class="epr-counter">@nombreProyecto.Length/30</span>
                        </div>

                        <input id="nombreProyecto"
                               class="epr-input"
                               maxlength="30"
                               @bind="nombreProyecto"
                               @bind:event="oninput"
                               placeholder="Escribe un nombre breve y claro" />
                    </div>

                    <div class="epr-field">
                        <div class="epr-label-row">
                            <label for="descripcionBreve">Descripción breve</label>
                            <span class="epr-counter">@descripcionBreve.Length/500</span>
                        </div>

                        <textarea id="descripcionBreve"
                                  class="epr-textarea epr-textarea-small"
                                  maxlength="500"
                                  @bind="descripcionBreve"
                                  @bind:event="oninput"
                                  placeholder="Resume tu proyecto en pocas líneas"></textarea>
                    </div>

                    <div class="epr-field">
                        <div class="epr-label-row">
                            <label for="descripcionCompleta">Descripción completa</label>
                        </div>

                        <textarea id="descripcionCompleta"
                                  class="epr-textarea epr-textarea-large"
                                  @bind="descripcionCompleta"
                                  @bind:event="oninput"
                                  placeholder="Describe la propuesta, objetivos, funcionalidades y valor del proyecto"></textarea>
                    </div>
                </div>

                <div class="epr-section-header">
                    <div class="epr-section-indicator"></div>
                    <h2>Archivos</h2>
                </div>

                <div class="epr-upload-layout">
                    <div class="epr-upload-grid">
                        <div class="epr-card epr-compact-card">
                            <div class="epr-card-header">
                                <h3>Archivo principal</h3>
                            </div>

                            <label class="epr-picker-box">
                                <div class="epr-picker-content">
                                    <span class="epr-picker-icon">📎</span>
                                    <div class="epr-picker-text">
                                        <strong>Haz clic para subir archivo</strong>
                                    </div>
                                </div>
                                <InputFile OnChange="CargarArchivoProyecto" accept=".zip" class="epr-native-file" />
                            </label>

                            @if (!string.IsNullOrWhiteSpace(nombreArchivoProyecto))
                            {
                                <div class="epr-file-inline">@nombreArchivoProyecto</div>
                            }
                        </div>

                        <div class="epr-card epr-compact-card">
                            <div class="epr-card-header">
                                <h3>Imágenes</h3>
                            </div>

                            <label class="epr-picker-box">
                                <div class="epr-picker-content">
                                    <span class="epr-picker-icon">🖼️</span>
                                    <div class="epr-picker-text">
                                        <strong>Haz clic para subir imágenes</strong>
                                    </div>
                                </div>
                                <InputFile OnChange="CargarImagenes" accept=".png,.jpg,.jpeg" multiple class="epr-native-file" />
                            </label>

                            @if (nombresImagenes.Count > 0)
                            {
                                <div class="epr-files">
                                    @foreach (var nombre in nombresImagenes)
                                    {
                                        <div class="epr-file-chip">@nombre</div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </section>

            <aside class="epr-side">
                <div class="epr-card epr-sticky">
                    <div class="epr-card-header">
                        <h3>Equipo participante</h3>
                        <span class="epr-card-badge">@miembrosGrupo.Count</span>
                    </div>

                    <div class="epr-group-box">
                        <div class="epr-group-title">@nombreGrupo</div>
                        <div style="font-size: 0.85em; color: var(--text-2); margin-bottom: 12px; margin-top: -4px;">📂 Categoría: <strong>@nombreCategoria</strong></div>

                        @if (miembrosGrupo.Count == 0)
                        {
                            <div class="epr-empty-box">
                                <span>👥</span>
                                <p>No hay participantes cargados en el grupo.</p>
                            </div>
                        }
                        else
                        {
                            <div class="epr-members">
                                @foreach (var miembro in miembrosGrupo)
                                {
                                    <div class="epr-member-item">
                                        <div class="epr-member-avatar">@ObtenerIniciales(miembro.Nombre)</div>
                                        <div class="epr-member-info">
                                            <strong>@miembro.Nombre</strong>
                                            <span>@miembro.Correo</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <div class="epr-summary-box">
                        <strong>Antes de entregar</strong>
                        <ul>
                            <li>Revisa el nombre del proyecto.</li>
                            <li>Adjunta el archivo principal.</li>
                        </ul>
                    </div>

                    <div class="epr-actions">
                        <button class="epr-secondary" @onclick="VolverEvento" disabled="@enviando">Cancelar</button>
                        <button class="epr-primary" @onclick="EntregarProyecto" disabled="@(tieneProyecto || !EsFaseEntrega() || enviando)">
                            @(enviando ? "Entregando..." : (tieneProyecto ? "Proyecto ya entregado" : (!EsFaseEntrega() ? "Plazo de entrega cerrado" : "Entregar proyecto")))
                        </button>
                    </div>
                </div>
            </aside>
        </div>
    </div>
}

@code {
    [Parameter] public long EventoId { get; set; }
    [Parameter] public long? GrupoId { get; set; }

    private EventoDto? evento;
    private string? correo = "";
    private bool cargando = true;
    private bool tieneProyecto = false;
    private bool enviando = false;

    private string nombreProyecto = string.Empty;
    private string descripcionBreve = string.Empty;
    private string descripcionCompleta = string.Empty;

    private string nombreGrupo = "Grupo";
    private string nombreCategoria = "Sin categoría";
    private List<MiembroGrupoDto> miembrosGrupo = new();

    private record TieneProyectoResponse(bool TieneProyecto);

    private IBrowserFile? archivoProyecto;
    private List<IBrowserFile> imagenesProyecto = new();

    private List<string> nombresImagenes = new();
    private string? nombreArchivoProyecto;

    private string? error;
    private string? mensaje;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        correo = AuthProvider.ObtenerCorreo();
        if (string.IsNullOrWhiteSpace(correo) || !AuthProvider.EstaAutenticado)
        {
            Nav.NavigateTo("/");
            return;
        }

        try
        {
            var entradaEvento = await ApiClient.GetFromJsonAsync<EntradaEventoRespuestaDto>($"api/evento/{EventoId}");
            if (entradaEvento == null || !entradaEvento.Rol.EsParticipante)
            {
                error = "No se ha podido cargar el evento como participante.";
                return;
            }
            evento = entradaEvento.Evento;

            var grupoQuery = GrupoId.HasValue ? $"?grupoId={GrupoId}" : "";

            var grupo = await ApiClient.GetFromJsonAsync<GrupoDto>($"api/participante/{EventoId}/mi-grupo{grupoQuery}");
            nombreGrupo = grupo?.Nombre ?? "Grupo sin nombre";

            var categoria = await ApiClient.GetFromJsonAsync<CategoriaDto>($"api/participante/{EventoId}/mi-categoria{grupoQuery}");
            nombreCategoria = categoria?.Nombre ?? "Sin categoría";

            miembrosGrupo = await ApiClient.GetFromJsonAsync<List<MiembroGrupoDto>>($"api/participante/{EventoId}/miembros-grupo{grupoQuery}") ?? new();

            var tpResp = await ApiClient.GetFromJsonAsync<TieneProyectoResponse>($"api/participante/{EventoId}/tiene-proyecto{grupoQuery}");
            tieneProyecto = tpResp?.TieneProyecto ?? false;

            if (tieneProyecto)
                mensaje = "Tu grupo ya tiene un proyecto entregado para este evento.";
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private void VolverEvento()
    {
        if (GrupoId != null)
            Nav.NavigateTo($"/eventoparticipante/{EventoId}/{GrupoId}");
        else
            Nav.NavigateTo($"/eventoparticipante/{EventoId}");
    }

    private void CargarImagenes(InputFileChangeEventArgs e)
    {
        error = null;
        var allowedExtensions = new[] { ".png", ".jpg", ".jpeg" };
        var files = e.GetMultipleFiles().ToList();

        if (files.Any(f => !allowedExtensions.Contains(Path.GetExtension(f.Name).ToLowerInvariant())))
        {
            error = "Las imágenes deben estar en formato .png, .jpg o .jpeg";
            imagenesProyecto = new();
            nombresImagenes = new();
            return;
        }

        imagenesProyecto = files;
        nombresImagenes = imagenesProyecto
            .Select(f => f.Name)
            .ToList();
    }

    private void CargarArchivoProyecto(InputFileChangeEventArgs e)
    {
        error = null;
        var file = e.File;
        var extension = Path.GetExtension(file.Name).ToLowerInvariant();

        if (extension != ".zip")
        {
            error = "El archivo principal debe ser un archivo .zip";
            archivoProyecto = null;
            nombreArchivoProyecto = null;
            return;
        }

        archivoProyecto = file;
        nombreArchivoProyecto = file.Name;
    }

    private async Task EntregarProyecto()
    {
        error = null;
        mensaje = null;
        enviando = true;

        try
        {
            if (evento == null) return;

            if (string.IsNullOrWhiteSpace(nombreProyecto))
                throw new Exception("Debes indicar un nombre para el proyecto.");

            if (archivoProyecto == null)
                throw new Exception("No puedes entregar un proyecto sin adjuntar el archivo principal.");

            var maxFileSize = 15 * 1024 * 1024; // 15 MB

            var content = new MultipartFormDataContent();
            content.Add(new StringContent(nombreProyecto),    "nombreProyecto");
            content.Add(new StringContent(descripcionBreve ?? ""),  "descripcionBreve");
            content.Add(new StringContent(descripcionCompleta ?? ""), "descripcionCompleta");

            // Read files into memory explicitly to prevent HttpClient from making synchronous reads 
            // or dragging SignalR stream over network loopbacks.
            var archivoMs = new MemoryStream();
            using var fileStream = archivoProyecto.OpenReadStream(maxFileSize);
            await fileStream.CopyToAsync(archivoMs);
            archivoMs.Position = 0;
            content.Add(new StreamContent(archivoMs), "archivo", archivoProyecto.Name);

            var imagesMs = new List<MemoryStream>();
            foreach (var img in imagenesProyecto)
            {
                var imgMs = new MemoryStream();
                using var imgStream = img.OpenReadStream(maxFileSize);
                await imgStream.CopyToAsync(imgMs);
                imgMs.Position = 0;
                imagesMs.Add(imgMs);
                content.Add(new StreamContent(imgMs), "imagenes", img.Name);
            }

            var grupoQuery = GrupoId.HasValue ? $"?grupoId={GrupoId}" : "";
            var response = await ApiClient.PostMultipartAsync($"api/participante/{EventoId}/proyecto{grupoQuery}", content);

            // Cleanup memory streams
            archivoMs.Dispose();
            foreach(var ms in imagesMs) { ms.Dispose(); }

            if (response.IsSuccessStatusCode)
            {
                mensaje = "Proyecto entregado correctamente.";
                VolverEvento();
            }
            else
            {
                var errJson = await response.Content.ReadAsStringAsync();
                error = $"Error {(int)response.StatusCode} al entregar el proyecto: {errJson}";
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            enviando = false;
        }
    }

    private string ObtenerIniciales(string? nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre))
            return "?";

        var partes = nombre
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(p => char.ToUpperInvariant(p[0]));

        return string.Concat(partes);
    }
    private string GetFaseLabel(EventoDto ev)
    {
        var hoy = DateOnly.FromDateTime(DateTime.Now);
        if (hoy <= ev.FechaFinInscripciones) return "En fase de inscripción";
        if (hoy <= ev.FechaFinEntrega)        return "En fase de entrega";
        if (hoy <= ev.FechaFinVotaciones)     return "En fase de votación";
        return "Finalizado";
    }

    private string GetFaseClass(EventoDto ev)
    {
        var hoy = DateOnly.FromDateTime(DateTime.Now);
        if (hoy <= ev.FechaFinInscripciones) return "fase-inscripciones";
        if (hoy <= ev.FechaFinEntrega)        return "fase-entregas";
        if (hoy <= ev.FechaFinVotaciones)     return "fase-votaciones";
        return "fase-finalizado";
    }

    private bool EsFaseInscripcion()
    {
        if (evento == null) return false;
        var hoy = DateOnly.FromDateTime(DateTime.Now);
        return hoy <= evento.FechaFinInscripciones;
    }

    private bool EsFaseEntrega()
    {
        if (evento == null) return false;
        var hoy = DateOnly.FromDateTime(DateTime.Now);
        return hoy > evento.FechaFinInscripciones && hoy <= evento.FechaFinEntrega;
    }
}