@page "/eventoparticipantepresentar/{EventoId:long}"
@rendermode InteractiveServer
@using Votify.Modelos
@using Votify.Modelos.BusinessLogic.Domain
@using Votify.Modelos.BusinessLogic.Services
@inject I_Evento_Service Evento_Service
@inject NavigationManager Nav
@inject EventoContextService EventoCtx
@inject BlazorAuthStateProvider AuthProvider

@if (cargando)
{
    <div class="epr-loading-state">
        <div class="epr-spinner"></div>
        <p>Cargando formulario del proyecto...</p>
    </div>
}
else if (eventoParticipante is null)
{
    <div class="epr-wrapper">
        <div class="epr-alert epr-alert-error">No se ha podido cargar el evento como participante.</div>
    </div>
}
else
{
    <div class="epr-wrapper">
        <div class="epr-hero">
            <div class="epr-hero-content">
                <div class="epr-breadcrumb" @onclick="VolverEvento">← Volver al evento</div>

                <div class="epr-hero-top">
                    <div>
                        <div class="epr-eyebrow">Entrega de proyecto</div>
                        <h1>@eventoParticipante.Nombre</h1>
                        <p>Prepara la presentación de tu propuesta y completa todos los datos antes de enviarla.</p>
                    </div>

                    <div class="epr-hero-side">
                        <span class="epr-role-badge">Participante</span>
                        <div class="epr-mini-status @(tieneProyecto ? "is-ok" : "is-pending")">
                            @(tieneProyecto ? "Entrega ya registrada" : "Entrega disponible")
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="epr-alert epr-alert-error">@error</div>
        }

        @if (!string.IsNullOrWhiteSpace(mensaje))
        {
            <div class="epr-alert epr-alert-ok">@mensaje</div>
        }

        <div class="epr-layout">
            <section class="epr-main">
                <div class="epr-section-header">
                    <div class="epr-section-indicator"></div>
                    <h2>Información del proyecto</h2>
                </div>

                <div class="epr-form-card">
                    <div class="epr-field">
                        <div class="epr-label-row">
                            <label for="nombreProyecto">Nombre del proyecto</label>
                            <span class="epr-counter">@nombreProyecto.Length/30</span>
                        </div>

                        <input id="nombreProyecto"
                               class="epr-input"
                               maxlength="30"
                               @bind="nombreProyecto"
                               @bind:event="oninput"
                               placeholder="Escribe un nombre breve y claro" />
                    </div>

                    <div class="epr-field">
                        <div class="epr-label-row">
                            <label for="descripcionBreve">Descripción breve</label>
                            <span class="epr-counter">@descripcionBreve.Length/500</span>
                        </div>

                        <textarea id="descripcionBreve"
                                  class="epr-textarea epr-textarea-small"
                                  maxlength="500"
                                  @bind="descripcionBreve"
                                  @bind:event="oninput"
                                  placeholder="Resume tu proyecto en pocas líneas"></textarea>
                    </div>

                    <div class="epr-field">
                        <div class="epr-label-row">
                            <label for="descripcionCompleta">Descripción completa</label>
                        </div>

                        <textarea id="descripcionCompleta"
                                  class="epr-textarea epr-textarea-large"
                                  @bind="descripcionCompleta"
                                  @bind:event="oninput"
                                  placeholder="Describe la propuesta, objetivos, funcionalidades y valor del proyecto"></textarea>
                    </div>
                </div>

                <div class="epr-section-header">
                    <div class="epr-section-indicator"></div>
                    <h2>Archivos y categoría</h2>
                </div>

                <div class="epr-upload-layout">
                    <div class="epr-card epr-card-full">
                        <div class="epr-card-header">
                            <h3>Categoría</h3>
                            <span class="epr-card-badge">@categorias.Count</span>
                        </div>

                        @if (categorias.Any())
                        {
                            <select class="epr-select" @bind="categoriaSeleccionadaId">
                                @foreach (var categoria in categorias)
                                {
                                    <option value="@categoria.Id">@categoria.Nombre</option>
                                }
                            </select>
                        }
                        else
                        {
                            <div class="epr-empty-box">
                                <span>📂</span>
                                <p>No hay categorías disponibles para este evento.</p>
                            </div>
                        }
                    </div>

                    <div class="epr-upload-grid">
                        <div class="epr-card epr-compact-card">
                            <div class="epr-card-header">
                                <h3>Archivo principal</h3>
                            </div>

                            <label class="epr-picker-box">
                                <div class="epr-picker-content">
                                    <span class="epr-picker-icon">📎</span>
                                    <div class="epr-picker-text">
                                        <strong>Seleccionar archivo</strong>
                                    </div>
                                </div>
                                <InputFile OnChange="CargarArchivoProyecto" class="epr-hidden-input" />
                            </label>

                            @if (!string.IsNullOrWhiteSpace(nombreArchivoProyecto))
                            {
                                <div class="epr-file-inline">@nombreArchivoProyecto</div>
                            }
                        </div>

                        <div class="epr-card epr-compact-card">
                            <div class="epr-card-header">
                                <h3>Imágenes</h3>
                            </div>

                            <label class="epr-picker-box">
                                <div class="epr-picker-content">
                                    <span class="epr-picker-icon">🖼️</span>
                                    <div class="epr-picker-text">
                                        <strong>Seleccionar imágenes</strong>
                                    </div>
                                </div>
                                <InputFile OnChange="CargarImagenes" multiple class="epr-hidden-input" />
                            </label>

                            @if (nombresImagenes.Count > 0)
                            {
                                <div class="epr-files">
                                    @foreach (var nombre in nombresImagenes)
                                    {
                                        <div class="epr-file-chip">@nombre</div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </section>

            <aside class="epr-side">
                <div class="epr-card epr-sticky">
                    <div class="epr-card-header">
                        <h3>Equipo participante</h3>
                        <span class="epr-card-badge">@miembrosGrupo.Count</span>
                    </div>

                    <div class="epr-group-box">
                        <div class="epr-group-title">@nombreGrupo</div>

                        @if (miembrosGrupo.Count == 0)
                        {
                            <div class="epr-empty-box">
                                <span>👥</span>
                                <p>No hay participantes cargados en el grupo.</p>
                            </div>
                        }
                        else
                        {
                            <div class="epr-members">
                                @foreach (var miembro in miembrosGrupo)
                                {
                                    <div class="epr-member-item">
                                        <div class="epr-member-avatar">@ObtenerIniciales(miembro.Nombre)</div>
                                        <div class="epr-member-info">
                                            <strong>@miembro.Nombre</strong>
                                            <span>@miembro.Correo</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <div class="epr-summary-box">
                        <strong>Antes de entregar</strong>
                        <ul>
                            <li>Revisa el nombre del proyecto.</li>
                            <li>Selecciona una categoría válida.</li>
                            <li>Adjunta el archivo principal.</li>
                        </ul>
                    </div>

                    <div class="epr-actions">
                        <button class="epr-secondary" @onclick="VolverEvento">Cancelar</button>
                        <button class="epr-primary" @onclick="EntregarProyecto" disabled="@tieneProyecto">
                            @(tieneProyecto ? "Proyecto ya entregado" : "Entregar proyecto")
                        </button>
                    </div>
                </div>
            </aside>
        </div>
    </div>
}

@code {
    [Parameter] public long EventoId { get; set; }

    private EventoParticipante? eventoParticipante;
    private bool cargando = true;
    private bool tieneProyecto = false;

    private string nombreProyecto = string.Empty;
    private string descripcionBreve = string.Empty;
    private string descripcionCompleta = string.Empty;

    private string nombreGrupo = "Grupo";
    private List<(string Nombre, string Correo)> miembrosGrupo = new();
    private List<Categorium> categorias = new();

    private long categoriaSeleccionadaId;
    private List<string> nombresImagenes = new();
    private string? nombreArchivoProyecto;

    private string? error;
    private string? mensaje;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var correo = AuthProvider.ObtenerCorreo();
        if (string.IsNullOrWhiteSpace(correo) || !AuthProvider.EstaAutenticado)
        {
            Nav.NavigateTo("/");
            return;
        }

        try
        {
            var entradaEvento = await Evento_Service.EntrarEvento(correo, EventoId);

            if (entradaEvento.Evento is EventoParticipante participante)
            {
                eventoParticipante = participante;
            }

            if (eventoParticipante == null)
            {
                error = "No se ha podido cargar el evento como participante.";
                return;
            }

            try { EventoCtx.EstablecerEvento(entradaEvento.Evento, "PARTICIPANTE", EventoId); } catch { }

            var grupo = await eventoParticipante.ObtenerMiGrupo();
            nombreGrupo = grupo?.Nombre ?? "Grupo sin nombre";

            miembrosGrupo = await eventoParticipante.ObtenerMiembrosGrupo();
            categorias = await eventoParticipante.ObtenerCategoriasEvento();

            if (categorias.Any())
            {
                categoriaSeleccionadaId = categorias.First().Id;
            }

            try
            {
                tieneProyecto = await eventoParticipante.TieneProyecto();
                if (tieneProyecto)
                {
                    mensaje = "Tu grupo ya tiene un proyecto entregado para este evento.";
                }
            }
            catch
            {
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private void VolverEvento()
    {
        Nav.NavigateTo($"/eventoparticipante/{EventoId}");
    }

    private void CargarImagenes(InputFileChangeEventArgs e)
    {
        nombresImagenes = e.GetMultipleFiles()
            .Select(f => f.Name)
            .ToList();
    }

    private void CargarArchivoProyecto(InputFileChangeEventArgs e)
    {
        var archivo = e.File;
        nombreArchivoProyecto = archivo?.Name;
    }

    private async Task EntregarProyecto()
    {
        error = null;
        mensaje = null;

        try
        {
            if (eventoParticipante == null)
                return;

            if (await eventoParticipante.TieneProyecto())
                throw new Exception("No puedes entregar un nuevo proyecto: ya existe uno entregado por tu grupo.");

            if (string.IsNullOrWhiteSpace(nombreProyecto))
                throw new Exception("Debes indicar un nombre para el proyecto.");

            if (string.IsNullOrWhiteSpace(nombreArchivoProyecto))
                throw new Exception("No puedes entregar un proyecto sin adjuntar el archivo principal.");

            if (!categorias.Any())
                throw new Exception("El evento no tiene categorías disponibles.");

            await eventoParticipante.CrearProyecto(
                nombreProyecto,
                descripcionBreve,
                descripcionCompleta,
                categoriaSeleccionadaId
            );

            mensaje = "Proyecto entregado correctamente.";
            Nav.NavigateTo($"/eventoparticipante/{EventoId}");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private string ObtenerIniciales(string? nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre))
            return "?";

        var partes = nombre
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(p => char.ToUpperInvariant(p[0]));

        return string.Concat(partes);
    }
}