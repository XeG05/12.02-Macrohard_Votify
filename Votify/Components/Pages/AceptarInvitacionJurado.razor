@page "/aceptar-invitacion-jurado/{Token}"
@rendermode InteractiveServer
@layout NoLayout
@inject ApiClient ApiClient
@inject BlazorAuthStateProvider AuthProvider
@inject NavigationManager Nav

@if (cargando)
{
    <p style="text-align:center; margin-top:50px;">Verificando invitación...</p>
}
else if (invitacion == null)
{
    <p style="text-align:center; margin-top:50px; color:red;">
        Esta invitación no es válida o ha caducado.
    </p>
}
else if (invitacion.Aceptada)
{
    <p style="text-align:center; margin-top:50px;">
        Esta invitación ya fue aceptada.
    </p>
}
else if (aceptada)
{
    <p style="text-align:center; margin-top:50px;">
        ¡Bienvenido! Redirigiendo...
    </p>
}
else
{
    <div class="invite-wrapper">

        <div class="invite-card">

            <h1 class="logo">Votify</h1>

            <h2>Invitación como jurado</h2>

            <p class="evento-nombre">
                @invitacion.NombreEvento
            </p>

            <div class="badge-jurado">⚖️ Rol: Jurado</div>

            <div class="divider"></div>

            @if (invitacion.UsuarioExiste)
            {
                <p class="subtext">Introduce tu contraseña para confirmar tu rol de jurado</p>

                <input class="input"
                       @bind="contraseña"
                       type="password"
                       placeholder="Contraseña" />
            }
            else
            {
                <p class="subtext">Crea tu cuenta para unirte como jurado</p>

                <input class="input"
                       @bind="nombre"
                       placeholder="Nombre completo" />

                <input class="input"
                       @bind="contraseña"
                       type="password"
                       placeholder="Contraseña" />

                <input class="input"
                       @bind="contraseña2"
                       type="password"
                       placeholder="Repetir contraseña" />
            }

            <input class="input disabled"
                   value="@invitacion.CorreoDestino"
                   disabled />

            @if (!string.IsNullOrEmpty(error))
            {
                <p class="error">@error</p>
            }

            <button class="btn-main" @onclick="Aceptar">
                @(invitacion.UsuarioExiste ? "Confirmar rol de jurado" : "Crear cuenta y unirme como jurado")
            </button>

        </div>
    </div>
}
@code {
    [Parameter] public string Token { get; set; } = "";

    InvitacionDto? invitacion;
    bool cargando = true;
    bool aceptada = false;
    string error = "";

    string nombre = "";
    string contraseña = "";
    string contraseña2 = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            invitacion = await ApiClient.GetFromJsonAsync<InvitacionDto>($"api/invitacion/jurado/validar/{Token}");
        }
        catch (HttpRequestException)
        {
            // 404 → token inválido
        }
        finally
        {
            cargando = false;
        }
    }

    async Task Aceptar()
    {
        error = "";
        try
        {
            var response = await ApiClient.PostAnonymousAsync("api/invitacion/jurado/aceptar",
                new AceptarInvitacionDto
                {
                    Token = Token,
                    Contraseña = contraseña,
                    Nombre = nombre,
                    ConfirmarContraseña = contraseña2
                });

            if (response.IsSuccessStatusCode)
            {
                var auth = await response.Content.ReadFromJsonAsync<AuthDto>();
                if (string.IsNullOrEmpty(auth?.Token))
                {
                    error = "Error al procesar la invitación.";
                    return;
                }

                await AuthProvider.MarcarAutenticado(auth.Token);
                aceptada = true;
                StateHasChanged();
                await Task.Delay(1500);
                Nav.NavigateTo("/home");
            }
            else
            {
                error = $"Error {(int)response.StatusCode}: no se pudo aceptar la invitación.";
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }
}