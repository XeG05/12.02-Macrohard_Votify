@page "/eventoparticipanteadjuntar"
@rendermode InteractiveServer
@using Votify.Modelos
@using Votify.Modelos.BusinessLogic.Domain
@using Votify.Modelos.BusinessLogic.Services
@inject I_Evento_Service Evento_Service
@inject EventoContextService EventoCtx
@inject NavigationManager Nav

@if (cargando)
{
    <p>Cargando...</p>
}
else if (eventoParticipante is null)
{
    <div class="vpa-wrapper">
        <div class="vpa-alert vpa-alert-error">No se ha cargado el contexto del participante.</div>
    </div>
}
else
{
    <div class="vpa-wrapper">
        <div class="vpa-header">
            <button class="vpa-home-btn" @onclick="VolverHome">🏠</button>
            <h1>@eventoParticipante.Nombre</h1>
            <div class="vpa-logo">V</div>
        </div>

        <div class="vpa-toolbar">
            <button class="vpa-back-btn" @onclick="VolverFormulario">←</button>
        </div>

        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="vpa-alert vpa-alert-error">@error</div>
        }

        @if (!string.IsNullOrWhiteSpace(mensaje))
        {
            <div class="vpa-alert vpa-alert-ok">@mensaje</div>
        }

        <div class="vpa-card">
            <h3>Participantes:</h3>

            <div class="vpa-group-box">
                <strong>@nombreGrupo</strong>
                <ul>
                    @foreach (var miembro in miembrosGrupo)
                    {
                        <li>@miembro.Nombre - @miembro.Correo</li>
                    }
                </ul>
            </div>
        </div>

        <div class="vpa-card">
            <h3>Resumen del proyecto</h3>
            <p><strong>Nombre:</strong> @Nombre</p>
            <p><strong>Descripción breve:</strong> @Breve</p>
            <p><strong>Descripción:</strong> @Descripcion</p>
        </div>

        <div class="vpa-card">
            <label class="vpa-label">Categoría:</label>
            <select class="vpa-select" @bind="categoriaSeleccionadaId">
                @foreach (var categoria in categorias)
                {
                    <option value="@categoria.Id">@categoria.Nombre</option>
                }
            </select>
        </div>

        <div class="vpa-card">
            <label class="vpa-label">Subir imágenes:</label>
            <InputFile OnChange="CargarImagenes" multiple />

            @if (nombresImagenes.Count > 0)
            {
                <div class="vpa-files">
                    @foreach (var nombre in nombresImagenes)
                    {
                        <div class="vpa-file-chip">@nombre</div>
                    }
                </div>
            }
        </div>

        <div class="vpa-card">
            <label class="vpa-label">Subir archivo del proyecto (.zip, .rar, .pdf, etc.):</label>
            <InputFile OnChange="CargarArchivoProyecto" />

            @if (!string.IsNullOrWhiteSpace(nombreArchivoProyecto))
            {
                <p class="vpa-file-main">@nombreArchivoProyecto</p>
            }
        </div>

        <div class="vpa-actions">
            <button class="vpa-primary" @onclick="EntregarProyecto">Entregar proyecto</button>
        </div>
    </div>
}

@code {
    [Parameter] public long EventoId { get; set; }

    [SupplyParameterFromQuery(Name = "nombre")]
    public string? Nombre { get; set; }

    [SupplyParameterFromQuery(Name = "breve")]
    public string? Breve { get; set; }

    [SupplyParameterFromQuery(Name = "descripcion")]
    public string? Descripcion { get; set; }

    private EventoParticipante? eventoParticipante;
    private bool cargando = true;

    private string nombreGrupo = "Grupo";
    private List<(string Nombre, string Correo)> miembrosGrupo = new();
    private List<Categorium> categorias = new();

    private long categoriaSeleccionadaId;
    private List<string> nombresImagenes = new();
    private string? nombreArchivoProyecto;

    private string? error;
    private string? mensaje;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var entradaEvento = await Evento_Service.EntrarEvento("pepe@gmail.com", 1000);

            if (entradaEvento.Evento is EventoParticipante participante)
            {
                eventoParticipante = participante;
            }

            if (eventoParticipante == null)
            {
                error = "No se ha podido cargar el evento como participante.";
                return;
            }

            var grupo = await eventoParticipante.ObtenerMiGrupo();
            nombreGrupo = grupo?.Nombre ?? "Grupo sin nombre";

            miembrosGrupo = await eventoParticipante.ObtenerMiembrosGrupo();
            categorias = await eventoParticipante.ObtenerCategoriasEvento();

            if (categorias.Any())
                categoriaSeleccionadaId = categorias.First().Id;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    private void VolverHome()
    {
        Nav.NavigateTo("/");
    }

    private void VolverFormulario()
    {
        Nav.NavigateTo($"/evento/{EventoId}/participante/presentar");
    }

    private void CargarImagenes(InputFileChangeEventArgs e)
    {
        nombresImagenes = e.GetMultipleFiles()
            .Select(f => f.Name)
            .ToList();
    }

    private void CargarArchivoProyecto(InputFileChangeEventArgs e)
    {
        var archivo = e.File;
        nombreArchivoProyecto = archivo?.Name;
    }

    private async Task EntregarProyecto()
    {
        error = null;
        mensaje = null;

        try
        {
            if (eventoParticipante == null)
                return;

            if (string.IsNullOrWhiteSpace(Nombre))
                throw new Exception("Falta el nombre del proyecto.");

            if (string.IsNullOrWhiteSpace(nombreArchivoProyecto))
                throw new Exception("No puedes entregar un proyecto sin adjuntar el archivo principal.");

            if (!categorias.Any())
                throw new Exception("El evento no tiene categorías disponibles.");

            await eventoParticipante.CrearProyecto(
                Nombre,
                Breve ?? string.Empty,
                Descripcion ?? string.Empty,
                categoriaSeleccionadaId
            );

            mensaje = "Proyecto entregado correctamente.";
            Nav.NavigateTo($"/evento/{EventoId}");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }
}

