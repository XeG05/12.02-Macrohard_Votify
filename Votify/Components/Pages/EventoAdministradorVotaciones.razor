@page "/eventoadmin/{EventoId:long}/votaciones/{idCategoria:long}"
@rendermode InteractiveServer
@inject ApiClient ApiClient
@inject BlazorAuthStateProvider AuthProvider
@inject NavigationManager Nav


@if (cargando)
{
    <p>Cargando...</p>
}
else if (!string.IsNullOrWhiteSpace(error))
{
    <div style="color:red">@error</div>
}
else
{
    <!-- HEADER -->
    <div style="background: linear-gradient(90deg,#0f172a,#1e293b); color:white; padding:25px; border-radius:20px; margin-bottom:20px;">

        <button @onclick="VolverEventoadmin"
                style="background:none;border:none;color:#9ca3af;cursor:pointer;">
            ← Volver al evento
        </button>

        <h1>@evento?.Nombre</h1>
        <p>@nombreCategoria</p>

        <span style="background:#f59e0b; padding:5px 10px; border-radius:10px;">
            Panel de votaciones
        </span>
    </div>


    <!-- RESUMEN -->
    <div style="display:flex; gap:20px; margin-bottom:20px; flex-wrap:wrap;">

        <div style="flex:1; border:1px solid #e5e7eb; border-radius:15px; padding:20px;">
            <h3> Proyectos</h3>
            <p style="font-size:20px;"><b>@numeroProyectos</b></p>
        </div>

        <div style="flex:1; border:1px solid #e5e7eb; border-radius:15px; padding:20px;">
            <h3> Votos totales</h3>
            <p style="font-size:20px;"><b>@totalVotos</b></p>
        </div>

    </div>

    <!-- LISTA -->
    <div style="border:1px solid #e5e7eb; border-radius:15px; padding:20px;">
        <h3> Ranking</h3>

        @foreach (var r in resumen!)
        {
            <div style="padding:12px 0; border-bottom:1px solid #eee;">

                <div style="display:flex; justify-content:space-between; gap:20px;">
                    <div>
                        <b>@r.NombreProyecto</b>
                        <p style="margin:0; color:gray;">@r.NombreGrupo</p>
                    </div>

                    <div style="text-align:right;">
                        <b>@r.PuntuacionMedia.ToString("0.##") puntos</b>
                        <p style="margin:0; color:gray;">@r.CantidadVotos votos totales</p>
                    </div>
                </div>

                <div style="margin-top:8px; padding-left:10px;">
                    @foreach (var c in r.ResultadosPorCriterio)
                    {
                        <div style="display:flex; justify-content:space-between; font-size:0.9rem; color:#555;">
                            <span>@c.NombreCriterio - @c.Ponderacion%</span>
                            @if (evento?.TipoVotacion == TipoVotacion.Nota)
                            {
                                <span>@(c.MediaNota.HasValue ? c.MediaNota.Value.ToString("0.##") : "-") nota media (@c.CantidadVotos votos)</span>
                            }
                            else if (evento?.TipoVotacion == TipoVotacion.Puntos)
                            {
                                <span>@(c.TotalPuntos.HasValue ? c.TotalPuntos.Value.ToString("0.##") : "0") puntos totales</span>
                            }
                            else
                            {
                                <span>@c.CantidadVotos votos</span>
                            }
                        </div>
                    }
                </div>
                <details style="margin-top:12px;">
                    <p>@r.VotosDetalle.Count votos encontrados</p>
                    <summary style="cursor:pointer; color:#2563eb;">
                        Ver votos individuales
                    </summary>

                    <div style="margin-top:10px; padding:10px; background:#f8fafc; border-radius:10px;">

                        @foreach (var voto in r.VotosDetalle)
                        {
                            <div style="display:flex; justify-content:space-between; padding:6px 0; border-bottom:1px solid #e5e7eb;">

                                <div>
                                    <b>@voto.CorreoUsuario</b>
                                    <div style="font-size:0.85rem; color:gray;">
                                        @voto.NombreCriterio
                                    </div>
                                </div>

                                <div>
                                    @voto.Nota
                                </div>

                            </div>
                        }

                    </div>
                </details>

            </div>
        }
    </div>
}


@code {
    [Parameter] public long EventoId { get; set; }
    [Parameter] public long idCategoria { get; set; }

    EventoDto? evento;

    string nombreCategoria = "";
    int numeroProyectos;
    int totalVotos;

    bool cargando = true;
    string error = "";

    List<ProyectoResultadosDto>? resumen;


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var correo = AuthProvider.ObtenerCorreo();
        if (string.IsNullOrWhiteSpace(correo) || !AuthProvider.EstaAutenticado)
        {
            Nav.NavigateTo("/login");
            return;
        }

        try
        {
            var entradaEvento = await ApiClient.GetFromJsonAsync<EntradaEventoRespuestaDto>($"api/evento/{EventoId}");
            if(entradaEvento == null)
            {
                error = "No se pudo obtener la información del evento.";
                return;
            }
            if (entradaEvento.Rol.EsAdministrador)
            {
                evento = entradaEvento.Evento;

                var categorias = await ApiClient.GetFromJsonAsync<List<CategoriaDto>>($"api/administrador/{EventoId}/categorias") ?? new();
                var categoria = categorias.FirstOrDefault(c => c.Id == idCategoria);

                nombreCategoria = categoria?.Nombre ?? "Categoría";

                var proyectos = await ApiClient.GetFromJsonAsync<List<ProyectoDto>>($"api/administrador/categoria/{idCategoria}/proyectos") ?? new();
                numeroProyectos = proyectos.Count;

                totalVotos = await ApiClient.GetFromJsonAsync<int>($"api/administrador/categoria/{idCategoria}/votos");


                resumen = await ApiClient.GetFromJsonAsync<List<ProyectoResultadosDto>>($"api/administrador/categoria/{idCategoria}/resultados");
            }
            else
            {
                error = "No tienes permisos de administrador en este evento.";
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
        
    }

    private void VolverEventoadmin()
    {
        Nav.NavigateTo($"/eventoadmin/{EventoId}");
    }

}
